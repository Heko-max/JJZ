-- is another player's summon and can never be targeted by this tab.
function shadowInShikiFolder(m)
    if not m then return true end
    local bad = false
    pcall(function()
        if m:FindFirstAncestor(NEXO_PET_FOLDER) then bad = true return end
        local par = m.Parent
        while par do
            if par.Name == NEXO_PET_FOLDER then bad = true return end
            par = par.Parent
        end
    end)
    return bad
end


-- ANTI-SPIKE (teleport): the old version zeroed only LINEAR velocity, so the character
-- arrived still spinning and the physics solver had to settle the assembly for several
-- frames after every jump -- that is the hitch you feel on each teleport. Zeroing the
-- angular velocity too means it lands dead-still, and skipping a move you are already
-- standing on avoids a pointless CFrame write (each write re-simulates the assembly).
function nexoTpTo(pos)
    local cur = getModel()
    local hrp = cur and cur:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    return pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(pos)
    end)
end

