function NexoDoAscend()
    if NexoAscBusy then return end
    NexoAscBusy = true
    NexoAscNextAttempt = os.clock() + 3 -- hard floor between attempts, never spams the server
    task.spawn(function()
        local m = NexoAscMods()
        NexoAscNext() -- make sure the requirement cache is populated
        local watch  = NexoAscReqCache.needIds or {}
        local before = NexoAscCountMany(watch)

        local hrp  = NexoMyHRP and NexoMyHRP()
        local back = hrp and hrp.CFrame -- remember where you were so farming is not interrupted
        local npc  = NexoAscNPC()

        if hrp and npc then
            local ok, pos = pcall(function() return npc:GetPivot().Position end)
            if ok and pos then
                pcall(function()
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
                end)
                task.wait(0.25)
            end
        end

        -- Re-verify right before firing: the inventory can change while we travel.
        local _, stillReady = NexoAscBuild()
        if stillReady then
            pcall(function() m.Rem:InvokeServer() end) -- the exact call the dialogue's "Yes" makes
        end

        -- Confirm the server actually applied it by watching the required materials get
        -- consumed. Exits the moment it succeeds instead of blindly sleeping.
        local done, t0 = false, os.clock()
        while os.clock() - t0 < 2.5 do
            task.wait(0.1)
            local after = NexoAscCountMany(watch)
            for id, v in pairs(before) do
                if (after[id] or 0) < v then done = true break end
            end
            if done then break end
        end

        if hrp and back then pcall(function() hrp.CFrame = back end) end

        -- Success -> re-check almost immediately so chained ascensions are fast.
        -- Failure -> back off so a blocked ascension cannot hammer the server.
        NexoAscNextAttempt = os.clock() + (done and 1 or 6)
        NexoAscReqCache.grade = nil -- force a fresh requirement resolve for the NEW grade
        NexoAscLastText = nil       -- force one redraw so the panel shows the new grade instantly
        NexoAscBusy = false
        NexoAscRefresh()
    end)
end

