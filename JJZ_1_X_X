-- ===================== AUTO QUEST OWNERSHIP LEDGER =====================
-- Every quest THIS hub accepts is recorded here. Turning Auto Quest off cancels exactly these ids
-- and nothing else, so a quest you accepted by hand (or any unrelated active quest) is never
-- touched. Verified live: NetworkComm.QuestService.CancelQuest_Method is the cancel remote.
NexoOwnedQuests  = {}
NexoQuestCancel  = nil

function nexoCancelRemote()
    if NexoQuestCancel then return NexoQuestCancel end
    pcall(function() NexoQuestCancel = Net.QuestService.CancelQuest_Method end)
    return NexoQuestCancel
end

-- Accept + take ownership. Used by every automatic accept path in the script.
function NexoOwnAccept(id)
    if not id or id == "" then return false end
    -- routed through the guard so a quest that is mid-run is never restarted (see NexoSafeAccept)
    local ok = NexoSafeAccept(id)
    if ok then NexoOwnedQuests[id] = true end
    return ok
end

-- Release ONE owned quest (used when Auto Select Next Quest moves to a different quest).
function NexoReleaseOwnedId(id)
    if not id or not NexoOwnedQuests[id] then return false end
    NexoOwnedQuests[id] = nil
    local rem = nexoCancelRemote()
    if not rem then return false end
    return pcall(function() rem:InvokeServer(id) end)
end

-- Release EVERY owned quest (used when Auto Quest is switched off).
function NexoReleaseOwned()
    local ids = {}
    for id in pairs(NexoOwnedQuests) do ids[#ids + 1] = id end
    for _, id in ipairs(ids) do NexoReleaseOwnedId(id) end
    return #ids
end

