--[[
    NEXOHUB SPLIT LOADER  -  2 PARTS
    ------------------------------------------------------------------
    This is the ONLY file you execute. It downloads part1 + part2 from
    two different repos, glues them back into ONE chunk of Lua, runs it.

        part1   part2
          |       |
          +-------+
              |
             ONE

    A single part is NOT valid Lua on its own -- only the join is.
--]]

local PARTS = {
    "https://raw.githubusercontent.com/Heko-max/JJZ/refs/heads/main/JJZ_1",
    "https://raw.githubusercontent.com/Heko-max/JJZ/refs/heads/main/JJZ_2",
}

local TIMEOUT   = 30
local MIN_BYTES = 1000
local CHUNKNAME = "NexoHub"

local function httpGet(url)
    local sep = string.find(url, "?", 1, true) and "&" or "?"
    local bust = sep .. "nc=" .. tostring(math.floor(tick() * 1000))

    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        local ok, res = pcall(req, { Url = url .. bust, Method = "GET" })
        if ok and res and (res.StatusCode == 200 or res.Success) and res.Body then
            return res.Body
        end
    end

    local ok, res = pcall(function() return game:HttpGet(url .. bust, true) end)
    if ok and type(res) == "string" then return res end

    ok, res = pcall(function() return game:HttpGet(url, true) end)
    if ok and type(res) == "string" then return res end

    return nil, tostring(res)
end

local bodies, errs, done = {}, {}, 0

for i, url in ipairs(PARTS) do
    task.spawn(function()
        local body, err = httpGet(url)
        if body and #body >= MIN_BYTES then
            bodies[i] = body
        else
            errs[i] = err or ("short/empty response (" .. tostring(body and #body or 0) .. " bytes)")
        end
        done = done + 1
    end)
end

local t0 = tick()
while done < #PARTS and (tick() - t0) < TIMEOUT do
    task.wait(0.05)
end

for i = 1, #PARTS do
    if not bodies[i] then
        error("[NexoHub] part " .. i .. " failed: " .. tostring(errs[i] or "timed out"), 0)
    end
end

local buf = {}
for i = 1, #PARTS do
    if i > 1 and buf[#buf] and string.sub(buf[#buf], -1) ~= "\n" then
        buf[#buf + 1] = "\n"
    end
    buf[#buf + 1] = bodies[i]
end

local fn, err = loadstring(table.concat(buf), "=" .. CHUNKNAME)
if not fn then
    error("[NexoHub] the joined script did not compile: " .. tostring(err), 0)
end

return fn()
