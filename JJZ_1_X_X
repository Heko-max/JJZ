function NexoVisApply(on)
    NexoVisOn  = on
    NexoVisGen = NexoVisGen + 1 -- invalidates any pass still running
    local gen  = NexoVisGen

    if on then
        -- One connection, live ONLY while the toggle is on, so newly streamed-in map assets,
        -- freshly spawned NPCs and new VFX are hidden the moment they appear. DescendantAdded
        -- fires for the model AND each of its children, so nothing is missed.
        if not NexoVisConn then
            NexoVisConn = workspace.DescendantAdded:Connect(function(o)
                if not NexoVisOn then return end
                if NexoVisMapRoot and o:IsDescendantOf(NexoVisMapRoot) then
                    NexoVisHideOne(o, true)
                elseif NexoVisNpcRoot and o:IsDescendantOf(NexoVisNpcRoot) then
                    NexoVisHideOne(o, false)
                end
            end)
        end
        task.spawn(function() NexoVisScan(gen, true) end)
    else
        -- Disconnected on the way off: when this feature is disabled it costs literally nothing,
        -- no connection, no loop, no polling.
        if NexoVisConn then
            pcall(function() NexoVisConn:Disconnect() end)
            NexoVisConn = nil
        end
        task.spawn(function()
            NexoVisScan(gen, false) -- clears LocalTransparencyModifier back to 0
            NexoVisRestoreStored()  -- restores particles / beams / lights / decals / GUIs
        end)
    end
end

