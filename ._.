inOuterRaid = false
outerBossModel = nil -- remembered Awakened Star boss model (survives client name-tag streaming gaps)
outerBossWasAlive = false -- true once we've engaged the boss, so RETRY only fires AFTER it dies
OUTER_BOSS_TAG = "awakened star" -- Lv.1 Awakened Star (boss)
OUTER_ADD_TAG  = "star remnant"  -- Lv.1 Star Remnant (priority add)
ReadySignal = Net.RaidsService.Ready_Signal
RetrySignal = Net.RaidsService.RetryRaid_Method -- retry after boss death (RemoteFunction)
function outerFindByTag(tag)
    -- Outer World raid is a shared/open-world boss (not a per-player island) -> NO island range-lock.
    local ClientF = Characters:FindFirstChild("Client")
    if not ClientF then return nil end
    local pos
    for _, d in ipairs(ClientF:GetDescendants()) do
        if d:IsA("TextLabel") and string.find(string.lower(d.Text), tag, 1, true) then
            local rig = d:FindFirstAncestorWhichIsA("Model")
            local h = rig and rig:FindFirstChild("HumanoidRootPart")
            if h then pos = h.Position break end
        end
    end
    if not pos then return nil end
    if NPCsF then
        local best, bestD
        for _, m in ipairs(NPCsF:GetChildren()) do
            local h = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                local dd = (h.Position - pos).Magnitude
                if dd < 25 and (not bestD or dd < bestD) then best, bestD = m, dd end
            end
        end
        if best then return best, best:FindFirstChild("HumanoidRootPart") end
    end
    return nil
end
-- ALL live "Star Remnant" NPCs (mapped from client name-tags), so every skill/attack can hit every
-- add -- not just the nearest one -- while any remnant is alive. Used by collectTargets override.
function outerTagModels(tag)
    local ClientF = Characters:FindFirstChild("Client")
    if not ClientF then return {} end
    local tagPositions = {}
    for _, d in ipairs(ClientF:GetDescendants()) do
        if d:IsA("TextLabel") and string.find(string.lower(d.Text), tag, 1, true) then
            local rig = d:FindFirstAncestorWhichIsA("Model")
            local h = rig and rig:FindFirstChild("HumanoidRootPart")
            if h then table.insert(tagPositions, h.Position) end
        end
    end
    local out = {}
    if #tagPositions > 0 and NPCsF then
        for _, m in ipairs(NPCsF:GetChildren()) do
            local h = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                for _, tp in ipairs(tagPositions) do
                    if (h.Position - tp).Magnitude < 25 then table.insert(out, m) break end
                end
            end
        end
    end
    return out
end
-- PERF refresher: runs the heavy Outer World add/boss scan ONCE ~10x/sec and caches it in
-- outerAddCache, so the per-frame collectTargets override just reads the cache. THIS is what removes
-- the lag -- attacks are unchanged (still every frame) and the targeting logic is identical.
outerAddCache = {}
outerBossHome = nil -- saved CFrame of the Awakened Star boss while it's parked in the VOID (non-nil = boss is voided)
OUTER_VOID_OFFSET = Vector3.new(100000, 0, 100000) -- how far the immune boss is TP'd from its home spot during add phases
outerVoidPausing = false -- true for a brief beat while we void the boss: ALL attacks pause so nothing chases it into the void
task.spawn(function()
    while getgenv().NexoHubSession == SESSION do
        if AutoOuterRaidOn then
            pcall(function()
                local myModel = getModel()
                local myHRP = myModel and myModel:FindFirstChild("HumanoidRootPart")
                if not myHRP then outerAddCache = {} return end
                local myPos = myHRP.Position
                local Players = game:GetService("Players")
                local bossSet = {}
                for _, b in ipairs(outerTagModels(OUTER_BOSS_TAG)) do bossSet[b] = true end
                local alive, tank, tankHP, seen = {}, nil, -1, {}
                local function scanEnemies(folder)
                    if not folder then return end
                    for _, m in ipairs(folder:GetChildren()) do
                        if m:IsA("Model") and m ~= myModel and not seen[m] and not Players:GetPlayerFromCharacter(m) then
                            local h = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                            local hum = m:FindFirstChildOfClass("Humanoid")
                            -- Target NPCs AND the breakable "parts" that spawn in the boss's immune
                            -- phases: parts have a hitbox but NO Humanoid, so we can't check Health --
                            -- just require they exist within range. Real NPCs must still be alive.
                            if h and (h.Position - myPos).Magnitude <= AURA_RANGE and (not hum or hum.Health > 0) then
                                seen[m] = true
                                table.insert(alive, m)
                                -- only real Humanoid enemies can be "the boss"; parts never are
                                if hum and hum.MaxHealth > tankHP then tankHP, tank = hum.MaxHealth, m end
                            end
                        end
                    end
                end
                scanEnemies(NPCsF)
                if ServerF then
                    for _, f in ipairs(ServerF:GetChildren()) do
                        if f:IsA("Folder") and f ~= NPCsF and f ~= PlayersF then scanEnemies(f) end
                    end
                end
                -- Is the boss currently parked in the VOID (we TP'd it away)? outerBossHome holds its
                -- real home CFrame. While voided it's far out of aura range, so the scan only finds the
                -- adds/parts. We still filter it out of the cache in case the server snaps it back.
                local bossVoided = (outerBossModel ~= nil and outerBossHome ~= nil)
                if bossVoided then
                    if outerBossModel.Parent == nil then
                        -- the game removed the boss entirely -> drop our ref so we re-acquire it
                        outerBossHome = nil
                        outerBossModel = nil
                        outerAddCache = alive
                    else
                        local addsOnly = {}
                        for _, m in ipairs(alive) do if m ~= outerBossModel then addsOnly[#addsOnly + 1] = m end end
                        if #addsOnly == 0 then
                            -- ALL outer NPCs dead -> BRING THE BOSS BACK to its home spot and fight it
                            local br = outerBossModel:FindFirstChild("HumanoidRootPart") or outerBossModel.PrimaryPart
                            if br then pcall(function() br.CFrame = outerBossHome end) end
                            outerBossHome = nil
                            outerAddCache = {}
                        else
                            -- outer NPCs still alive -> keep PINNING the boss in the void every tick
                            -- (so the server can't yank it back) and target ONLY the outer NPCs.
                            local br = outerBossModel:FindFirstChild("HumanoidRootPart") or outerBossModel.PrimaryPart
                            if br then pcall(function() br.CFrame = CFrame.new(outerBossHome.Position + OUTER_VOID_OFFSET) end) end
                            outerAddCache = addsOnly
                        end
                    end
                else
                    -- Boss is visible: identify it (name-tag match, else tankiest Humanoid enemy).
                    local bossM
                    for _, m in ipairs(alive) do if bossSet[m] then bossM = m break end end
                    if not bossM then bossM = tank end
                    outerBossModel = bossM
                    local adds = {}
                    if bossM then
                        for _, m in ipairs(alive) do if m ~= bossM then table.insert(adds, m) end end
                    end
                    outerAddCache = adds
                    -- TELEPORT-TO-VOID: the moment any add/part is alive, send the (immune) boss to the
                    -- VOID (save its home CFrame first) so it can't be targeted or soak our damage --
                    -- all damage goes to the adds/parts. We bring it back to its home spot once they're
                    -- all dead. Repeats every immune phase until the boss finally dies.
                    if bossM and #adds > 0 then
                        local br = bossM:FindFirstChild("HumanoidRootPart") or bossM.PrimaryPart
                        if br then
                            -- SEQUENCE: (1) turn OFF all attacks (collectTargets returns nothing while
                            -- outerVoidPausing is true), (2) TP the boss to the void, (3) after a short
                            -- beat resume so we START killing the NPCs -- nothing follows the boss out.
                            outerVoidPausing = true
                            outerBossHome = br.CFrame
                            pcall(function() br.CFrame = CFrame.new(outerBossHome.Position + OUTER_VOID_OFFSET) end)
                            task.spawn(function() task.wait(0.5); outerVoidPausing = false end)
                        end
                    end
                end
            end)
            task.wait(0.1)
        else
            -- raid off: make sure a voided boss is always brought back (never leave it in the void)
            if outerBossHome and outerBossModel and outerBossModel.Parent then
                local br = outerBossModel:FindFirstChild("HumanoidRootPart") or outerBossModel.PrimaryPart
                if br then pcall(function() br.CFrame = outerBossHome end) end
            end
            outerBossHome = nil
            outerAddCache = {}
            task.wait(0.3)
        end
    end
end)
task.spawn(function()
    local outerTick = 0
    outerRunStart = os.clock() -- start time of the current Outer raid run (for the 2:30 watchdog)
    while getgenv().NexoHubSession == SESSION do
        if AutoOuterRaidOn then
            -- 2:30 STUCK-WATCHDOG: if the boss still isn't dead after 150s in the SAME run, force a
            -- retry so we never get stuck on a bugged / permanently-immune boss. The timer resets on
            -- every retry/ready below and whenever the raid is turned off.
            if os.clock() - outerRunStart > 150 then
                clickPopup("next"); clickPopup("close")
                if outerBossHome and outerBossModel and outerBossModel.Parent then
                    local br = outerBossModel:FindFirstChild("HumanoidRootPart") or outerBossModel.PrimaryPart
                    if br then pcall(function() br.CFrame = outerBossHome end) end
                end
                outerBossHome = nil
                outerBossWasAlive = false
                pcall(function() RetrySignal:InvokeServer() end)
                outerRunStart = os.clock()
            end
            local mdl = getModel()
            local hrp = mdl and mdl:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- Any non-boss NPC/aura is auto-prioritized by collectTargets: while one is alive we
                -- hit ONLY the adds/auras (and move to the nearest), then return to the boss once
                -- they're all dead. Boss out of aura range falls back to a name-tag lookup.
                local list = collectTargets(AURA_RANGE)
                if outerBossModel ~= nil then outerBossWasAlive = true end -- boss engaged this run
                local target = getNearest(AURA_RANGE)
                local th = target and target:FindFirstChild("HumanoidRootPart")
                -- IMPORTANT: while the boss is parked in the VOID (outerBossHome ~= nil) NEVER fall back
                -- to the name-tag boss lookup -- it would find the boss out in the void and snap YOU onto
                -- it, teleporting your character into the void. Only chase the tagged boss when it's home.
                if not (target and th) and outerBossHome == nil then
                    target, th = outerFindByTag(OUTER_BOSS_TAG)
                    if target and th then list = { target } end
                end
                if target and th then
                    inOuterRaid = true
                    outerTick = outerTick + 1
                    -- Only re-snap onto the target when we're actually far from it. Rewriting CFrame
                    -- every frame (or teleporting long distances) trips the game's anti-cheat, which
                    -- then rejects your hits and leaves the NPCs just standing there frozen.
                    pcall(function()
                        local goal = auraGoal(th)
                        if (hrp.Position - goal.Position).Magnitude > STICK_OFFSET + 3 then
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.CFrame = goal
                        end
                    end)
                    -- Deal damage ourselves ONLY if the user isn't already running Fast Attack / Black
                    -- Flash. Firing our own Punch/Black Flash on top of those DOUBLES the remote
                    -- traffic and trips the server anti-spam (works for a bit, then all damage stops).
                    -- The governed Fast skills already auto-target these adds via collectTargets.
                    if not (FastOn or BlackFlashOn) then
                        if outerTick % 2 == 0 then
                            enableBlackFlash()
                            task.spawn(function() pcall(function() blackFlashList(list, mdl, hrp) end) end)
                        else
                            task.spawn(function() pcall(function() attackList(list, mdl, hrp) end) end)
                        end
                    end
                    task.wait(0.05)
                else
                    -- Nothing alive. Fire the RETRY remote ONLY after the Awakened Star boss has been
                    -- engaged and DIED -- never at the start and never during the fight (the boss is
                    -- always a target while alive). Before the very first boss, ready up once per
                    -- second to start the raid.
                    clickPopup("next"); clickPopup("close")
                    if outerBossHome ~= nil then
                        task.wait(0.3) -- boss is only VOIDED mid-fight (adds keep spawning); never retry now
                    elseif outerBossWasAlive then
                        -- The boss sometimes DESPAWNS for a check or two between phases without being
                        -- dead. Don't retry on that false alarm: confirm it's really gone by checking
                        -- 2 times over 2 seconds. If a boss OR any add/part reappears at ANY check,
                        -- bail out and keep fighting. Only retry if it's absent all 2 checks.
                        local gone = true
                        for _ = 1, 2 do
                            task.wait(1)
                            if not AutoOuterRaidOn then gone = false break end
                            local t2 = getNearest(AURA_RANGE)
                            local b2 = outerFindByTag(OUTER_BOSS_TAG)
                            local bossLive = false
                            if outerBossModel and outerBossModel.Parent then
                                local bhum = outerBossModel:FindFirstChildOfClass("Humanoid")
                                bossLive = (not bhum) or (bhum.Health > 0)
                            end
                            if t2 or b2 or bossLive then gone = false break end
                        end
                        if gone and AutoOuterRaidOn then
                            pcall(function() RetrySignal:InvokeServer() end)
                            outerRunStart = os.clock() -- new run started; reset the 2:30 watchdog
                        end
                    else
                        pcall(function() ReadySignal:FireServer() end)
                        outerRunStart = os.clock() -- new run started; reset the 2:30 watchdog
                        task.wait(1)
                    end
                end
            else
                task.wait(0.3)
            end
        else
            inOuterRaid = false
            outerRunStart = os.clock() -- raid off: keep timer fresh so 2:30 counts from when it turns on
            task.wait(0.3)
        end
    end
end)

-- Auto Summer Raid (SummerSiege). Same engine as the StarRage/Blood raids: TP into the zone part,
-- smash the boss NPCs, then Retry INSTANTLY on clear. The 4 event NPCs are matched by name-tag.
-- Reuses the same CreateIslandQueue / Retry remotes and the shared clickPopup helper.
local AutoSummerRaidOn = false
local inSummerRaid = false
local FastRaidOn = false
-- ISLAND LOCK: in a shared server every player gets their OWN SummerSiege island, but the raid NPCs
-- all use identical name-tags, so an INFINITE-range bring would "steal" NPCs off other players'
-- islands. Islands spawn far apart, so we simply cap every raid bring/target to this radius around
-- YOU. Your own island's NPCs are always inside it; other islands sit far outside it.
-- Raise this if some of YOUR OWN raid NPCs get missed; lower it if islands are close together.
-- RAID_ISLAND_RADIUS is defined globally above (shared by every raid's island-lock)
local RAID_BRING_RANGE = RAID_ISLAND_RADIUS -- Fast Raid bring radius (island-locked, was inf)
local RAID_CLEAR_GRACE = 6 -- secs with NO raid NPC before we treat the raid as CLEARED (ignores wave-gaps)
local SUMMER_BOSS_NAMES = {
    "guy in snorkles",
    "just a chill dude",
    "summer island girl",
    "summer island captain",
    "summer island thug",
}
-- All matching summer-boss client name-tag positions (several NPC types can be up at once)
local function summerTagPositions()
    local hits = {}
    local ClientF = Characters:FindFirstChild("Client")
    if not ClientF then return hits end
    for _, d in ipairs(ClientF:GetDescendants()) do
        if d:IsA("TextLabel") then
            local low = string.lower(d.Text)
            for _, nm in ipairs(SUMMER_BOSS_NAMES) do
                if string.find(low, nm, 1, true) then
                    local rig = d:FindFirstAncestorWhichIsA("Model")
                    local h = rig and rig:FindFirstChild("HumanoidRootPart")
                    if h then table.insert(hits, h.Position) end
                    break
                end
            end
        end
    end
    return hits
end
-- Alive server NPCs that belong to the summer raid (near a matching name-tag) within `range` of you.
-- Pass range = nil to get them all regardless of distance.
local function collectSummerNPCs(myHRP, range)
    local out = {}
    if not (myHRP and NPCsF) then return out end
    local tags = summerTagPositions()
    if #tags == 0 then return out end
    for _, m in ipairs(NPCsF:GetChildren()) do
        if not isPunchingBag(m) then
        local h = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if h and hum and hum.Health > 0 then
            local isRaid = false
            for _, pos in ipairs(tags) do
                if (h.Position - pos).Magnitude < 25 then isRaid = true break end
            end
            if isRaid and onMyIsland(h.Position) and (not range or (h.Position - myHRP.Position).Magnitude <= range) then
                table.insert(out, m)
            end
        end
        end
    end
    return out
end
-- Nearest summer raid NPC to YOU (stable target = no arena-hopping) + doubles as the boss-present check.
local function findSummerBoss()
    local myModel = getModel()
    local myHRP = myModel and myModel:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local best, bestD
    for _, m in ipairs(collectSummerNPCs(myHRP, RAID_ISLAND_RADIUS)) do -- island-locked: only YOUR island's boss
        local h = m:FindFirstChild("HumanoidRootPart")
        if h then
            local dd = (h.Position - myHRP.Position).Magnitude
            if not bestD or dd < bestD then best, bestD = m, dd end
        end
    end
    if best then return best, best:FindFirstChild("HumanoidRootPart") end
    return nil
end
local function summerGrabPos(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    local h = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
    return h and h.Position or nil
end
local function findSummerZone()
    -- 1) exact names under QueueZones (SummerSiegeRaid, or ConfigID-style "SummerSiege")
    local qz = workspace:FindFirstChild("QueueZones")
    if qz then
        local sr = qz:FindFirstChild("SummerSiegeRaid") or qz:FindFirstChild("SummerSiege")
        local p = summerGrabPos(sr)
        if p then return p end
    end
    -- 2) lenient case-insensitive / partial scan of the whole workspace
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Model") then
            local n = string.lower(d.Name)
            if string.find(n, "summersiege", 1, true) then
                local p = summerGrabPos(d)
                if p then return p end
            end
        end
    end
    return nil
end

-- Bring Summer Raid NPC (inf): INDEPENDENT toggle -- brings every summer raid NPC to you with NO
-- range limit + kills them in a loop, EVEN WHEN Auto Summer Raid is OFF. It does NOT queue/start the
-- raid; it just grabs whatever summer raid NPCs are already present (matched by name-tag), so if the
-- raid is off it simply pulls any that exist. Same bring logic as Bring Inf Range / Auto Lifeguard.
-- NPCs are frozen (velocity zeroed) but YOU can still move. Global to spare main-chunk registers.
BringSummerRaidOn = false
bringRaidTick = 0
task.spawn(function()
    while getgenv().NexoHubSession == SESSION do
        if BringSummerRaidOn then
            local cur = getModel()
            local chrp = cur and cur:FindFirstChild("HumanoidRootPart")
            if chrp then
                local npcs = collectSummerNPCs(chrp, RAID_ISLAND_RADIUS) -- island-locked radius (was inf): never steal other players' NPCs
                if #npcs > 0 then
                    for i, m in ipairs(npcs) do
                        local h = m:FindFirstChild("HumanoidRootPart")
                        if h then
                            local angle = (i / #npcs) * math.pi * 2
                            local off = Vector3.new(math.cos(angle) * BRING_OFFSET, 0, math.sin(angle) * BRING_OFFSET)
                            pcall(function()
                                h.AssemblyLinearVelocity = Vector3.zero -- freeze the NPC (it can't move); YOU still can
                                h.CFrame = CFrame.new(chrp.Position + off)
                            end)
                        end
                    end
                    bringRaidTick = bringRaidTick + 1
                    if bringRaidTick % 2 == 0 then
                        enableBlackFlash()
                        task.spawn(function() pcall(function() blackFlashList(npcs, cur, chrp) end) end)
                    else
                        task.spawn(function() pcall(function() attackList(npcs, cur, chrp) end) end)
                    end
                    task.wait() -- NO DELAY: pull + hit every frame
                else
                    task.wait(0.05) -- nothing to bring yet: recheck almost instantly
                end
            else
                task.wait(0.3)
            end
        else
            task.wait(0.3)
        end
    end
end)
task.spawn(function()
    while getgenv().NexoHubSession == SESSION do
        if AutoSummerRaidOn then
            local mdl = getModel()
            local hrp = mdl and mdl:FindFirstChild("HumanoidRootPart")
            if hrp then
                local boss, bh = findSummerBoss()
                if boss and bh then
                    inSummerRaid = true
                    local raidTick = 0
                    local lastSeen = os.clock() -- last time a raid NPC was present; brief wave-gaps won't kick us out
                    while AutoSummerRaidOn and getgenv().NexoHubSession == SESSION do
                        local cur = getModel()
                        local chrp = cur and cur:FindFirstChild("HumanoidRootPart")
                        if chrp then
                            raidTick = raidTick + 1
                            if FastRaidOn then
                                -- FAST RAID: stay put + BRING every raid NPC within 100 studs to you (like Fast Quest)
                                local raidTargets = collectSummerNPCs(chrp, RAID_BRING_RANGE)
                                if #raidTargets > 0 then
                                    lastSeen = os.clock()
                                    pcall(function() chrp.AssemblyLinearVelocity = Vector3.zero end)
                                    for i, m in ipairs(raidTargets) do
                                        local h = m:FindFirstChild("HumanoidRootPart")
                                        if h then
                                            local angle = (i / #raidTargets) * math.pi * 2
                                            local off = Vector3.new(math.cos(angle) * BRING_OFFSET, 0, math.sin(angle) * BRING_OFFSET)
                                            pcall(function() h.CFrame = CFrame.new(chrp.Position + off) end)
                                        end
                                    end
                                    if raidTick % 2 == 0 then
                                        enableBlackFlash()
                                        task.spawn(function() pcall(function() blackFlashList(raidTargets, cur, chrp) end) end)
                                    else
                                        task.spawn(function() pcall(function() attackList(raidTargets, cur, chrp) end) end)
                                    end
                                else
                                    local boss2, bh2 = findSummerBoss()
                                    if boss2 and bh2 then
                                        lastSeen = os.clock()
                                        -- boss beyond the 100 bring range: close the gap, then bring next loop
                                        pcall(function()
                                            chrp.AssemblyLinearVelocity = Vector3.zero
                                            chrp.CFrame = auraGoal(bh2)
                                        end)
                                    else
                                        -- no NPCs right now: likely a wave-gap. HOLD position (do NOT TP to start);
                                        -- only leave once they've been gone RAID_CLEAR_GRACE secs (a real clear).
                                        pcall(function()
                                            chrp.AssemblyLinearVelocity = Vector3.zero
                                            chrp.CFrame = chrp.CFrame
                                        end)
                                        if os.clock() - lastSeen > RAID_CLEAR_GRACE then break end
                                    end
                                end
                            else
                                -- NORMAL: chase the NEAREST raid NPC (stable target = no arena-hopping)
                                local boss2, bh2 = findSummerBoss()
                                if boss2 and bh2 then
                                    lastSeen = os.clock()
                                    pcall(function()
                                        chrp.AssemblyLinearVelocity = Vector3.zero
                                        chrp.CFrame = auraGoal(bh2)
                                    end)
                                    if raidTick % 2 == 0 then
                                        enableBlackFlash()
                                        task.spawn(function() pcall(function() blackFlashList({boss2}, cur, chrp) end) end)
                                    else
                                        task.spawn(function() pcall(function() attackList({boss2}, cur, chrp) end) end)
                                    end
                                else
                                    -- wave-gap: HOLD in place (do NOT TP to start); exit only after a sustained absence.
                                    pcall(function()
                                        chrp.AssemblyLinearVelocity = Vector3.zero
                                        chrp.CFrame = chrp.CFrame
                                    end)
                                    if os.clock() - lastSeen > RAID_CLEAR_GRACE then break end
                                end
                            end
                        end
                        task.wait() -- NO DELAY: retarget + hit the raid every frame
                    end
                elseif inSummerRaid then
                    -- Boss cleared. NO DELAY: clear popups + Retry INSTANTLY, then poll for the
                    -- respawn every frame, re-Retrying a few times a second until the boss is back.
                    clickPopup("next"); clickPopup("close")
                    pcall(function() RetryRaid:InvokeServer() end)
                    local t0, lastRetry = os.clock(), os.clock()
                    while AutoSummerRaidOn and getgenv().NexoHubSession == SESSION and (os.clock() - t0) < 6 do
                        if findSummerBoss() then break end
                        if (os.clock() - lastRetry) >= 0.25 then
                            clickPopup("next"); clickPopup("close")
                            pcall(function() RetryRaid:InvokeServer() end)
                            lastRetry = os.clock()
                        end
                        task.wait()
                    end
                    if not findSummerBoss() then inSummerRaid = false end
                else
                    -- FAST START: fire the queue + TP to the zone pad, then keep RE-firing and
                    -- polling EVERY FRAME until the boss loads in, so the raid begins with no dead
                    -- time and we start killing the instant it spawns.
                    local zonePos = findSummerZone()
                    local function kickRaid()
                        pcall(function()
                            CreateIslandQueue:InvokeServer({
                                Difficulty = 3,
                                ConfigID = "SummerSiege",
                                Modifiers = {},
                            })
                        end)
                        if zonePos then
                            pcall(function()
                                hrp.AssemblyLinearVelocity = Vector3.zero
                                hrp.CFrame = CFrame.new(zonePos)
                            end)
                        end
                    end
                    kickRaid()
                    local t0, lastKick = os.clock(), os.clock()
                    while AutoSummerRaidOn and getgenv().NexoHubSession == SESSION and (os.clock() - t0) < 15 do
                        if findSummerBoss() then break end
                        if (os.clock() - lastKick) >= 0.5 then
                            zonePos = zonePos or findSummerZone()
                            kickRaid()
                            lastKick = os.clock()
                        end
                        task.wait() -- poll every frame: engage the instant the boss appears
                    end
                end
            else
                task.wait(0.3)
            end
        else
            inSummerRaid = false
            task.wait(0.3)
        end
    end
end)

