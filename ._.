local URL = "https://raw.githubusercontent.com/Heko-max/JJZ/refs/heads/main/JJZ_NEW_UI"
local NexoHub do
    local ok, src = pcall(game.HttpGet, game, URL .. "?v=" .. tostring(tick()), true)
    if not ok then
        error("[NexoHub] HTTP request failed: " .. tostring(src), 0)
    end
    if src:sub(1, 3) == "404" or src:find("^Not Found") then
        error("[NexoHub] File not found at:\n" .. URL, 0)
    end
    local chunk, compileErr = loadstring(src)
    if not chunk then
        error("[NexoHub] Library failed to compile: " .. tostring(compileErr), 0)
    end
    NexoHub = chunk()
    if type(NexoHub) ~= "table" then
        error("[NexoHub] Library returned " .. type(NexoHub)
            .. ", expected a table. Make sure the last line of the library is `return NexoHub`.", 0)
    end
end
warn("[TEST 1] library downloaded and returned a table")

local ui = NexoHub:CreateWindow({
    welcome   = 'Welcome back to <font color="rgb(255,0,0)">NEXO HUB</font>',
    subtitle  = "JuJutsu Zero [V2]",
