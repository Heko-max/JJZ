-- Bosses are matched by their client name-tag text (level prefix ignored). GLOBALS to save registers.
AutoKillBossOn = false
BringBossOn = false
FindBossHopOn = false
selectedBoss = "All"
bossKillTick = 0
BOSS_TAG_MAP = {
    ["Lv.1 Dagon"] = "dagon",
    ["Lv.1 Kuro"] = "kuro",
    ["Lv.1 Bunny"] = "bunny",
    ["Lv.1 Nue"] = "nue",
    ["Lv.1 Shiro"] = "shiro",
    ["Lv.1 Mahoraga"] = "mahoraga",
    ["Lv.1 Summer Amanai"] = "amanai",
    ["Lv.1 Summer Yuji"] = "yuji",
}
BOSS_ALL_TAGS = { "dagon", "kuro", "bunny", "nue", "shiro", "mahoraga", "amanai", "yuji" }
function bossSearchTags()
    if selectedBoss == "All" or selectedBoss == nil then return BOSS_ALL_TAGS end
    local t = BOSS_TAG_MAP[selectedBoss]
    if t then return { t } end
    return BOSS_ALL_TAGS
end
-- Locate the selected boss's client name-tag, then return the nearest live SERVER NPC to it (the
-- damageable model). Returns nil if the boss isn't spawned in this server.
function findSelectedBoss()
    if not NPCsF then return nil end
    local tags = bossSearchTags()

    -- Strategy A: match directly on the SERVER model's own Name -- fastest + most robust, no GUI
    -- lookup needed at all. Many bosses are literally named "Lv.1 Dagon" etc. on the server model.
    -- Strategy B: a nameplate/BillboardGui TextLabel attached DIRECTLY to that same NPC model
    -- (instead of living in a separate client-replica folder). Checked in the same pass.
    for _, m in ipairs(NPCsF:GetChildren()) do
        local h = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if h and hum and hum.Health > 0 then
            local nlow = string.lower(m.Name)
            for _, tg in ipairs(tags) do
                if string.find(nlow, tg, 1, true) then return m end
            end
            local ok, hit = pcall(function()
                for _, d in ipairs(m:GetDescendants()) do
                    if d:IsA("TextLabel") then
                        local dlow = string.lower(d.Text)
                        for _, tg in ipairs(tags) do
                            if string.find(dlow, tg, 1, true) then return true end
                        end
                    end
                end
                return false
            end)
            if ok and hit then return m end
        end
    end

    -- Strategy C (fallback): a separate CLIENT replica folder carries the nameplate; match its
    -- position to the nearest live SERVER NPC. This is the original method, kept for games/bosses
    -- laid out that way.
    local ClientF = Characters:FindFirstChild("Client")
    if not ClientF then return nil end
    local bossPos
    for _, d in ipairs(ClientF:GetDescendants()) do
        if d:IsA("TextLabel") then
            local low = string.lower(d.Text)
            for _, tg in ipairs(tags) do
                if string.find(low, tg, 1, true) then
                    local rig = d:FindFirstAncestorWhichIsA("Model")
                    local h = rig and rig:FindFirstChild("HumanoidRootPart")
                    if h then bossPos = h.Position break end
                end
            end
        end
        if bossPos then break end
    end
    if not bossPos then return nil end
    local best, bestD
    for _, m in ipairs(NPCsF:GetChildren()) do
        local h = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if h and hum and hum.Health > 0 then
            local dd = (h.Position - bossPos).Magnitude
            if dd < 25 and (not bestD or dd < bestD) then best, bestD = m, dd end
        end
    end
    return best
end
-- Hop to the LOWEST-population public server (fresh boss likely up + no competition). Uses the
-- executor's HTTP + TeleportService. Best-effort resume after the hop via queue_on_teleport + a flag
-- file (needs auto-execute / your loader to re-run the hub on the new server to keep hunting).
bossHopBusy = false
function bossServerHop()
    if bossHopBusy then return end
    bossHopBusy = true
    local TeleportService = game:GetService("TeleportService")
    local HttpService = game:GetService("HttpService")
    local placeId = game.PlaceId
    local jobId = game.JobId
    local plr = game:GetService("Players").LocalPlayer
    pcall(function() writefile("nexo_findboss.txt", "1") end)
    local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport) or queueteleport or queue_teleport
    if q and getgenv().NexoHubLoader then pcall(function() q(getgenv().NexoHubLoader) end) end
    local best, bestPlayers
    local ok, body = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100")
    end)
    if ok and body then
        local okD, data = pcall(function() return HttpService:JSONDecode(body) end)
        if okD and data and data.data then
            for _, s in ipairs(data.data) do
                if s.id ~= jobId and type(s.playing) == "number" and type(s.maxPlayers) == "number" and s.playing < s.maxPlayers then
                    if not bestPlayers or s.playing < bestPlayers then best, bestPlayers = s.id, s.playing end
                end
            end
        end
    end
    pcall(function() Library:Notify({ Title = "NEXO HUB", Content = "No boss here -- server hopping...", Type = "Info", Duration = 3 }) end)
    if best then
        pcall(function() TeleportService:TeleportToPlaceInstance(placeId, best, plr) end)
    else
        pcall(function() TeleportService:Teleport(placeId, plr) end)
    end
    task.wait(4)
    bossHopBusy = false
end
task.spawn(function()
    -- one-time resume after a server hop (best effort): if we left a flag, re-enable hunting
    pcall(function()
        if isfile and isfile("nexo_findboss.txt") then
            pcall(function() delfile("nexo_findboss.txt") end)
            AutoKillBossOn = true
            FindBossHopOn = true
        end
    end)
    local noBossSince = nil
    while getgenv().NexoHubSession == SESSION do
        if AutoKillBossOn or FindBossHopOn then
            local cur = getModel()
            local chrp = cur and cur:FindFirstChild("HumanoidRootPart")
            if chrp then
                local boss = findSelectedBoss()
                if boss then
                    noBossSince = nil
                    if AutoKillBossOn then
                        local npcs = { boss }
                        local h = boss:FindFirstChild("HumanoidRootPart")
                        if h then
                            if BringBossOn then
                                pcall(function()
                                    chrp.AssemblyLinearVelocity = Vector3.zero
                                    h.AssemblyLinearVelocity = Vector3.zero
                                    h.CFrame = CFrame.new(chrp.Position + Vector3.new(BRING_OFFSET, 0, 0))
                                end)
                            else
                                pcall(function()
                                    chrp.AssemblyLinearVelocity = Vector3.zero
                                    chrp.CFrame = CFrame.new(h.Position + Vector3.new(0, 0, 6))
                                end)
                            end
                        end
                        bossKillTick = bossKillTick + 1
                        if bossKillTick % 2 == 0 then
                            enableBlackFlash()
                            task.spawn(function() pcall(function() blackFlashList(npcs, cur, chrp) end) end)
                        else
                            task.spawn(function() pcall(function() attackList(npcs, cur, chrp) end) end)
                        end
                        task.wait(0.001)
                    else
                        task.wait(0.001)
                    end
                else
                    if FindBossHopOn then
                        if not noBossSince then noBossSince = os.clock() end
                        -- give the server ~6s to stream the boss in before deciding it's truly absent
                        if (os.clock() - noBossSince) > 6 then
                            noBossSince = nil
                            bossServerHop()
                        else
                            task.wait(0.001)
                        end
                    else
                        noBossSince = nil
                        task.wait(0.001)
                    end
                end
            else
                task.wait(0.001)
            end
        else
            noBossSince = nil
            task.wait(0.001)
        end
    end
end)

