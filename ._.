-- lives in ONE table so we don't burn scarce main-chunk local registers (near Luau's 200 cap).
local RaidCfg = {
    difficulty = 5,
    map = { Easy = 1, Normal = 2, Hard = 3, Nightmare = 4, Calamity = 5 },
    active = {},
}
-- The boss's server name is RANDOM each spawn, so we can't match by model name. Instead we find
-- the CLIENT rig (all named "Default_Client") whose name-tag TextLabel says "Lv.1 Yuki", then
-- match the SERVER NPC closest to that rig -- that's the model we actually damage/teleport to.
local RAID_BOSS_TAG = "yuki" -- text on the boss's client name-tag (level prefix may change)
local function findRaidBoss()
    return findNearestTaggedBoss(RAID_BOSS_TAG) -- island-locked: only YOUR StarRage boss
end
local function findStarRageZone()
    local qz = workspace:FindFirstChild("QueueZones")
    local sr = qz and qz:FindFirstChild("StarRage")
    if not sr then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d.Name == "StarRage" and (d:IsA("Model") or d:IsA("BasePart")) then sr = d break end
        end
    end
    if not sr then return nil end
    if sr:IsA("BasePart") then return sr.Position end
    local h = sr.PrimaryPart or sr:FindFirstChildWhichIsA("BasePart")
    return h and h.Position or nil
end
-- Robustly "click" any visible TextButton whose text contains the keyword: fire EVERY handler on
-- all its click signals (Activated / MouseButton1Click / Down / Up) so it works no matter which
-- one the game connected to. firesignal(MouseButton1Click) alone often misses .Activated buttons.
local function clickPopup(keyword)
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false end
    local kw = string.lower(keyword)
    local clicked = false
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextButton") and d.Visible and string.find(string.lower(d.Text), kw, 1, true) then
            for _, sname in ipairs({"Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up"}) do
                pcall(function()
                    if getconnections then
                        for _, cn in ipairs(getconnections(d[sname])) do
                            pcall(function() cn:Fire() end)
                        end
                    end
                end)
            end
            pcall(function() firesignal(d.MouseButton1Click) end)
            clicked = true
        end
    end
    return clicked
end
task.spawn(function()
    while getgenv().NexoHubSession == SESSION do
        if AutoRaidOn then
            local mdl = getModel()
            local hrp = mdl and mdl:FindFirstChild("HumanoidRootPart")
            if hrp then
                local boss, bh = findRaidBoss()
                if boss and bh then
                    -- BOSS PHASE: we're in the room with a live boss. Mark inRaid + smash it.
                    inRaid = true
                    local raidTick = 0
                    while AutoRaidOn and getgenv().NexoHubSession == SESSION do
                        boss, bh = findRaidBoss()
                        if not (boss and bh) then break end
                        local cur = getModel()
                        local chrp = cur and cur:FindFirstChild("HumanoidRootPart")
                        if chrp then
                            raidTick = raidTick + 1
                            pcall(function()
                                chrp.AssemblyLinearVelocity = Vector3.zero
                                chrp.CFrame = auraGoal(bh)
                            end)
                            -- fire BOTH Black Flash + attack every tick (faster boss kills); each
                            -- move is still capped by its own damageReady/startReady throttle.
                            enableBlackFlash()
                            task.spawn(function() pcall(function() blackFlashList({boss}, cur, chrp) end) end)
                            task.spawn(function() pcall(function() attackList({boss}, cur, chrp) end) end)
                        end
                        task.wait(0.05)
                    end
                elseif inRaid then
                    -- Boss just died. NO DELAY: clear popups + Retry INSTANTLY, then poll for the
                    -- respawn every frame. We re-clear popups and re-Retry a few times a second in
                    -- case the first Retry fired while a reward popup was still covering the button.
                    clickPopup("next"); clickPopup("close")
                    pcall(function() RetryRaid:InvokeServer() end)
                    local t0, lastRetry = os.clock(), os.clock()
                    while AutoRaidOn and getgenv().NexoHubSession == SESSION and (os.clock() - t0) < 6 do
                        if findRaidBoss() then break end
                        if (os.clock() - lastRetry) >= 0.25 then
                            clickPopup("next"); clickPopup("close")
                            pcall(function() RetryRaid:InvokeServer() end)
                            lastRetry = os.clock()
                        end
                        task.wait()
                    end
                    if not findRaidBoss() then inRaid = false end -- no respawn -> we were sent to spawn
                else
                    -- NO BOSS + not in a raid: queue the raid or TP into the StarRage zone part
                    local zonePos = findStarRageZone()
                    if zonePos then
                        -- TP into the zone part ONCE, then just STAND and wait to be teleported in.
                        -- (Re-TPing every loop kept snapping us back and blocked the game's teleport.)
                        local chrp = hrp
                        pcall(function()
                            chrp.AssemblyLinearVelocity = Vector3.zero
                            chrp.CFrame = CFrame.new(zonePos)
                        end)
                        -- now just poll for the boss (do NOT keep teleporting) until we're sent in
                        local t0 = os.clock()
                        while AutoRaidOn and getgenv().NexoHubSession == SESSION and (os.clock() - t0) < 15 do
                            if findRaidBoss() then break end -- got teleported into the boss room
                            task.wait(0.1)
                        end
                    else
                        -- no zone part yet: start the queue, then wait for the part to spawn
                        pcall(function()
                            CreateIslandQueue:InvokeServer({
                                Difficulty = RaidCfg.difficulty,
                                ConfigID = "StarRage",
                                Modifiers = {},
                            })
                        end)
                        task.wait(0.25)
                    end
                end
            else
                task.wait(0.3)
            end
        else
            inRaid = false -- reset when the raid toggle is off
            task.wait(0.3)
        end
    end
end)

