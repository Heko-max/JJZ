-- Generic boss-island raid runner: identical proven flow to the StarRage/Blood/Lightning/Yuta
-- raids -- queue the island -> TP into its QueueZone part -> smash the boss (alternating Black
-- Flash / normal attack) -> Retry INSTANTLY on kill and repeat; re-queue from scratch if sent to
-- spawn. Difficulty is read LIVE from RaidCfg.difficulty so the dropdown controls it. State lives
-- in RaidCfg.active[key]. Declared GLOBAL (no `local`) to avoid consuming main-chunk registers.
function makeIslandRaid(key, zoneName, configID, bossTag)
    local inThis = false
    local function findBoss()
        return findNearestTaggedBoss(bossTag) -- island-locked: only YOUR boss for this raid
    end
    local function findZone()
        local qz = workspace:FindFirstChild("QueueZones")
        local sr = qz and qz:FindFirstChild(zoneName)
        if not sr then
            for _, d in ipairs(workspace:GetDescendants()) do
                if d.Name == zoneName and (d:IsA("Model") or d:IsA("BasePart")) then sr = d break end
            end
        end
        if not sr then return nil end
        if sr:IsA("BasePart") then return sr.Position end
        local h = sr.PrimaryPart or sr:FindFirstChildWhichIsA("BasePart")
        return h and h.Position or nil
    end
    task.spawn(function()
        while getgenv().NexoHubSession == SESSION do
            if RaidCfg.active[key] then
                local mdl = getModel()
                local hrp = mdl and mdl:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local boss, bh = findBoss()
                    if boss and bh then
                        inThis = true
                        local raidTick = 0
                        while RaidCfg.active[key] and getgenv().NexoHubSession == SESSION do
                            boss, bh = findBoss()
                            if not (boss and bh) then break end
                            local cur = getModel()
                            local chrp = cur and cur:FindFirstChild("HumanoidRootPart")
                            if chrp then
                                raidTick = raidTick + 1
                                pcall(function()
                                    chrp.AssemblyLinearVelocity = Vector3.zero
                                    chrp.CFrame = auraGoal(bh)
                                end)
                                -- fire BOTH Black Flash + attack every tick (faster boss kills); each
                                -- move is still capped by its own damageReady/startReady throttle.
                                enableBlackFlash()
                                task.spawn(function() pcall(function() blackFlashList({boss}, cur, chrp) end) end)
                                task.spawn(function() pcall(function() attackList({boss}, cur, chrp) end) end)
                            end
                            task.wait(0.05)
                        end
                    elseif inThis then
                        clickPopup("next"); clickPopup("close")
                        pcall(function() RetryRaid:InvokeServer() end)
                        local t0, lastRetry = os.clock(), os.clock()
                        while RaidCfg.active[key] and getgenv().NexoHubSession == SESSION and (os.clock() - t0) < 6 do
                            if findBoss() then break end
                            if (os.clock() - lastRetry) >= 0.25 then
                                clickPopup("next"); clickPopup("close")
                                pcall(function() RetryRaid:InvokeServer() end)
                                lastRetry = os.clock()
                            end
                            task.wait()
                        end
                        if not findBoss() then inThis = false end
                    else
                        local zonePos = findZone()
                        if zonePos then
                            local chrp = hrp
                            pcall(function()
                                chrp.AssemblyLinearVelocity = Vector3.zero
                                chrp.CFrame = CFrame.new(zonePos)
                            end)
                            local t0 = os.clock()
                            while RaidCfg.active[key] and getgenv().NexoHubSession == SESSION and (os.clock() - t0) < 15 do
                                if findBoss() then break end
                                task.wait(0.1)
                            end
                        else
                            pcall(function()
                                CreateIslandQueue:InvokeServer({
                                    Difficulty = RaidCfg.difficulty,
                                    ConfigID = configID,
                                    Modifiers = {},
                                })
                            end)
                            task.wait(0.25)
                        end
                    end
                else
                    task.wait(0.3)
                end
            else
                inThis = false
                task.wait(0.3)
            end
        end
    end)
    -- Auto-click this raid's popups (safety net)
