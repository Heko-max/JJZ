-- Skill firing gate. GOAL: skill speed at 0.01 (instant) WITHOUT the "no damage" bug.
-- WHY the bug happened: "no damage" is a FLOOD problem, not a per-skill speed problem. When several
-- skills each spam the server at 0.01, the COMBINED remote traffic trips the game anti-spam, which
-- then drops ALL DamageCharacter calls (so nothing -- not even normal hits -- deals damage).
-- THE FIX: keep each skill instant (SKILL_GAP = 0.01, the "0.01" you asked for), but run a separate
-- TOTAL governor that caps the COMBINED skill traffic to a server-safe rate and shares that budget
-- fairly. It gives each active skill an equal SKILL_BUDGET/n share per second (frame-rate robust) through whatever
-- skills are currently ON, so every active skill fires and none starve -- and total traffic stays
-- low enough that damage always lands. Fast Attack (Punch) is still completely un-gated (full DPS).
local SKILL_GAP = 0.01   -- per-skill dedup: min gap between casts of the SAME skill (your "0.01").
local TOTAL_GAP = 0.02   -- min gap between ANY two skill casts (total-rate cap). THIS is the guard
                         -- that keeps attacks WORKING: RAISE it if attacks break / no damage /
                         -- IsHolding errors; LOWER it for faster total spam.
local SKILL_BUDGET = 30  -- (kept only so the settings slider still has a value to set; unused here)
local skillFireLast = {}
local skillLastReq = {}
local activeCache = {}
local activeCacheT = 0
-- Why a governor is REQUIRED (do not remove): firing every skill every frame at 0.01 floods the
-- game's OWN client SkillController -- that is the "attempt to index nil with 'IsHolding'" error
-- spam -- and it trips the server anti-spam, so DamageCharacter gets dropped and NOTHING deals
-- damage (attacks stop working). So we keep each skill at 0.01 but pace the COMBINED traffic to a
-- safe rate and rotate it fairly through whatever skills are ON, so every active skill still fires
-- and damage always lands. To kill the old per-frame table.sort lag, the active-skill list is now
-- rebuilt at most every 0.05s (the call is O(1) the rest of the time).
local function skillReady(name)
    name = name or "_"
    local now = os.clock()
    skillLastReq[name] = now
    -- per-skill dedup at your 0.01 speed
    local last = skillFireLast[name]
    if last and (now - last) < SKILL_GAP then return false end
    -- rebuild the "currently ON" list at most every 0.05s (avoids sorting every frame = no lag)
    if (now - activeCacheT) >= 0.05 then
        local a = {}
        for k, t in pairs(skillLastReq) do
            if (now - t) < 0.3 then a[#a + 1] = k end
        end
        table.sort(a)
        activeCache = a
        activeCacheT = now
    end
    -- fair rotation: give each active skill an equal turn so total traffic stays server-safe
    local n = #activeCache
    if n > 0 then
        local slot = (math.floor(now / TOTAL_GAP) % n) + 1
        if activeCache[slot] ~= name then return false end
    end
    skillFireLast[name] = now
    return true
end

