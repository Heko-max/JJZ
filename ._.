    toggleKey = "RightShift",
    accent    = Color3.fromRGB(255, 0, 0),
    autoload  = true,
})
warn("[TEST 2] CreateWindow returned: " .. type(ui))

local tab = ui:AddTab({ title = "Farm", desc = "Auto Quast , Lazy Sorcerer Quast Ect", image = "131790884061966" })
warn("[TEST 3] AddTab returned: " .. type(tab))

