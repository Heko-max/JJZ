--========================================================--
--  BOOT GATE: menu scanner + auto-Start (runs BEFORE the hub)
--  If you execute on the Jujutsu Zero title / loading screen, the world is NOT
--  loaded yet, so nothing the hub does (TP / bring / attack) can work. This
--  scanner runs after the delay above -- it watches the FULL screen GUI every
--  frame (no delay between scans), and the moment it sees this menu it clicks
--  the "Start" button for you WITHOUT moving your mouse cursor (it fires the
--  button's own click signal directly). Then it waits 2s and lets the main hub
--  load. If you're already in-world (your character exists / no menu) it skips
--  straight through.
--========================================================--
do
    pcall(function() if not game:IsLoaded() then game.Loaded:Wait() end end)
    local plr = game:GetService("Players").LocalPlayer
    if not plr then repeat task.wait() plr = game:GetService("Players").LocalPlayer until plr end

    -- true only if the object and all of its GUI ancestors are actually shown
    local function isShown(inst, root)
        local a = inst
        while a and a ~= root and a ~= game do
            if a:IsA("GuiObject") and a.Visible == false then return false end
            if a:IsA("ScreenGui") and a.Enabled == false then return false end
            a = a.Parent
        end
        return true
    end

    -- Scan the whole screen (PlayerGui + CoreGui) for a visible, clickable "Start".
    -- Letters-only compare so "Start", "> Start", "Start " all match but "Gamemodes",
    -- "Restart", "Start (NEW)" do NOT.
    local function scanStart()
        local roots = {}
        pcall(function() local pg = plr:FindFirstChildOfClass("PlayerGui"); if pg then table.insert(roots, pg) end end)
        pcall(function() table.insert(roots, game:GetService("CoreGui")) end)
        for _, root in ipairs(roots) do
            for _, d in ipairs(root:GetDescendants()) do
                local hit = false
                if d:IsA("TextButton") or d:IsA("TextLabel") then
                    local txt = ""
                    pcall(function() txt = tostring(d.Text) end)
                    local clean = string.gsub(string.lower(txt), "[^a-z]", "")
                    if clean == "start" then hit = true end
                end
                if hit then
                    local btn = d
                    if not d:IsA("GuiButton") then btn = d:FindFirstAncestorWhichIsA("GuiButton") end
                    if btn and isShown(btn, root) then return btn end
                end
            end
        end
        return nil
    end

    -- Click a button WITHOUT the cursor: fire its click signals straight to the game.
    local function fireClick(btn)
        local events = {}
        pcall(function() table.insert(events, btn.MouseButton1Click) end)
        pcall(function() table.insert(events, btn.MouseButton1Down) end)
        pcall(function() table.insert(events, btn.MouseButton1Up) end)
        pcall(function() table.insert(events, btn.Activated) end)
        for _, ev in ipairs(events) do
            pcall(function() if firesignal then firesignal(ev) end end)
            pcall(function()
                if getconnections then
                    for _, c in ipairs(getconnections(ev)) do pcall(function() c:Fire() end) end
                end
            end)
        end
    end

    local clicked = false
    local t0 = os.clock()
    while os.clock() - t0 < 30 do
        local btn = scanStart()
        if btn then
            fireClick(btn)
            clicked = true
            break
        end
        if plr.Character then break end -- already spawned in-world: no menu to click
        task.wait() -- no artificial delay: rescan the full screen every frame
    end
    if clicked then
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", { Title = "NEXO HUB", Text = "Menu detected -> clicked Start, loading...", Duration = 3 })
        end)
        task.wait(2) -- give the click a beat to register before the world starts loading
    end
end

