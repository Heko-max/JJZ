    -- We fetch the text, strip any BOM + leading whitespace, THEN compile it.
    local LIB_URL = "https://raw.githubusercontent.com/Heko-max/New-Start/refs/heads/main/Deamon%20Soul%20script%20ui"
    local Library
    do
        local ok, src = pcall(function() return game:HttpGet(LIB_URL) end)
