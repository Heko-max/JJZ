--  IDENTIFY OUR OWN SERVER MODEL
--========================================================--
MyModel = nil -- GLOBAL (not local): the single persistent __namecall hook is installed once across re-runs and writes this, so every run reads the same shared value
-- IN-FLIGHT FLOOD GUARD: DamageCharacter/StartSkill are RemoteFUNCTIONS, so every :InvokeServer
-- YIELDS until the server replies. Under heavy fast-skill spam (especially the Awakened Star raid)
-- the server slows / rate-limits, the calls pile up, and after ~1-2 min the backlog trips the
-- anti-spam so NO hits register anymore. We cap how many calls may be WAITING at once and DROP the
-- extras (they're just redundant AOE re-hits), which stops the backlog and keeps damage landing.
local dmgWaiting = 0
local startWaiting = 0
local MAX_DMG_WAITING = 5   -- max DamageCharacter calls waiting on the server at once (raise if damage feels capped, lower if it still stalls)
local MAX_START_WAITING = 4 -- max StartSkill calls waiting on the server at once
pcall(function()
    -- Install the __namecall hook only ONCE across re-runs. hookmetamethod CANNOT be undone, so
    -- re-running the script (without rejoining) used to STACK another hook every time -- after a few
    -- re-runs EVERY :Method() call in the whole game passed through many stacked layers = severe,
    -- permanent lag even with all toggles OFF. This guard makes re-running cheap. (A fresh REJOIN is
    -- still needed once to clear hooks that older script versions already stacked.)
    if getgenv().NexoHubHooked then return end
    getgenv().NexoHubHooked = true
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        local m = getnamecallmethod()
        if m == "InvokeServer" and typeof(self) == "Instance" then
            if self == DamageCharacter then
                local a = {...}
                local info = a[3]
                if typeof(info) == "table" and typeof(info.LocalCharacter) == "Instance"
                   and info.LocalCharacter.Parent == PlayersF then
                    MyModel = info.LocalCharacter
                end
                if dmgWaiting >= MAX_DMG_WAITING then return end -- server backed up: drop this redundant hit
                dmgWaiting = dmgWaiting + 1
                local ok, r = pcall(old, self, ...)
                dmgWaiting = dmgWaiting - 1
                if ok then return r end
                return
            elseif self == StartSkill then
                local a = {...}
                if typeof(a[2]) == "Instance" and a[2].Parent == PlayersF then
                    MyModel = a[2]
                end
                if startWaiting >= MAX_START_WAITING then return end -- server backed up: drop this redundant cast
                startWaiting = startWaiting + 1
                local ok2, r2 = pcall(old, self, ...)
                startWaiting = startWaiting - 1
                if ok2 then return r2 end
                return
            elseif self == UseItem then
                -- CAPTURE the exact chest/crate open remote you fire yourself, so Auto Open Chest
                -- can replay it. Preserves the full arg list (code + mode) exactly as the game sends.
                lastChestArgs = table.pack(...)
            end
        end
        return old(self, ...)
    end)
end)

local function getModel()
    if MyModel and MyModel.Parent == PlayersF then return MyModel end
    local char = LocalPlayer.Character
    if char and char.Parent == PlayersF then MyModel = char return char end
    local refPos
    if char and char:FindFirstChild("HumanoidRootPart") then
        refPos = char.HumanoidRootPart.Position
    elseif workspace.CurrentCamera then
        refPos = workspace.CurrentCamera.CFrame.Position
    end
    if refPos then
        local best, bestD
        for _, m in ipairs(PlayersF:GetChildren()) do
            local hrp = m:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - refPos).Magnitude
                if not bestD or d < bestD then best, bestD = m, d end
            end
        end
        return best
    end
    return nil
end

--========================================================--
--  MY ISLAND FILTER  (only hit NPCs on YOUR boss island)
--========================================================--
-- In SummerSiege / boss-island raids, every player is teleported to their OWN copy of the island
-- (see workspace.Map.Geometry.BossIslands -> several SummerSiege models). The summer-NPC name-tags
-- are IDENTICAL on every island, so name-matching alone ALSO grabs other players' NPCs. This filter
-- assigns each NPC (and YOU) to the nearest island model, then only keeps NPCs sitting on the SAME
-- island you're standing on. NPCs that aren't on any island (normal open world) are left untouched,
-- so nothing else about your targeting changes.
MY_ISLAND_ONLY = true      -- master switch (also wired to a GUI toggle in the Summer Raid section)
local ISLAND_MARGIN = 60   -- studs of slack added around each island's bounding sphere

-- locate workspace.Map.Geometry.BossIslands (cached ~3s; falls back to a name scan)
IslandFolderCache = { t = -1, folder = nil }
local function getBossIslandsFolder()
    local now = os.clock()
    local f = IslandFolderCache.folder
    if f and f.Parent and (now - IslandFolderCache.t) < 3 then return f end
    f = nil
    local map = workspace:FindFirstChild("Map")
    local geo = map and map:FindFirstChild("Geometry")
    if geo then f = geo:FindFirstChild("BossIslands") end
    if not f then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d.Name == "BossIslands" and (d:IsA("Folder") or d:IsA("Model")) then f = d break end
        end
    end
    IslandFolderCache.folder = f
    IslandFolderCache.t = now
    return f
end

-- center + radius of every island model (cached ~2s; islands don't move but new ones can spawn)
IslandListCache = { t = -1, list = {} }
local function getIslandList()
    local now = os.clock()
    if IslandListCache.t >= 0 and (now - IslandListCache.t) < 2 then return IslandListCache.list end
    local list = {}
    local folder = getBossIslandsFolder()
    if folder then
        for _, m in ipairs(folder:GetChildren()) do
            if m:IsA("Model") then
                local ok, cf, size = pcall(function() return m:GetBoundingBox() end)
                if ok and cf and size then
                    table.insert(list, {
                        model  = m,
                        cf     = cf,
                        center = cf.Position,
                        half   = (size * 0.5) + Vector3.new(ISLAND_MARGIN, ISLAND_MARGIN, ISLAND_MARGIN),
                    })
                end
            end
        end
    end
    IslandListCache.list = list
    IslandListCache.t = now
    return list
end

-- nearest island (by center) to a world position + that distance
local function nearestIsland(pos)
    local best, bestD
    for _, isl in ipairs(getIslandList()) do
        local d = (isl.center - pos).Magnitude
        if not bestD or d < bestD then best, bestD = isl, d end
    end
    return best, bestD
end

-- which island a position actually SITS INSIDE (oriented bounding box), or nil if it's open-world.
-- The box test is far more precise than a sphere, so an NPC on a NEIGHBOURING island is never
-- mistaken for yours even when the islands are packed close together.
local function islandOf(pos)
    local best, bestD
    for _, isl in ipairs(getIslandList()) do
        local rel = isl.cf:PointToObjectSpace(pos)
        if math.abs(rel.X) <= isl.half.X and math.abs(rel.Y) <= isl.half.Y and math.abs(rel.Z) <= isl.half.Z then
            local d = (isl.center - pos).Magnitude
            if not bestD or d < bestD then best, bestD = isl, d end
        end
    end
    return best
end

-- YOUR island = the one you're standing on (fallback: the nearest one). Cached ~0.4s.
MyIslandCache = { t = -1, isl = nil }
local function myIsland()
    local now = os.clock()
    if MyIslandCache.t >= 0 and (now - MyIslandCache.t) < 0.4 then return MyIslandCache.isl end
    local isl = nil
    local mdl = getModel()
    local hrp = mdl and mdl:FindFirstChild("HumanoidRootPart")
    if hrp then
        isl = islandOf(hrp.Position) or (nearestIsland(hrp.Position))
    end
    MyIslandCache.isl = isl
    MyIslandCache.t = now
    return isl
end

-- TRUE if a target at `pos` is allowed: same island as you, OR not on any island (open world).
-- If there are 0/1 islands, or we can't resolve your island, allow everything (acts as a no-op).
function onMyIsland(pos)
    if not MY_ISLAND_ONLY then return true end
    local islands = getIslandList()
    if #islands <= 1 then return true end        -- nothing to separate
    local mine = myIsland()
    if not mine then return true end
    local here = islandOf(pos)
    if not here then return true end             -- open-world NPC -> unaffected
    return here.model == mine.model
end

--========================================================--
--  TARGETING + ATTACK
--========================================================--
-- Ignore this practice-dummy NPC EVERYWHERE targets/bring/attack lists are built (Bring Inf Range,
-- Bring Gojo, Bring Boss, Auto Summer NPC, Kill Aura / general Bring, Fast Attack, raids, etc.) --
-- it should never be pulled to you or attacked. Declared GLOBAL so every collection function can use
-- it. Uses the SAME 3-strategy name check as Boss Hunter (the server model's raw Name is often NOT
-- the display name, so we also read the nameplate text, same as how bosses are identified):
--   A) the server model's own .Name
--   B) a TextLabel nameplate attached directly under the server model itself
--   C) a TextLabel nameplate in the separate client-side "Client" replica folder, matched to the
--      server model by proximity (cached ~0.2s so every NPC check stays cheap in tight loops)
IGNORED_NPC_NAMES = { "lv.1 punching bag", "punching bag" }
local function textMatchesIgnored(txt)
    local low = string.lower(txt)
    for _, ig in ipairs(IGNORED_NPC_NAMES) do
        if string.find(low, ig, 1, true) then return true end
    end
    return false
end
PunchingBagPosCache = { t = -1, list = {} }
function refreshPunchingBagPositions()
    local now = os.clock()
    if PunchingBagPosCache.t >= 0 and (now - PunchingBagPosCache.t) < 0.2 then
        return PunchingBagPosCache.list
    end
    local list = {}
    local ok = pcall(function()
        local ClientF = Characters:FindFirstChild("Client")
        if not ClientF then return end
        for _, d in ipairs(ClientF:GetDescendants()) do
            if d:IsA("TextLabel") and textMatchesIgnored(d.Text) then
                local rig = d:FindFirstAncestorWhichIsA("Model")
                local h = rig and rig:FindFirstChild("HumanoidRootPart")
                if h then table.insert(list, h.Position) end
            end
        end
    end)
    if ok then
        PunchingBagPosCache.list = list
        PunchingBagPosCache.t = now
    end
    return PunchingBagPosCache.list
end
function isPunchingBag(m)
    if not m then return false end
    -- Strategy A: the server model's own Name
    local ok, nm = pcall(function() return m.Name end)
    if ok and nm and textMatchesIgnored(nm) then return true end
    -- Strategy B: a nameplate TextLabel attached directly under this server model
    local ok2, hitB = pcall(function()
        for _, d in ipairs(m:GetDescendants()) do
            if d:IsA("TextLabel") and textMatchesIgnored(d.Text) then return true end
        end
        return false
    end)
    if ok2 and hitB then return true end
    -- Strategy C: separate client-side nameplate folder, matched to this model by proximity
    local ok3, hitC = pcall(function()
        local h = m:FindFirstChild("HumanoidRootPart")
        if not h then return false end
        for _, pos in ipairs(refreshPunchingBagPositions()) do
            if (h.Position - pos).Magnitude < 25 then return true end
        end
        return false
    end)
    if ok3 and hitC then return true end
    return false
end
function computeTargets(range)
    range = range or ATTACK_RANGE
    local myModel = getModel()
    local myHRP = myModel and myModel:FindFirstChild("HumanoidRootPart")
    if not myHRP then return {}, nil, nil end
    -- OUTER RAID SEQUENCE: while we're voiding the boss, return NO targets so EVERY fast attack / fast
    -- skill / Black Flash and the engine all pause for a beat. Sequence = attacks OFF -> boss TP'd to
    -- the void -> attacks resume (start killing the NPCs). Also stops anything chasing the boss out.
    if outerVoidPausing then return {}, myModel, myHRP end
    local myPos = myHRP.Position
    local targets = {}
    local function scan(folder)
        if not folder then return end
        for _, m in ipairs(folder:GetChildren()) do
            if m ~= myModel and not isPunchingBag(m) then
                local h = m:FindFirstChild("HumanoidRootPart")
                local hum = m:FindFirstChildOfClass("Humanoid")
                if h and hum and hum.Health > 0 and (h.Position - myPos).Magnitude <= range and onMyIsland(h.Position) then
                    table.insert(targets, m)
                end
            end
        end
    end
    scan(NPCsF)
    if HIT_PLAYERS then scan(PlayersF) end
    -- Outer World raid PRIORITY: while any "Star Remnant" add is alive, force EVERY skill/attack
    -- (Fast Attack, Black Flash, Inf Aura, Copy, Star Rage, etc.) to target ONLY the adds, so nothing
    -- stays locked on the Awakened Star boss. Falls back to normal targeting once the adds are dead.
    if AutoOuterRaidOn then
        -- PERF: the heavy scan (client name-tag descendants + every server folder) is done by a
        -- background refresher ~10x/sec that fills outerAddCache. Here we only do a CHEAP liveness
        -- re-check + nearest-first sort on that small cached list, so every skill still fires every
        -- frame at full speed instead of rescanning the whole workspace dozens of times per frame.
        -- Identical targeting logic -- just cached so it isn't recomputed on every call. The boss
        -- (outerBossModel) is maintained by the same refresher.
        local cached = outerAddCache
        if cached and #cached > 0 then
            local adds = {}
            for _, m in ipairs(cached) do
                if m and m.Parent and not isPunchingBag(m) then
                    local hum = m:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health > 0 then table.insert(adds, m) end -- NPCs AND parts (no Humanoid)
                end
            end
            if #adds > 0 then
                local function posOf(x)
                    local p = x:FindFirstChild("HumanoidRootPart") or (x:IsA("Model") and x.PrimaryPart)
                    return p and p.Position or nil
                end
                table.sort(adds, function(a, b)
                    local ap, bp = posOf(a), posOf(b)
                    local ad = ap and (ap - myPos).Magnitude or math.huge
                    local bd = bp and (bp - myPos).Magnitude or math.huge
                    return ad < bd
                end)
                return adds, myModel, myHRP
            end
        end
    end
    return targets, myModel, myHRP
end
-- PERF (no logic change): 30+ fast-skill / attack loops call collectTargets() with NO range every
-- frame, and each call rescans every NPC -- that redundant scanning is the main cause of Fast-*
-- lag. This wrapper reuses the result computed within the last frame (~25ms) for the default-range
-- (no-arg) calls, so targeting is IDENTICAL but the NPC scan runs once per frame instead of dozens
-- of times. Calls that pass an explicit range (e.g. getNearest) always compute fresh and never
-- touch the cache. Cache is global to avoid using scarce main-chunk local registers.
TgtCache = TgtCache or {}
local function collectTargets(range)
    if range == nil then
        local now = os.clock()
        if TgtCache.a and (now - (TgtCache.t or 0)) < 0.025 then
            return TgtCache.a, TgtCache.b, TgtCache.c
        end
        local a, b, c = computeTargets(nil)
        -- Only cache a REAL result. If we momentarily have no character (b == nil, e.g. mid-respawn)
        -- skip caching so the very next call recomputes instead of returning "no targets" -- this
        -- guarantees the cache can never briefly starve attacks/skills.
        if b then
            TgtCache.a, TgtCache.b, TgtCache.c, TgtCache.t = a, b, c, now
        end
        return a, b, c
    end
    return computeTargets(range)
end

local function getNearest(range)
    local targets, myModel, myHRP = collectTargets(range)
    if not myHRP or #targets == 0 then return nil, myModel, myHRP end
    local nearest, nd
    for _, m in ipairs(targets) do
        local h = m:FindFirstChild("HumanoidRootPart")
        if h then
            local d = (h.Position - myHRP.Position).Magnitude
            if not nd or d < nd then nearest, nd = m, d end
        end
    end
    return nearest, myModel, myHRP
end

