    NexoTpPartList, NexoTpPartKey, NexoTpPartIdx = {}, "", 0 -- cycle state (list, typed name, position in list)

    -- returns the position of a part/model (BasePart -> .Position, Model -> pivot), else nil
    function NexoPosOfObject(obj)
        if not obj then return nil end
        local pos
        pcall(function()
            if obj:IsA("BasePart") then
                pos = obj.Position
            elseif obj:IsA("Model") then
                pos = obj:GetPivot().Position
            elseif obj:IsA("Attachment") then
                pos = obj.WorldPosition
            end
        end)
        return pos
    end

    -- collect EVERY object with that name (exact matches preferred, else partial), in a STABLE order
    -- so the click cycle is always the same 1, 2, 3 ... run after run.
    function NexoCollectObjects(name)
        local exact, loose = {}, {}
        local low = string.lower(name)
        pcall(function()
            for _, d in ipairs(wsDesc()) do
                if NexoPosOfObject(d) then
                    if d.Name == name then
                        exact[#exact + 1] = d
                    elseif string.find(string.lower(d.Name), low, 1, true) then
                        loose[#loose + 1] = d
                    end
                end
            end
        end)
        local list = (#exact > 0) and exact or loose
        pcall(function()
            table.sort(list, function(a, b)
                local pa, pb = NexoPosOfObject(a), NexoPosOfObject(b)
                if not pa or not pb then return false end
                if pa.X ~= pb.X then return pa.X < pb.X end
                if pa.Y ~= pb.Y then return pa.Y < pb.Y end
                return pa.Z < pb.Z
            end)
        end)
        return list
    end

