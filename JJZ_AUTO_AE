--  AUTO LAZY SORCERER QUEST  (Farm tab)  +  AUTO KILL Lv.1 CURSE REMNANT
--    Gate 1..4 buttons -> TP onto SealedGate1..4, then fire Gate1..Gate4 five times each
--    Lazy Sorcerer switch -> accept "TengenFog", then for EVERY "FogSealedGate" part:
--        TP onto it -> wait 0.5s (TP settle) -> press F 3x -> next part -> stop when all are done
--    Curse Remnant switch -> TP + kill the NPC named exactly "Lv.1 Curse Remnant"
--  PHONE / MOBILE SAFE: the F interaction fires the actual ProximityPrompt(s) on the gate as well
--  as sending the key, so it works on executors with no keyboard (Delta, Codex, Arceus, etc.).
--  ALL GLOBAL: the main chunk is near Luau's 200 local-register cap.
--========================================================--
LazyFogOn      = false -- Auto Lazy Sorcerer Quest switch
LazyGateBusy   = false -- guards the 4 gate buttons so double-taps never stack
CurseRemnantOn = false -- Farm tab switch
BossRemnantOn  = false -- Boss tab selector (kept separate so the two never fight)
LAZY_FOG_PART  = "FogSealedGate"
LAZY_FOG_DELAY = 0.5   -- seconds to settle AFTER each teleport (NOT between F presses)

-- position of a part / model / attachment (nil if it has none)
function NexoObjPos(obj)
    if not obj then return nil end
    local pos
    pcall(function()
        if obj:IsA("BasePart") then
            pos = obj.Position
        elseif obj:IsA("Model") then
            pos = obj:GetPivot().Position
        elseif obj:IsA("Attachment") then
            pos = obj.WorldPosition
        end
    end)
    return pos
end

-- EVERY object named exactly `name`, in a stable order (X, then Y, then Z) so the walk is repeatable
function NexoAllNamed(name)
    local out = {}
    pcall(function()
        for _, d in ipairs(wsDesc()) do
            if d.Name == name and NexoObjPos(d) then out[#out + 1] = d end
        end
    end)
    pcall(function()
        table.sort(out, function(a, b)
            local pa, pb = NexoObjPos(a), NexoObjPos(b)
            if not pa or not pb then return false end
            if pa.X ~= pb.X then return pa.X < pb.X end
            if pa.Y ~= pb.Y then return pa.Y < pb.Y end
            return pa.Z < pb.Z
        end)
    end)
    return out
end

-- ONE "press F" on a specific object -- mobile safe.
-- 1) fires every ProximityPrompt on the object (and any within 25 studs) -> works with NO keyboard
-- 2) also sends a real F key press for gates that listen for the key instead of a prompt
function NexoInteractF(obj)
    pcall(function()
        if not fireproximityprompt then return end
        if obj then
            for _, p in ipairs(obj:GetDescendants()) do
                if p:IsA("ProximityPrompt") then fireproximityprompt(p) end
            end
            local parent = obj.Parent
            if parent then
                for _, p in ipairs(parent:GetDescendants()) do
                    if p:IsA("ProximityPrompt") then fireproximityprompt(p) end
                end
            end
        end
        -- catch prompts parented somewhere else but physically on top of us
        local mdl = getModel()
        local hrp = mdl and mdl:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, p in ipairs(wsDesc()) do
                if p:IsA("ProximityPrompt") then
                    local par = p.Parent
                    local ppos = par and NexoObjPos(par)
                    if ppos and (ppos - hrp.Position).Magnitude <= 25 then fireproximityprompt(p) end
                end
            end
        end
    end)
    NexoPressF() -- VirtualInputManager, then keypress/keyrelease fallback
end

-- GATE BUTTONS 1-4: TP onto the SealedGate part, then fire the quest remote 5 times
function NexoLazyGate(partName, questId)
    if LazyGateBusy then return end
    LazyGateBusy = true
    task.spawn(function()
        local list = NexoAllNamed(partName)
        local pos = (list[1] and NexoObjPos(list[1])) or NexoFindPartPos(partName)
        if pos then
            pcall(function() nexoTpTo(pos + Vector3.new(0, 3, 0)) end)
            task.wait(LAZY_FOG_DELAY)
        end
        for _ = 1, 5 do -- remote fired 5 times, exactly as asked
            if getgenv().NexoHubSession ~= SESSION then break end
            pcall(function() AcceptQuest:InvokeServer(questId) end)
            task.wait(0.2)
        end
        pcall(function() Library:Notify({
            Title = "NEXO HUB",
            Content = pos and (partName .. " done") or ("No " .. partName .. " found"),
            Type = pos and "Success" or "Error", Duration = 3,
        }) end)
        LazyGateBusy = false
    end)
end

-- Every DISTINCT FogSealedGate in the world, as a fixed snapshot of POSITIONS.
-- Why a snapshot of positions instead of live objects: the gates get consumed / re-parented while
-- you clear them, which was making the walk lose its place and skip gates. Positions can't vanish,
-- so once we snapshot 10 of them we always visit all 10, one by one.
-- Uses a DIRECT workspace scan (not the 1.5s shared cache) so no gate is ever missed, and dedupes
-- anything closer than LAZY_FOG_DEDUPE studs so one gate is never counted (or visited) twice.
LAZY_FOG_DEDUPE = 8
function NexoFogPoints()
    local raw = {}
    local ok, all = pcall(function() return workspace:GetDescendants() end)
    if ok and type(all) == "table" then
        for _, d in ipairs(all) do
            if d.Name == LAZY_FOG_PART then
                local p = NexoObjPos(d)
                if p then raw[#raw + 1] = { pos = p, obj = d } end
            end
        end
    end
    -- stable order (X, then Y, then Z) so the 1-by-1 walk is the same every run
    pcall(function()
        table.sort(raw, function(a, b)
            if a.pos.X ~= b.pos.X then return a.pos.X < b.pos.X end
            if a.pos.Y ~= b.pos.Y then return a.pos.Y < b.pos.Y end
            return a.pos.Z < b.pos.Z
        end)
    end)
    local out = {}
    for _, e in ipairs(raw) do
        local dupe = false
        for _, k in ipairs(out) do
            if (k.pos - e.pos).Magnitude <= LAZY_FOG_DEDUPE then dupe = true break end
        end
        if not dupe then out[#out + 1] = e end
    end
    return out
end

-- LAZY SORCERER WORKER -- exact flow:
--   accept "TengenFog"  ->  wait 1.5s  ->  TP gate 1  ->  F x3  ->  wait 0.5s  ->  TP gate 2  -> ...
-- Every teleport goes to a DIFFERENT gate (each snapshot entry is visited exactly once, in order),
-- never the same one twice. After all of them are cleared it stops and switches itself OFF.
LAZY_FOG_ACCEPT_WAIT = 1.5 -- after accepting the quest, before the first teleport
LAZY_FOG_STEP_WAIT   = 0.5 -- after the 3 F presses, before moving to the next gate
LAZY_FOG_TP_SETTLE   = 0.15 -- tiny pause so the teleport actually applies before F is pressed
task.spawn(function()
    while getgenv().NexoHubSession == SESSION do
        if LazyFogOn then
            pcall(function() AcceptQuest:InvokeServer("TengenFog") end) -- accept FIRST
            task.wait(LAZY_FOG_ACCEPT_WAIT)                             -- then wait 1.5s
            local pts = NexoFogPoints()
            if #pts == 0 then
                task.wait(1) -- none in the world yet (or quest already finished): look again
            else
                local total, done = #pts, 0
                for _, e in ipairs(pts) do -- one gate per step, all of them, in order
                    if (not LazyFogOn) or getgenv().NexoHubSession ~= SESSION then break end
                    pcall(function() nexoTpTo(e.pos + Vector3.new(0, 3, 0)) end)
                    task.wait(LAZY_FOG_TP_SETTLE)
                    for _ = 1, 3 do NexoInteractF(e.obj) end -- F x3 (prompt-fire + key = phone safe)
                    done = done + 1
