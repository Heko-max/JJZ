StarBossOn = false -- Auto Kill Lunatic Cultist Boss -> Void Trace ("Lv.1 Lunatic Cultist")
STAR_Q3_POS = Vector3.new(5402.52, 456.64, -2976.05) -- Quest 3 (Sister Veyra) air spot
STAR_Q5_POS = Vector3.new(5375.31, 436.16, -2738.1) -- Quest 5 (Aria) air spot
starTick = 0

function NexoStarAnyOn()
