-- ============================ JUJUTSU TRIAL (Trial Tower) ============================
-- Auto Trial: pick a Chamber (1-11) in the Raid tab, flip the switch, and this loop runs
--   StartTower_Method:InvokeServer("C<n>")  ->  detect + smash that chamber's NPC
--   (same detection path as the raids: client name-tag -> nearest live server NPC)
--   ->  BossIslandService.Return_Method:InvokeServer()  ->  start again, forever.
-- Everything is GLOBAL (no `local`) so we don't burn scarce main-chunk local registers.
TrialOn = false
TrialChamber = 1 -- 1..11, set by the Raid-tab dropdown
-- Chamber -> client name-tag of the NPC that spawns for it (lowercase, substring match)
TRIAL_NPC_TAGS = {
    [1]  = "choso",
    [2]  = "sorcerer killer",
    [3]  = "deadly judge",
    [4]  = "jogo",
    [5]  = "cursed prodigy",
    [6]  = "awakened zen'in",
    [7]  = "awakened lightning god",
    [8]  = "awakened blood user",
    [9]  = "awakened star",
    [10] = "king of curses",
    [11] = "awakened king of curses",
}
-- Lazy remote lookups (wrapped so a missing service never breaks the rest of the hub)
function trialStartRemote()
    local ok, r = pcall(function()
        local svc = Net:FindFirstChild("TrialTowerService")
        return svc and svc:FindFirstChild("StartTower_Method")
    end)
    return ok and r or nil
end
function trialReturnRemote()
    local ok, r = pcall(function()
        local svc = Net:FindFirstChild("BossIslandService")
        return svc and svc:FindFirstChild("Return_Method")
    end)
    return ok and r or nil
end
-- Detect the chamber NPC exactly like the raid/quest detection: find the client name-tag that
-- contains the NPC name, then map it to the NEAREST live server NPC (the damageable model).
-- No island lock here (the trial tower is your own instance), so it is found instantly.
function trialFindNPC(tag)
    if not tag then return nil end
    local ClientF = Characters:FindFirstChild("Client")
    local pos
    if ClientF then
        for _, d in ipairs(clientDesc(ClientF)) do
            if d:IsA("TextLabel") and string.find(string.lower(d.Text), tag, 1, true) then
                local rig = d:FindFirstAncestorWhichIsA("Model")
                local h = rig and rig:FindFirstChild("HumanoidRootPart")
                if h then pos = h.Position break end
            end
        end
    end
    if NPCsF then
        if pos then
            local best, bestD
            for _, m in ipairs(NPCsF:GetChildren()) do
                local h = m:FindFirstChild("HumanoidRootPart")
                local hum = m:FindFirstChildOfClass("Humanoid")
                if h and hum and hum.Health > 0 and nexoValidNpc(m) then
                    local dd = (h.Position - pos).Magnitude
                    if dd < 25 and (not bestD or dd < bestD) then best, bestD = m, dd end
                end
            end
            if best then return best, best:FindFirstChild("HumanoidRootPart") end
        end
        -- FALLBACK: no name-tag streamed in yet -> match the server NPC model name directly
        for _, m in ipairs(NPCsF:GetChildren()) do
            local h = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 and string.find(string.lower(m.Name), tag, 1, true) then
                return m, h
            end
        end
    end
    return nil
end
task.spawn(function()
    while getgenv().NexoHubSession == SESSION do
        if TrialOn then
            local tag = TRIAL_NPC_TAGS[TrialChamber] or TRIAL_NPC_TAGS[1]
            local npc, nh = trialFindNPC(tag)
            if npc and nh then
                -- KILL PHASE: identical to the raid kill path (Black Flash + attack every tick)
                while TrialOn and getgenv().NexoHubSession == SESSION do
                    npc, nh = trialFindNPC(tag)
                    if not (npc and nh) then break end
                    local cur = getModel()
                    local chrp = cur and cur:FindFirstChild("HumanoidRootPart")
                    if chrp then
                        pcall(function()
                            chrp.AssemblyLinearVelocity = Vector3.zero
                            chrp.CFrame = auraGoal(nh)
                        end)
                        enableBlackFlash()
                        task.spawn(function() pcall(function() blackFlashList({npc}, cur, chrp) end) end)
                        task.spawn(function() pcall(function() attackList({npc}, cur, chrp) end) end)
                    end
                    task.wait(0.05)
                end
                -- NPC dead -> clear popups and RETURN instantly, then the loop starts the next run
                clickPopup("next"); clickPopup("close")
                local ret = trialReturnRemote()
                if ret then pcall(function() ret:InvokeServer() end) end
                task.wait(0.1)
            else
                -- START PHASE: fire StartTower with this chamber's ID ("C1" .. "C11")
                local st = trialStartRemote()
                if st then pcall(function() st:InvokeServer("C" .. tostring(TrialChamber)) end) end
                local t0 = os.clock()
                while TrialOn and getgenv().NexoHubSession == SESSION and (os.clock() - t0) < 4 do
                    if trialFindNPC(tag) then break end
                    task.wait(0.05)
                end
                if TrialOn and not trialFindNPC(tag) then
                    -- nothing spawned (still inside a finished run) -> Return, then retry immediately
                    clickPopup("next"); clickPopup("close")
                    local ret = trialReturnRemote()
                    if ret then pcall(function() ret:InvokeServer() end) end
                    task.wait(0.1)
                end
            end
        else
            task.wait(NEXO_IDLE)
        end
    end
end)
