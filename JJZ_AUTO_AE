-- Quest 1 hand-in: TP to the "CultInvite" MODEL in the workspace and press F 5 times.
-- (The remote path did nothing, so this does it the same way you do it by hand.)
STAR_Q1_MODEL = "CultInvite" -- exact name of the model to walk up to
StarQ1Busy = false           -- true while a TP+press run is in progress (never stack two)

-- find the CultInvite model anywhere in the workspace (cached until it despawns)
StarQ1Cache = nil
function NexoFindCultInvite()
    if StarQ1Cache and StarQ1Cache.Parent then return StarQ1Cache end
    local found
    pcall(function() found = workspace:FindFirstChild(STAR_Q1_MODEL, true) end)
    StarQ1Cache = found
    return found
end

-- one F keypress (VirtualInputManager first, then the executor's keypress/keyrelease)
function NexoPressF()
    local done = false
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        done = true
    end)
    if not done and keypress and keyrelease then
        pcall(function()
            keypress(0x46) -- 0x46 = F
            task.wait(0.05)
            keyrelease(0x46)
        end)
    end
end

function NexoStarCultInvite()
    if StarQ1Busy then return false end
    local mdl = NexoFindCultInvite()
    if not mdl then return false end
    local pivot
    pcall(function() pivot = mdl:GetPivot().Position end)
    if not pivot then return false end
    local me = getModel()
    local hrp = me and me:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    StarQ1Busy = true
    -- TP onto the model, then press F 5 times, re-pinning us on the spot before each press
    for _ = 1, 5 do
        if not StarQ1On or getgenv().NexoHubSession ~= SESSION then break end
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = CFrame.new(pivot + Vector3.new(0, 3, 0))
        end)
        task.wait(0.2)
        -- if the model uses a ProximityPrompt instead of a plain F key, fire that too
        pcall(function()
            if not fireproximityprompt then return end
            for _, p in ipairs(mdl:GetDescendants()) do
                if p:IsA("ProximityPrompt") then fireproximityprompt(p) end
            end
        end)
        NexoPressF()
        task.wait(0.2)
    end
    StarQ1Busy = false
    return true
end

-- every LIVE server NPC whose name (or client nameplate) contains `nameLow`
-- Same 2-step match Auto Quest uses: server model .Name, else the client rig nameplate by proximity.
function NexoStarNPCs(nameLow)
    local myModel = getModel()
    local myHRP = myModel and myModel:FindFirstChild("HumanoidRootPart")
    if not myHRP or not NPCsF then return {}, nil, nil end
    local hits = {}
    pcall(function()
        local ClientF = Characters:FindFirstChild("Client")
        if not ClientF then return end
        for _, d in ipairs(clientDesc(ClientF)) do
            if d:IsA("TextLabel") and string.find(string.lower(d.Text), nameLow, 1, true) then
                local rig = d:FindFirstAncestorWhichIsA("Model")
                local h = rig and rig:FindFirstChild("HumanoidRootPart")
                if h then table.insert(hits, h.Position) end
            end
        end
    end)
    local targets = {}
    for _, m in ipairs(NPCsF:GetChildren()) do
        if m ~= myModel and not isPunchingBag(m) then
            local h = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                if string.find(string.lower(m.Name), nameLow, 1, true) then
                    table.insert(targets, m)
                else
                    for _, pos in ipairs(hits) do
                        if (h.Position - pos).Magnitude < 10 then
                            table.insert(targets, m)
                            break
                        end
                    end
                end
            end
        end
    end
    return targets, myModel, myHRP
end

-- kill list: alternating Black Flash / punch, identical to the Auto Quest attack engine
function NexoStarKill(list, myModel, myHRP)
    if not myModel or not myHRP or #list == 0 then return end
    local inRange = {}
    for _, m in ipairs(list) do
        local h = m:FindFirstChild("HumanoidRootPart")
        if h and (h.Position - myHRP.Position).Magnitude <= ATTACK_RANGE then
            inRange[#inRange + 1] = m
        end
    end
    if #inRange == 0 then return end
    starTick = starTick + 1
    if starTick % 2 == 0 then
        enableBlackFlash()
        task.spawn(function() pcall(function() blackFlashList(inRange, myModel, myHRP) end) end)
    else
        task.spawn(function() pcall(function() attackList(inRange, myModel, myHRP) end) end)
    end
end

-- pull every matching NPC into a ring around you (no range limit), same as Bring Gojo
function NexoStarBring(list, myHRP)
    if not myHRP or #list == 0 then return end
    pcall(function() myHRP.AssemblyLinearVelocity = Vector3.zero end)
    for i, m in ipairs(list) do
        local h = m:FindFirstChild("HumanoidRootPart")
        if h then
            local angle = (i / #list) * math.pi * 2
            local off = Vector3.new(math.cos(angle) * BRING_OFFSET, 0, math.sin(angle) * BRING_OFFSET)
            pcall(function()
                h.AssemblyLinearVelocity = Vector3.zero
                h.CFrame = CFrame.new(myHRP.Position + off)
            end)
        end
    end
end

