--========================================================--
--  PROTECTION: ANTI-AFK  +  ANTI-TELEPORT / ANTI-REJOIN
--  Both are toggles in Misc > Protection (default ON).
--    AntiAfkOn  : never get kicked for idling.
--    AntiTpOn   : blocks EVERY teleport/rejoin attempt (TeleportService
--                 calls AND remote events named like rejoin/teleport/
--                 changeserver), plus Kick, so no script or remote can
--                 move you to another game or force an RJ.
--  The hub's own Find-Boss server hop is whitelisted through NexoAllowTp,
--  so that feature still works while everything else stays blocked.
--========================================================--
AntiAfkOn   = (AntiAfkOn == nil) and true or AntiAfkOn   -- GLOBAL: anti idle-kick
AntiTpOn    = (AntiTpOn == nil) and true or AntiTpOn     -- GLOBAL: block TP / RJ
NexoAllowTp = false                                      -- GLOBAL: internal hop pass

-- ANTI-AFK: fake a real input so the idle timer never builds up.
-- Every trick is tried in order and we REMEMBER which one worked, so it cannot
-- silently do nothing on an executor that lacks VirtualUser.
NEXO_AfkNudges = 0   -- how many nudges actually landed (shown in the Status tab)
NEXO_AfkMethod = "-" -- which trick is doing the work
function NexoAfkNudge()
    -- 1) VirtualUser right-click: the standard, harmless (never presses a game button)
    local ok = pcall(function()
        local VU = game:GetService("VirtualUser")
        VU:CaptureController()
        VU:ClickButton2(Vector2.new())
    end)
    if ok then
        NEXO_AfkMethod = "VirtualUser"
    else
        -- 2) VirtualInputManager fallback for executors without VirtualUser
        ok = pcall(function()
            local VIM = game:GetService("VirtualInputManager")
            VIM:SendMouseButtonEvent(0, 0, 1, true, game, 1)
            VIM:SendMouseButtonEvent(0, 0, 1, false, game, 1)
        end)
        if ok then
            NEXO_AfkMethod = "VirtualInput"
        else
            -- 3) last resort: a 0-stud camera nudge still counts as activity
            ok = pcall(function()
                local cam = workspace.CurrentCamera
                cam.CFrame = cam.CFrame * CFrame.Angles(0, 0.0001, 0)
            end)
            NEXO_AfkMethod = ok and "Camera" or "FAILED"
        end
    end
    if ok then NEXO_AfkNudges = NEXO_AfkNudges + 1 end
    return ok
end

-- Fire the moment Roblox reports idling...
