-- Shared raid config. `difficulty` is the number sent as Difficulty in EVERY boss-island queue
-- below (StarRage/Blood/Lightning/Yuta + the extra raids), so the Raid-tab dropdown controls all
-- of them at once (Easy=1, Normal=2, Hard=3, Nightmare=4, Calamity=5). The Outer World raid has
-- no difficulty and is unaffected. `active` holds the on/off flag for each extra raid. Everything
-- lives in ONE table so we don't burn scarce main-chunk local registers (near Luau's 200 cap).
local RaidCfg = {
    difficulty = 5,
    map = { Easy = 1, Normal = 2, Hard = 3, Nightmare = 4, Calamity = 5 },
    active = {},
}
-- The boss's server name is RANDOM each spawn, so we can't match by model name. Instead we find
-- the CLIENT rig (all named "Default_Client") whose name-tag TextLabel says "Lv.1 Yuki", then
-- match the SERVER NPC closest to that rig -- that's the model we actually damage/teleport to.
local RAID_BOSS_TAG = "yuki" -- text on the boss's client name-tag (level prefix may change)
local function findRaidBoss()
    return findNearestTaggedBoss(RAID_BOSS_TAG) -- island-locked: only YOUR StarRage boss
end
STAR_PAD_LIFT = 3.5
function starRageTopPos(inst)
    -- Top surface of the pad, not its center: standing inside the part never registers you.
    if not inst then return nil end
    local part = inst
    if not inst:IsA("BasePart") then
        part = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
    end
    if not part then return nil end
    return part.Position + Vector3.new(0, (part.Size.Y / 2) + STAR_PAD_LIFT, 0)
end
local function findStarRageZone()
    local myPos
    pcall(function()
        local m = getModel()
        local h = m and m:FindFirstChild("HumanoidRootPart")
        if h then myPos = h.Position end
    end)
    local best, bestD
    local function consider(inst, bonus)
        local pos = starRageTopPos(inst)
        if not pos then return end
        local d = (myPos and (pos - myPos).Magnitude or 0) - bonus
        if not bestD or d < bestD then best, bestD = pos, d end
    end
    -- the real queue pad under QueueZones wins outright
    local qz = workspace:FindFirstChild("QueueZones")
    if qz then
        consider(qz:FindFirstChild("StarRage"), 100000)
        consider(qz:FindFirstChild("StarRageRaid"), 100000)
    end
    -- LIVE scan (the cached list goes stale after a rejoin) and prefer the NEAREST copy
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Model") or d:IsA("BasePart") then
            local n = string.lower(d.Name)
            if n == "starrage" or n == "starrageraid" then consider(d, 50000) end
        end
    end
    return best
end
-- Robustly "click" any visible TextButton whose text contains the keyword: fire EVERY handler on
-- all its click signals (Activated / MouseButton1Click / Down / Up) so it works no matter which
-- one the game connected to. firesignal(MouseButton1Click) alone often misses .Activated buttons.
local function clickPopup(keyword)
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false end
    local kw = string.lower(keyword)
    local clicked = false
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextButton") and d.Visible and string.find(string.lower(d.Text), kw, 1, true) then
            for _, sname in ipairs({"Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up"}) do
                pcall(function()
                    if getconnections then
                        for _, cn in ipairs(getconnections(d[sname])) do
                            pcall(function() cn:Fire() end)
                        end
                    end
                end)
            end
            pcall(function() firesignal(d.MouseButton1Click) end)
            clicked = true
        end
    end
    return clicked
end
