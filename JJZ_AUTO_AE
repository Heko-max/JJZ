-- QuestService.FetchedItem_Signal (the "collect" remote), resolved lazily and cached
NexoFetchedItem = nil
function NexoFetchRemote()
    if NexoFetchedItem then return NexoFetchedItem end
    pcall(function() NexoFetchedItem = Net.QuestService.FetchedItem_Signal end)
    if not NexoFetchedItem then
        pcall(function()
            NexoFetchedItem = game:GetService("ReplicatedStorage"):WaitForChild("NetworkComm")
                :WaitForChild("QuestService"):WaitForChild("FetchedItem_Signal")
        end)
    end
    return NexoFetchedItem
end

-- fire the collect signal `times` times (default 10)
function NexoFetchItem(id, times)
    local rem = NexoFetchRemote()
    if not rem then return end
    for _ = 1, (times or 10) do
        if getgenv().NexoHubSession ~= SESSION then return end
        pcall(function() rem:FireServer(id) end)
        task.wait(0.12)
    end
end

-- find a quest PART/MODEL by exact name anywhere in the workspace (cached until it despawns)
NexoPartCache = {}
function NexoFindPartPos(name)
    local obj = NexoPartCache[name]
    if not (obj and obj.Parent) then
        obj = nil
        pcall(function() obj = workspace:FindFirstChild(name, true) end)
        NexoPartCache[name] = obj
    end
    if not obj then return nil end
    local pos
    pcall(function()
        if obj:IsA("BasePart") then
            pos = obj.Position
        elseif obj:IsA("Model") then
            pos = obj:GetPivot().Position
        end
    end)
    return pos
end

-- every LIVE NPC within `radius` studs (used by INF Q1 "bring near 150 radius and kill all")
