-- HUD boss frame: Players.[Username].PlayerGui.HUD.Frame.ContentFrame.BossHP
-- [Username] is ALWAYS the local player's own name, never a hard-coded one.
function shadowRaidBossFrame()
    local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    -- 1) the exact path first: PlayerGui.HUD.Frame.ContentFrame.BossHP
    local hud = pg:FindFirstChild("HUD")
