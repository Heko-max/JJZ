function NexoForgeIngot(times)
    times = math.floor(tonumber(times) or 0)
    if times < 1 then return 0 end
    if SummerIngotBusy then return 0 end -- never stack two runs
    SummerIngotBusy = true
    SummerIngotDone = 0
    for _ = 1, times do
