-- EXACT shikigami names. A target must match one of these EXACTLY (after
-- trimming/collapsing spaces + lowercasing). "Nue", "Lv Nue" or "Lv.2 Nue"
-- are NOT matches -- only the exact strings below are ever attacked.
SHADOW_EXACT_NAMES = { "lv.1 bunny", "lv.1 kuro", "lv.1 nue", "lv.1 shiro", "lv.1 mahoraga" }
function shadowNorm(v)
    local t = string.lower(tostring(v or ""))
    t = string.gsub(t, "%s+", " ")
    t = string.gsub(t, "^ ", "")
    t = string.gsub(t, " $", "")
    return t
end
function shadowExact(text, names)
    if not text or not names then return false end
    local t = shadowNorm(text)
    if t == "" then return false end
    for _, n in ipairs(names) do
        if t == n then return true end
    end
    return false
end
-- HARD BLACKLIST: anything sitting inside a "Shikigami" folder (at ANY depth)
-- is another player's summon and can never be targeted by this tab.
function shadowInShikiFolder(m)
    if not m then return true end
    local bad = false
    pcall(function()
        if m:FindFirstAncestor(NEXO_PET_FOLDER) then bad = true return end
        local par = m.Parent
        while par do
            if par.Name == NEXO_PET_FOLDER then bad = true return end
            par = par.Parent
        end
    end)
    return bad
end

