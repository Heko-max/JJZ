--   A) the server model's own .Name
--   B) a TextLabel nameplate attached directly under the server model itself
--   C) a TextLabel nameplate in the separate client-side "Client" replica folder, matched to the
--      server model by proximity (cached ~0.2s so every NPC check stays cheap in tight loops)
IGNORED_NPC_NAMES = { "lv.1 punching bag", "punching bag" }
local function textMatchesIgnored(txt)
    local low = string.lower(txt)
    for _, ig in ipairs(IGNORED_NPC_NAMES) do
        if string.find(low, ig, 1, true) then return true end
    end
    return false
end
PunchingBagPosCache = { t = -1, list = {} }
