-- smooth, STABLE movement every frame (single per-frame Lerp = no shaking)
-- ANTI-LAG: the nearest NPC is scanned in the attack loop below (~33x/sec) and cached
-- here. This RenderStepped only reads the cache and teleports to the target's LIVE
-- position, so movement stays smooth at full FPS without scanning every single frame.
local killAuraTarget, killAuraHRP = nil, nil
CONNS[#CONNS+1] = RunService.RenderStepped:Connect(function(dt)
    if getgenv().NexoHubSession ~= SESSION then return end
    if not KillOn then return end
    if anyBringActive() then return end -- a bring is already holding the NPCs on you; don't ALSO tween onto them (the two fight for your position)
    if essenceBusy or crateBusy then return end -- yield to Auto CursedEssence / Auto Crate teleport
    local n, hrp = killAuraTarget, killAuraHRP
    if not (n and n.Parent and hrp and hrp.Parent) then return end
    local nh = n:FindFirstChild("HumanoidRootPart")
    if not nh then return end
    local goal = auraGoal(nh)
    pcall(function()
        -- ANTI-CHEAT: only re-teleport when we've actually DRIFTED off the spot. Snapping the CFrame
        -- every single frame (~60x/sec) is what trips the server's teleport detection -> it freezes
        -- you in one place, stops registering damage, and freezes the NPCs too. Re-snapping only on
        -- drift keeps you glued to the NPC without the flood. Attack speed is UNCHANGED.
        if (hrp.Position - goal.Position).Magnitude > STICK_OFFSET + 3 then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = goal -- instant teleport (no tween)
        end
    end)
end)

