-- SHARED RAID ISLAND-LOCK (used by StarRage / Blood / Lightning / Yuta + every
-- makeIslandRaid boss). Islands spawn far apart, so we lock onto YOUR boss by
-- (a) picking the matching name-tag NEAREST to you, (b) requiring it within
-- RAID_ISLAND_RADIUS studs, and (c) requiring it on your island. This stops any
-- raid from grabbing another player's boss on a neighbouring island.
RAID_ISLAND_RADIUS = 350 -- GLOBAL tunable island-lock radius (raise if YOUR boss is missed, lower if it grabs a neighbour's)
-- Instant pad teleport: re-resolves the character EVERY frame so it lands even mid-respawn.
-- Replaces the old "local chrp = hrp" pattern, where hrp was captured once outside the loop
-- and pointed at a destroyed part after any respawn (the pcall then swallowed the error).
function nexoPadHold(pos, frames)
    if not pos then return end
    for _ = 1, (frames or 6) do
        local m = getModel()
        local h = m and m:FindFirstChild("HumanoidRootPart")
        if h then
            pcall(function()
                h.AssemblyLinearVelocity = Vector3.zero
                h.CFrame = CFrame.new(pos)
            end)
        end
        task.wait()
    end
end
function findNearestTaggedBoss(tag)
    local ClientF = Characters:FindFirstChild("Client")
    if not ClientF then return nil end
    local myModel = getModel()
    local myHRP = myModel and myModel:FindFirstChild("HumanoidRootPart")
    local low = string.lower(tag)
    local bossPos, bestTagD
    for _, d in ipairs(clientDesc(ClientF)) do
        if d:IsA("TextLabel") and nexoTextMatchesWords(d.Text, nexoWordsOf(tag)) then
            local rig = d:FindFirstAncestorWhichIsA("Model")
            local h = rig and rig:FindFirstChild("HumanoidRootPart")
            if h then
                if myHRP then
                    -- ISLAND LOCK: nearest matching boss to YOU, within radius, on your island
                    local dd = (h.Position - myHRP.Position).Magnitude
                    if dd <= RAID_ISLAND_RADIUS and onMyIsland(h.Position)
                        and (not bestTagD or dd < bestTagD) then
                        bossPos, bestTagD = h.Position, dd
                    end
                elseif not bossPos then
                    bossPos = h.Position -- no character yet: fall back to first match
                end
            end
        end
    end
    if not bossPos then return nil end
    -- match the nearest live SERVER NPC to that client rig (the damageable boss model)
    if NPCsF then
        local best, bestD
        for _, m in ipairs(NPCsF:GetChildren()) do
            local h = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 and nexoValidNpc(m) then
                local dd = (h.Position - bossPos).Magnitude
                if dd < 25 and (not bestD or dd < bestD) then best, bestD = m, dd end
            end
        end
        if best then return best, best:FindFirstChild("HumanoidRootPart") end
    end
    return nil
end

-- Auto Farm StarRage Raid: queue the raid, TP into the StarRage zone part, smash the boss
-- (wo75ZpHa2g89_Server), then Retry to respawn it and repeat. If sent back to spawn (no boss,
-- no zone part), it re-queues from scratch.
local AutoRaidOn = false
local inRaid = false -- true while inside the boss room (stops it from TPing back to the zone part)
local CreateIslandQueue = Net.BossIslandService.CreateIslandQueue_Method
