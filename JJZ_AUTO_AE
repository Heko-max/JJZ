AutoLightningRaidOn = false
inLightningRaid = false
LIGHTNING_BOSS_TAG = "awakened lightning god" -- text on the boss's client name-tag (level prefix may change)
function findLightningBoss()
    return findNearestTaggedBoss(LIGHTNING_BOSS_TAG) -- island-locked: only YOUR Lightning God boss
end
function findLightningZone()
    local qz = workspace:FindFirstChild("QueueZones")
    local sr = qz and qz:FindFirstChild("AKashimo")
    if not sr then
        for _, d in ipairs(wsDesc()) do
            if d.Name == "AKashimo" and (d:IsA("Model") or d:IsA("BasePart")) then sr = d break end
        end
    end
    if not sr then return nil end
