--========================================================--
--  STAND-STILL TARGET LOCK  (shared by every quest kill loop)
--  OLD behaviour: the quest loops re-teleported you onto the nearest NPC EVERY tick, while
--  the bring loops kept pushing that NPC around -> you and the NPC shoved each other and
--  you slowly drifted further and further away from the quest area.
--  NEW behaviour: you TP onto ONE locked NPC exactly once, then you are PINNED to that saved
--  spot (you stand perfectly still while attacking). A new lock + a single new TP only happens
--  when that NPC dies, despawns, or travels further than NEXO_STICK_DROP studs.
--========================================================--
NEXO_STICK_DROP = 60   -- studs the locked NPC may move before you re-TP onto it
NexoAnchors = NexoAnchors or {}

function NexoDropAnchor(key)
    if key then NexoAnchors[key] = nil else NexoAnchors = {} end
end

function NexoStickTo(key, hrp, targetHRP)
    if not hrp then return false end
    local a = NexoAnchors[key]
    if a then
        local t, ok = a.tgt, true
        if not (t and t.Parent) then ok = false end
        if ok then
            local hum = t.Parent:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then ok = false end                                  -- target dead
            if ok and (t.Position - a.cf.Position).Magnitude > NEXO_STICK_DROP then ok = false end -- ran away
        end
        if not ok then a = nil NexoAnchors[key] = nil end
    end
    if not a then
        if not targetHRP then return false end
        a = { tgt = targetHRP, cf = auraGoal(targetHRP) } -- ONE teleport onto it, spot saved
        NexoAnchors[key] = a
    end
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = a.cf -- held on the saved spot: no chasing, no drifting
    end)
    return true
end

