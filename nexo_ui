function Library:SelectPage(name, back)

	local order = {}
	for i, navName in ipairs(TEXT.Nav) do order[navName] = i end

	local forward = true
	if back ~= nil then
		forward = not back
	elseif self.CurrentPage and order[name] and order[self.CurrentPage] then
		forward = order[name] >= order[self.CurrentPage]
	end

	for pageName, frame in pairs(self.PageFrames or {}) do
		if pageName == name then
			slideIn(frame, forward)
		else
			frame.Visible = false
		end
	end
	for label, btn in pairs(self.NavButtons or {}) do
		local selected = (label == name)
		playTween(btn, tweenInfo(0.18), { TextColor3 = selected and THEME.Accent or THEME.NavIdle }, "navText" .. label)
	end
	self.CurrentPage = name
end

