function UICOLOR.names()
	local out = {}
	for i, t in ipairs(UICOLOR.Targets) do out[i] = t.name end
	return out
end

function UICOLOR.find(name)
	for _, t in ipairs(UICOLOR.Targets) do
		if t.name == name then return t end
	end
	return UICOLOR.Targets[1]
end

function UICOLOR.near(a, b)
	if typeof(a) ~= "Color3" or typeof(b) ~= "Color3" then return false end
	return math.abs(a.R - b.R) < 0.006
		and math.abs(a.G - b.G) < 0.006
		and math.abs(a.B - b.B) < 0.006
end

function UICOLOR.remember(key, color)
	if typeof(color) ~= "Color3" then return end
	UICOLOR.Seen[key] = UICOLOR.Seen[key] or {}
	for _, c in ipairs(UICOLOR.Seen[key]) do
		if UICOLOR.near(c, color) then return end
	end
	table.insert(UICOLOR.Seen[key], color)
end

-- every colour these theme keys could be wearing in the ui right now
function UICOLOR.candidates(keys)
	local list = {}
	local function add(c)
		if typeof(c) ~= "Color3" then return end
		for _, x in ipairs(list) do
			if UICOLOR.near(x, c) then return end
		end
		list[#list + 1] = c
	end
	for _, key in ipairs(keys or {}) do
		add(THEME[key])
		add(UICOLOR.Base[key])
		for _, c in ipairs(UICOLOR.Seen[key] or {}) do add(c) end
	end
	return list
end

-- only the colour properties this instance really has
function UICOLOR.propsFor(inst)
	if inst:IsA("UIStroke") or inst:IsA("UIGradient") then
		return { "Color" }
	elseif inst:IsA("TextBox") then
		return { "BackgroundColor3", "TextColor3", "PlaceholderColor3", "TextStrokeColor3" }
	elseif inst:IsA("TextLabel") or inst:IsA("TextButton") then
		return { "BackgroundColor3", "TextColor3", "TextStrokeColor3" }
	elseif inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
		return { "BackgroundColor3", "ImageColor3" }
	elseif inst:IsA("ScrollingFrame") then
		return { "BackgroundColor3", "ScrollBarImageColor3" }
	elseif inst:IsA("GuiObject") then
		return { "BackgroundColor3" }
	end
	return nil
end

function UICOLOR.matchesName(inst, words, root)
	if not words then return true end
	local node = inst
	local hops = 0
	while node and hops < 14 do
		local n = tostring(node.Name):lower()
		for _, w in ipairs(words) do
			if n:find(tostring(w):lower(), 1, true) then return true end
		end
		if node == root then break end
		node = node.Parent
		hops = hops + 1
	end
	return false
end

function UICOLOR.matchesClass(inst, classes)
	if not classes then return true end
	for _, c in ipairs(classes) do
		if inst:IsA(c) then return true end
	end
	return false
end

-- repaint ONE instance: any colour that matches the old theme colour becomes
-- the new colour. gradients are rebuilt keypoint by keypoint.
function UICOLOR.paintOne(inst, props, pool, color)
	for _, prop in ipairs(props) do
		local ok, value = pcall(function() return inst[prop] end)
		if ok then
			if typeof(value) == "Color3" then
				for _, c in ipairs(pool) do
					if UICOLOR.near(value, c) then
						pcall(function() inst[prop] = color end)
						break
					end
				end
			elseif typeof(value) == "ColorSequence" then
				local points = {}
				local changed = false
				for _, kp in ipairs(value.Keypoints) do
					local newC = kp.Value
					for _, c in ipairs(pool) do
						if UICOLOR.near(kp.Value, c) then
							newC = color
							changed = true
							break
						end
					end
					points[#points + 1] = ColorSequenceKeypoint.new(kp.Time, newC)
				end
				if changed then
					pcall(function() inst[prop] = ColorSequence.new(points) end)
				end
			end
		end
	end
end

-- paint one PART of the ui in one colour
function UICOLOR.apply(lib, partName, color, remember)
	if typeof(color) ~= "Color3" then return end
	local target = UICOLOR.find(partName)
	local pool = UICOLOR.candidates(target.keys)

	-- a part with no filter at all is a GLOBAL part: the theme itself changes,
	-- so every control built later is born with the new colour
	local isGlobal = not (target.match or target.classes or target.props)
	for _, key in ipairs(target.keys) do
		UICOLOR.remember(key, THEME[key])
		UICOLOR.remember(key, color)
		if isGlobal then THEME[key] = color end
	end

	local root = lib and lib.Gui
	if root then
		for _, inst in ipairs(root:GetDescendants()) do
			if UICOLOR.matchesClass(inst, target.classes)
				and UICOLOR.matchesName(inst, target.match, root) then
				local props = target.props or UICOLOR.propsFor(inst)
				if props then
					UICOLOR.paintOne(inst, props, pool, color)
				end
			end
		end
	end

	-- the registered control outlines / control text keep their own list
	if isGlobal then
		pcall(function() refreshControlColors() end)
	end

	if remember ~= false then
		if UICOLOR.Applied[target.name] == nil then
			table.insert(UICOLOR.Order, target.name)
		end
		UICOLOR.Applied[target.name] = color
	end
end

-- REFRESH: paint every choice again, so tabs / controls that were built
-- after the colour was picked get it as well
function UICOLOR.reapply(lib)
	for _, name in ipairs(UICOLOR.Order) do
		local c = UICOLOR.Applied[name]
		if c then UICOLOR.apply(lib, name, c, false) end
	end
end

-- back to the colours the library shipped with (the red theme)
function UICOLOR.reset(lib)
	local jobs = {}
	for key, base in pairs(UICOLOR.Base) do
		jobs[#jobs + 1] = { pool = UICOLOR.candidates({ key }), base = base }
	end
	for key, base in pairs(UICOLOR.Base) do
		THEME[key] = base
	end

	local root = lib and lib.Gui
	if root then
		for _, inst in ipairs(root:GetDescendants()) do
			local props = UICOLOR.propsFor(inst)
			if props then
				for _, job in ipairs(jobs) do
					UICOLOR.paintOne(inst, props, job.pool, job.base)
				end
			end
		end
	end

	UICOLOR.Applied = {}
	UICOLOR.Order = {}
	pcall(function() refreshControlColors() end)
end

-- anything added later is repainted automatically (debounced)
function UICOLOR.watch(lib)
	if not lib or not lib.Gui or lib._colorWatch then return end
	lib._colorWatch = lib.Gui.DescendantAdded:Connect(function()
		if lib._colorQueued then return end
		lib._colorQueued = true
		task.delay(0.3, function()
			lib._colorQueued = false
			if lib.Destroyed then return end
			UICOLOR.reapply(lib)
		end)
	end)
end

--  PUBLIC COLOUR API  --------------------------------------------------
function Library:SetPartColor(part, color)
	UICOLOR.apply(self, part or "All (whole UI)", color)
	UICOLOR.watch(self)
	return self
end

function Library:RefreshColors()
	UICOLOR.reapply(self)
	return self
end

function Library:ResetColors()
	UICOLOR.reset(self)
	return self
end

function Library:GetColorParts()
	return UICOLOR.names()
end

--=====================================================
--  THE BUILT IN "UI" TAB  ->  section "UI Color"
--  a normal tab, built with the very same AddTab / AddSection /
--  control calls a hub script would use.
--=====================================================
local COLOR_PRESETS = {
	{ name = "Red (default)", color = Color3.fromRGB(255, 0, 0) },
	{ name = "Blue",          color = Color3.fromRGB(0, 132, 255) },
	{ name = "Cyan",          color = Color3.fromRGB(0, 220, 230) },
	{ name = "Green",         color = Color3.fromRGB(0, 220, 90) },
	{ name = "Lime",          color = Color3.fromRGB(150, 255, 0) },
	{ name = "Yellow",        color = Color3.fromRGB(255, 220, 0) },
	{ name = "Orange",        color = Color3.fromRGB(255, 130, 0) },
	{ name = "Pink",          color = Color3.fromRGB(255, 70, 190) },
	{ name = "Purple",        color = Color3.fromRGB(160, 60, 255) },
	{ name = "White",         color = Color3.fromRGB(255, 255, 255) },
	{ name = "Grey",          color = Color3.fromRGB(140, 140, 150) },
}

local function presetNames()
	local out = {}
	for i, p in ipairs(COLOR_PRESETS) do out[i] = p.name end
	return out
end

local function presetColor(name)
	for _, p in ipairs(COLOR_PRESETS) do
		if p.name == name then return p.color end
	end
	return nil
end

local function hexOf(c)
	return string.format("#%02X%02X%02X",
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5))
end

-- "#ff0000" / "ff0000" / "f00" / "255,0,0"  ->  Color3
local function parseColorText(txt)
	if type(txt) ~= "string" then return nil end
	local s = txt:gsub("%s", "")
	if s == "" then return nil end

	local r, g, b = s:match("^(%d+),(%d+),(%d+)$")
	if r then
		return Color3.fromRGB(
			math.clamp(tonumber(r) or 0, 0, 255),
			math.clamp(tonumber(g) or 0, 0, 255),
			math.clamp(tonumber(b) or 0, 0, 255))
	end

	s = s:gsub("^#", ""):gsub("^0x", "")
	if #s == 3 then
		s = s:sub(1, 1):rep(2) .. s:sub(2, 2):rep(2) .. s:sub(3, 3):rep(2)
	end
	if #s ~= 6 or s:match("%X") then return nil end
	return Color3.fromRGB(
		tonumber(s:sub(1, 2), 16),
		tonumber(s:sub(3, 4), 16),
		tonumber(s:sub(5, 6), 16))
end

function Library:_buildUiTab()
	if self.UiTab then return self.UiTab end
	local lib = self

	local tab = self:AddTab({
		title = "UI",
		desc  = "Recolour the hub - pick a part, pick any colour",
		image = IMAGES.TabIcon,
	})
	self.UiTab = tab

	local sec = tab:AddSection({
		title = "UI Color",
		desc  = "Picker, gradient, hex, RGB / HSV sliders and a part selector",
	})
	self.UiColorSection = sec

	local start = THEME.Accent
	local sh, ss, sv = Color3.toHSV(start)

	local state = {
		part  = UICOLOR.Targets[1].name,
		color = start,
		r = math.floor(start.R * 255 + 0.5),
		g = math.floor(start.G * 255 + 0.5),
		b = math.floor(start.B * 255 + 0.5),
		h = math.floor(sh * 360 + 0.5),
		s = math.floor(ss * 100 + 0.5),
		v = math.floor(sv * 100 + 0.5),
		lock = false,
	}

	local handles = {}

	local function setHandle(name, value)
		local h = handles[name]
		if h and h.Set then pcall(function() h:Set(value) end) end
	end

	local function statusText()
		return "NOW: " .. hexOf(state.color) .. "   PART: " .. state.part
	end

	-- push the chosen colour into every other control so they all agree
	local function sync(from)
		state.lock = true
		local c = state.color
		state.r = math.floor(c.R * 255 + 0.5)
		state.g = math.floor(c.G * 255 + 0.5)
		state.b = math.floor(c.B * 255 + 0.5)
		local h, s, v = Color3.toHSV(c)
		state.h = math.floor(h * 360 + 0.5)
		state.s = math.floor(s * 100 + 0.5)
		state.v = math.floor(v * 100 + 0.5)

		if from ~= "rgb" then
			setHandle("r", state.r)
			setHandle("g", state.g)
			setHandle("b", state.b)
		end
		if from ~= "hsv" then
			setHandle("h", state.h)
			setHandle("s", state.s)
			setHandle("v", state.v)
		end
		if from ~= "hex" then setHandle("hex", hexOf(c)) end
		if from ~= "picker" then setHandle("picker", c) end

		local st = handles.status
		if st and st.SetText then pcall(function() st:SetText(statusText()) end) end
		state.lock = false
	end

	local function applyNow()
		UICOLOR.apply(lib, state.part, state.color)
		UICOLOR.watch(lib)
		local st = handles.status
		if st and st.SetText then pcall(function() st:SetText(statusText()) end) end
	end

	local function setColor(c, from, apply)
		if typeof(c) ~= "Color3" then return end
		state.color = c
		sync(from)
		if apply ~= false then applyNow() end
	end

	--------------------------------------------------------------
	-- 1) what am I painting, and what does it look like right now
	--------------------------------------------------------------
	handles.status = sec:AddLabel({ text = statusText() })

	sec:AddDropdown({
		text = "WHICH PART TO PAINT",
		options = UICOLOR.names(),
		default = state.part,
		callback = function(v)
			state.part = tostring(v)
			sync("part")
		end,
	})

	sec:AddDropdown({
		text = "QUICK COLOUR",
		options = presetNames(),
		default = COLOR_PRESETS[1].name,
		callback = function(v)
			local c = presetColor(tostring(v))
			if c then setColor(c, "preset") end
		end,
	})

	--------------------------------------------------------------
	-- 2) the picker itself (gradient) + hex box
	--------------------------------------------------------------
	handles.picker = sec:AddColorPicker({
		text = "COLOUR PICKER",
		default = state.color,
		callback = function(c)
			if state.lock then return end
			setColor(c, "picker")
		end,
	})

	handles.hex = sec:AddTextbox({
		text = "HEX  /  R,G,B",
		placeholder = "#FF0000  or  255,0,0",
		default = hexOf(state.color),
		callback = function(txt)
			if state.lock then return end
			local c = parseColorText(txt)
			if c then
				setColor(c, "hex")
			else
				lib:Notify({ text = "That colour text is not valid. Use #FF0000 or 255,0,0", time = 4 })
				sync("none")
			end
		end,
	})

	--------------------------------------------------------------
	-- 3) advanced: RGB sliders and HSV sliders
	--------------------------------------------------------------
	local function rgbChanged()
		if state.lock then return end
		setColor(Color3.fromRGB(state.r, state.g, state.b), "rgb")
	end

	local function hsvChanged()
		if state.lock then return end
		setColor(Color3.fromHSV(
			math.clamp(state.h / 360, 0, 1),
			math.clamp(state.s / 100, 0, 1),
			math.clamp(state.v / 100, 0, 1)), "hsv")
	end

	handles.r = sec:AddSlider({ text = "RED", min = 0, max = 255, default = state.r, step = 1,
		callback = function(v) state.r = math.floor(tonumber(v) or 0) rgbChanged() end })
	handles.g = sec:AddSlider({ text = "GREEN", min = 0, max = 255, default = state.g, step = 1,
		callback = function(v) state.g = math.floor(tonumber(v) or 0) rgbChanged() end })
	handles.b = sec:AddSlider({ text = "BLUE", min = 0, max = 255, default = state.b, step = 1,
		callback = function(v) state.b = math.floor(tonumber(v) or 0) rgbChanged() end })

	handles.h = sec:AddSlider({ text = "HUE", min = 0, max = 360, default = state.h, step = 1, suffix = "\194\176",
		callback = function(v) state.h = math.floor(tonumber(v) or 0) hsvChanged() end })
	handles.s = sec:AddSlider({ text = "SATURATION", min = 0, max = 100, default = state.s, step = 1, suffix = "%",
		callback = function(v) state.s = math.floor(tonumber(v) or 0) hsvChanged() end })
	handles.v = sec:AddSlider({ text = "BRIGHTNESS", min = 0, max = 100, default = state.v, step = 1, suffix = "%",
		callback = function(v) state.v = math.floor(tonumber(v) or 0) hsvChanged() end })

	--------------------------------------------------------------
	-- 4) apply / refresh / reset
	--------------------------------------------------------------
	sec:AddButton({
		text = "APPLY COLOUR",
		callback = function() applyNow() end,
	})

	sec:AddButton({
		text = "REFRESH COLOR",
		-- REFRESH COLOR: one click puts EVERY colour of the whole ui back to
		-- the default theme the script ships with (the original red), no
		-- matter how many parts were repainted.
		callback = function()
			UICOLOR.reset(lib)
			state.part = UICOLOR.Targets[1].name
			state.color = THEME.Accent
			sync("reset")
			pcall(function()
				lib:Notify({ text = "All colours refreshed back to default", time = 3 })
			end)
		end,
	})

	sec:AddButton({
		text = "RE-APPLY MY COLOURS",
		-- paint the colours you picked over anything that was built after
		-- you picked them (new tabs, new sections, new controls).
		callback = function()
			UICOLOR.reapply(lib)
			UICOLOR.watch(lib)
			sync("refresh")
		end,
	})

	sec:AddInfoButton({
		text = "HOW TO USE",
		title = "UI COLOR",
		info = table.concat({
			"1) pick WHICH PART TO PAINT. **All (whole UI)** paints everything,",
		"   or choose only Buttons, Outlines, Sliders, Text, Nav bar ...",
			"2) pick the colour with the PICKER, a QUICK COLOUR, the HEX box",
			"   or the RGB / HSV sliders. it is applied straight away.",
			"3) REFRESH COLOR puts EVERY colour back to the script default",
			"   theme (the original red) in one click.",
			"4) RE-APPLY MY COLOURS paints your own colours over tabs and",
			"   controls that were built after you picked them.",
		}, "\n"),
	})

	sync("init")
	return tab
end

--=====================================================
--  PUBLIC ENTRY POINT (this is what loadstring returns)
--=====================================================
local NexoHub = {}
NexoHub.Library = Library
NexoHub.Version = "1.0"

-- NexoHub:CreateWindow({ ... }) builds the window and hands you the ui object.
-- every option is optional.
function NexoHub:CreateWindow(opts)
	opts = opts or {}
	local ui = Library.new()

	-- DEFAULT "UI" TAB: the built in colour tab. It is a completely normal
	-- tab (AddTab / AddSection / controls), added before the hub's own tabs.
	-- Turn it off with DEFAULT_UI_TAB = false, or CreateWindow({ uiTab = false }).
	if DEFAULT_UI_TAB and opts.uiTab ~= false then
		pcall(function() ui:_buildUiTab() end)
	end

	if opts.welcome  then pcall(function() ui:SetText("Welcome", opts.welcome) end) end
	if opts.subtitle then pcall(function() ui:SetText("Subtitle", opts.subtitle) end) end
	if opts.credits  then pcall(function() ui:SetText("Credits", opts.credits) end) end

	if opts.background then pcall(function() ui:SetImage("Background", opts.background) end) end
	if opts.logo       then pcall(function() ui:SetImage("Logo", opts.logo) end) end
	if opts.banner     then pcall(function() ui:SetImage("Banner", opts.banner) end) end

	if opts.folder then ui:SetFolder(opts.folder) end
	if opts.accent then ui:SetAccent(opts.accent) end

	ui:SetToggleKey(opts.toggleKey or "RightShift")

	if opts.autoload then
		task.defer(function() ui:LoadAutoload(true) end)
	end

	NexoHub.Window = ui
	return ui
end

-- short alias: NexoHub.new({ ... })
function NexoHub.new(opts)
	return NexoHub:CreateWindow(opts)
end

--=====================================================
--  IMAGE HELPERS (roblox ids + website links)
--=====================================================
-- the whole loader, if you want to use it yourself
NexoHub.Images = IMG

-- true when this executor can download website images.
-- roblox ids always work, links only work when this is true.
NexoHub.CanUseImageLinks = IMG.canDownload

-- turn any input into a content id without touching the ui.
-- ids return instantly, links download first, so call it in a task.spawn.
function NexoHub:ResolveImage(input)
	return IMG.get(input)
end

-- point any ImageLabel / ImageButton at an id OR a link
function NexoHub:ApplyImage(instance, input, prop)
	IMG.set(instance, prop or "Image", input)
	return instance
end

-- download links ahead of time so they appear with no delay
function NexoHub:PreloadImages(list, onDone)
	IMG.preload(list, onDone)
	return self
end

-- wipe the on disk image cache (forces links to download again)
function NexoHub:ClearImageCache()
	return IMG.clearCache()
end

return NexoHub
