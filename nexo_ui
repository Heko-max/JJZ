			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})

		local function channelValue()
			local c = THEME[themeKey]
			local v = (channel == "R" and c.R) or (channel == "G" and c.G) or c.B
			return math.floor(v * 255 + 0.5)
		end

