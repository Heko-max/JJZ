		local baseSize = TAB_TITLE_SIZE
		local minSize  = math.min(baseSize, LAYOUT.TabTitleMin or 24)
		local stepDown = LAYOUT.TabTitleStep or 0.86
		local lineMul  = LAYOUT.TabTitleLine or 1.25
		local maxLines = math.max(1, LAYOUT.TabTitleLines or 2)
		local busy = false

		local function fitTitle()
			if busy then return end
			if title.AbsoluteSize.X <= 0 then return end
			busy = true

			local size = baseSize
			title.TextSize = size

			for _ = 1, 60 do
				local high = title.TextBounds.Y
				local rows = math.max(1, math.floor(high / math.max(1, size * lineMul) + 0.5))
				local want = math.max(minSize, math.floor(baseSize * (stepDown ^ (rows - 1)) + 0.5))

				if size > want then
					size = want
				elseif rows > maxLines or high > math.ceil(size * lineMul * maxLines) then
					size = size - 1
				else
					break
				end

				if size <= minSize then
					size = minSize
					title.TextSize = size
					break
				end

				title.TextSize = size
			end

			titleCap.MaxSize = Vector2.new(math.huge, math.ceil(size * lineMul * maxLines))
			busy = false
		end

		local function fitSoon()
			if busy then return end
			task.defer(fitTitle)
		end

		title:GetPropertyChangedSignal("Text"):Connect(fitSoon)
