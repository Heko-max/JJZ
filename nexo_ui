function Library:AddHomeTab(info)
	info = info or {}

	if #self.HomeTabs >= MAX_HOME_TABS then
		warn("[NEXO HUB] the front page holds " .. MAX_HOME_TABS .. " tabs only")
		return nil
	end

	local index = #self.HomeTabs + 1

	-- THE CARD. Same design as the reference hub: a dark translucent slab
	-- with a red gradient body, a gradient outline, the logo on the right
	-- under a red gradient, and the title / desc scaled on the left.
	local card = new("Frame", {
		Name = "HomeTab" .. index,
		LayoutOrder = index,
		Size = HOME_CARD_SIZE, -- kept in step by _resizeHomeTabs
		BackgroundColor3 = Color3.fromRGB(20, 20, 20),
