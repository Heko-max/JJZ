function Library:_aiNorm(text)
	local s = tostring(text or ""):lower()
	s = s:gsub("<[^>]->", " ")
	s = s:gsub("[^%w]+", " ")
	s = " " .. s .. " "
	s = s:gsub(" lvl ", " level ")
	s = s:gsub(" lvls ", " level ")
	s = s:gsub(" lv ", " level ")
	s = s:gsub(" autofarm ", " auto farm ")
	return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

function Library:_aiClean(text)
	local out = {}
	for word in tostring(text or ""):gmatch("%S+") do
		if not Library.AiStop[word] then out[#out + 1] = word end
	end
	return table.concat(out, " ")
end

function Library:_aiGrams(text)
	local g = {}
	local s = tostring(text or ""):gsub("%s+", "")
	for i = 1, #s - 1 do
		local key = s:sub(i, i + 1)
		g[key] = (g[key] or 0) + 1
	end
	return g
end

function Library:_aiScore(query, name)
	if query == "" or name == "" then return 0 end
	if query == name then return 1 end

	local direct = 0
	if name:find(query, 1, true) or query:find(name, 1, true) then direct = 0.8 end

	local a = self:_aiGrams(query)
	local b = self:_aiGrams(name)
	local total, hit = 0, 0
	for _, v in pairs(a) do total = total + v end
	for key, v in pairs(b) do
		total = total + v
		local av = a[key]
		if av then hit = hit + math.min(av, v) end
	end
	local dice = 0
	if total > 0 then dice = (2 * hit) / total end

	local count, words = 0, 0
	local padded = " " .. name .. " "
	for word in query:gmatch("%S+") do
		count = count + 1
		if padded:find(" " .. word, 1, true) then words = words + 1 end
	end
	local wordScore = 0
	if count > 0 then wordScore = words / count end

	local mix = dice * 0.55 + wordScore * 0.6
	if mix > 1 then mix = 1 end
	if direct > mix then return direct end
	return mix
end

function Library:_aiPick(list)
	if not list or #list == 0 then return "" end
	return list[math.random(1, #list)]
end

function Library:_aiRegister(card, name, kind)
	if not card or not name then return end
	local text = tostring(name)
	if text == "" then return end
	card.AiItems = card.AiItems or {}
	card.AiItems[#card.AiItems + 1] = { name = text, kind = kind or "Control" }
