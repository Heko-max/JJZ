function Library:_aiEntries()
	local out = {}
	local root = Library.AiCfg.Root or "Pages"

	for _, tab in ipairs(self.Tabs or {}) do
		local tname = "Tab"
		pcall(function() tname = tab.Title.Text end)
		local tpath = root .. " \u{2192} " .. tname .. " (Tab)"
		out[#out + 1] = { name = tname, kind = "Tab", path = tpath }

		for _, sec in ipairs(tab.Sections or {}) do
			local sname = "Section"
			pcall(function() sname = sec.Title.Text end)
			local spath = tpath .. " \u{2192} " .. sname .. " (Section)"
			out[#out + 1] = { name = sname, kind = "Section", path = spath }

			for _, item in ipairs(sec.AiItems or {}) do
				out[#out + 1] = {
					name = item.name,
					kind = item.kind,
					path = spath .. " \u{2192} " .. item.name,
				}
			end
		end
	end

	return out
end

function Library:_aiBlocked(query)
	local padded = " " .. query .. " "
	for _, word in ipairs(Library.AiBad) do
		if padded:find(" " .. word .. " ", 1, true) then return true end
	end
	return false
end

function Library:LoadAiReplies(url)
	url = tostring(url or Library.AiCfg.RepliesUrl or "")
	if url == "" then return false, "no url" end

	local body
	local ok = pcall(function()
		local fetch = (syn and syn.request) or (http and http.request) or request or http_request
		if fetch then
			local res = fetch({ Url = url, Method = "GET" })
			body = res and (res.Body or res.body)
		else
			body = game:HttpGet(url)
		end
	end)
	if not ok or not body or body == "" then return false, "download failed" end

	local data
	if body:sub(1, 1) == "{" or body:sub(1, 1) == "[" then
		pcall(function()
			data = game:GetService("HttpService"):JSONDecode(body)
		end)
	else
		local loader = loadstring or load
		if loader then
			local fn = loader(body)
			if fn then pcall(function() data = fn() end) end
		end
	end

	local entries = data and (data.entries or data) or nil
	if type(entries) ~= "table" or #entries == 0 then return false, "bad file" end

	local pack = { list = entries, map = {}, index = {} }
	for i, item in ipairs(entries) do
		local question = item.q or item.question or item[1]
		local answer = item.a or item.answer or item[2]
		if question and answer then
			local key = self:_aiNorm(question)
			pack.map[key] = answer
			for word in key:gmatch("%S+") do
				if not Library.AiStop[word] then
					local bucket = pack.index[word]
					if not bucket then
						bucket = {}
						pack.index[word] = bucket
					end
					if #bucket < 500 then bucket[#bucket + 1] = i end
				end
			end
		end
	end

	self.AiPack = pack
	return true, #entries
end

function Library:_aiPackReply(query)
	local pack = self.AiPack
	if not pack then return nil end

	local direct = pack.map[query]
	if direct then return direct end

	local seen, best, bestScore = {}, nil, 0
	for word in query:gmatch("%S+") do
		local bucket = pack.index[word]
		if bucket then
			for _, idx in ipairs(bucket) do
				if not seen[idx] then
					seen[idx] = true
					local item = pack.list[idx]
					local question = item.q or item.question or item[1]
					local score = self:_aiScore(query, self:_aiNorm(question))
					if score > bestScore then
						bestScore = score
						best = item.a or item.answer or item[2]
					end
				end
			end
		end
	end

	if best and bestScore >= 0.45 then return best end
	return nil
end

function Library:AiAnswer(text)
	local q = self:_aiNorm(text)
	if q == "" then
		return "Mm? Type something for me and I will do my best~"
	end

	if self:_aiBlocked(q) then
		return self:_aiPick(Library.AiRefuse)
	end

	local padded = " " .. q .. " "
	for _, talk in ipairs(Library.AiTalk) do
		for _, word in ipairs(talk.words) do
			if padded:find(" " .. word .. " ", 1, true) then
				return talk.reply
			end
		end
	end

	local wantsPath = false
	for word in q:gmatch("%S+") do
		if Library.AiFind[word] then wantsPath = true end
	end

	local clean = self:_aiClean(q)
	if clean == "" then clean = q end

	local list = {}
	for _, entry in ipairs(self:_aiEntries()) do
		list[#list + 1] = { entry = entry, score = self:_aiScore(clean, self:_aiNorm(entry.name)) }
	end
	table.sort(list, function(a, b) return a.score > b.score end)

	local top = list[1]
	local need = wantsPath and (Library.AiCfg.MinScore or 0.34) or (Library.AiCfg.AskScore or 0.5)

	if top and top.score >= need then
		local reply = self:_aiPick(Library.AiLead) .. "\n" .. top.entry.path
		local extra = {}
		for i = 2, math.min(4, #list) do
			local item = list[i]
			if item.score >= (Library.AiCfg.MinScore or 0.34) and item.score >= top.score - 0.18 then
				extra[#extra + 1] = item.entry.path
			end
		end
		if #extra > 0 then
			reply = reply .. "\n\nThese are close too:\n" .. table.concat(extra, "\n")
		end
		return reply .. "\n\n" .. self:_aiPick(Library.AiTail)
	end

	local packReply = self:_aiPackReply(q)
	if packReply then return packReply end

	if wantsPath then return self:_aiPick(Library.AiMiss) end

	return "Ehe~ I am not sure about that one yet. You can ask me where a feature is, or just chat with me about anything nice!"
end

function Library:_aiImage(inst, url, fallback)
	if not inst then return end
	if fallback and fallback ~= "" then
		pcall(function() inst.Image = img(fallback) end)
	end
	local clean = tostring(url or "")
	if clean == "" then return end
	if not IMG.isUrl(clean) then
		pcall(function() inst.Image = img(clean) end)
		return
	end
	task.spawn(function()
		pcall(function()
			IMG.set(inst, "Image", clean, function(done)
				if not done and fallback and fallback ~= "" then
					pcall(function() inst.Image = img(fallback) end)
				end
			end)
		end)
	end)
end

