function Library:StatusSet(text, on)
	if type(text) ~= "string" or text == "" then return self end
	local st = self:_buildStatusWindow()
	if not st then return self end

	local key = string.upper(text)
	if on then
		local have = st.Rows[key]
		if have and have.Frame and have.Frame.Parent then
			have.Label.Text = text
		else
			local row, label = self:_statusRow(text)
			st.Order[#st.Order + 1] = key
			row.LayoutOrder = #st.Order
			st.Rows[key] = { Frame = row, Label = label }
		end
	else
		local have = st.Rows[key]
		if have then
			if have.Frame then have.Frame:Destroy() end
			st.Rows[key] = nil
			for i, k in ipairs(st.Order) do
				if k == key then
					table.remove(st.Order, i)
					break
				end
			end
		end
	end

	st.Empty.Visible = (next(st.Rows) == nil)
	return self
end

function Library:StatusAdd(text)    return self:StatusSet(text, true)  end
function Library:StatusRemove(text) return self:StatusSet(text, false) end

function Library:SetStatusTitle(text)
	Library.StatusCfg.Title = tostring(text or Library.StatusCfg.Title)
	local st = self:_buildStatusWindow()
	if st then st.Title.Text = Library.StatusCfg.Title end
	return self
end

function Library:ShowStatus(state)
	local st = self:_buildStatusWindow()
	if st then st.Root.Visible = (state ~= false) end
	return self
end

function Library:ToggleStatus()
	local st = self:_buildStatusWindow()
	if st then st.Root.Visible = not st.Root.Visible end
	return self
end

function Library:ClearStatus()
	local st = self.Status
	if not st then return self end
	for key, item in pairs(st.Rows) do
		if item.Frame then item.Frame:Destroy() end
		st.Rows[key] = nil
	end
	st.Order = {}
	st.Empty.Visible = true
	return self
end

