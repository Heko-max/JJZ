	pcall(function() F.GroupTransparency = 0 end)

	local statusFit = Instance.new("UISizeConstraint")
	statusFit.MinSize = Vector2.new(165, 0)
	statusFit.MaxSize = Vector2.new(340, math.huge)
	statusFit.Parent = F

	local function fitStatus()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local vp = cam.ViewportSize
		local phone = vp.X < 780
		local h = math.clamp(math.floor(vp.Y * (phone and 0.46 or 0.36)), 150, CFG.Height)
		F.Size = UDim2.new(phone and 0.40 or CFG.WidthScale, 0, 0, h)
		statusFit.MaxSize = Vector2.new(phone and 250 or 340, math.huge)
		local px, py = F.AbsolutePosition.X, F.AbsolutePosition.Y
		if px < -10 or py < 0 or px > vp.X - 50 or py > vp.Y - 50 then
			F.Position = UDim2.new(0, math.floor(F.AbsoluteSize.X * 0.5) + 14, 0.5, 0)
		end
	end

	self.StatusFit = fitStatus
	task.defer(fitStatus)
	pcall(function()
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitStatus)
	end)

