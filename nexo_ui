local function httpGet(url)
	if httpRequest then
		local ok, response = pcall(httpRequest, { Url = url, Method = "GET", Headers = {
				["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
			}, })
		if ok and type(response) == "table" and response.Body then return response.Body end
	end
	local ok, body = pcall(function() return game:HttpGet(url, true) end)
	if ok then return body end
	return nil
end

local function rangeGet(url, span)
	if not httpRequest then return nil end
	local ok, response = pcall(httpRequest, { Url = url, Method = "GET", Headers = {
			["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
			["Range"] = "bytes=0-" .. span,
		}, })
	if ok and type(response) == "table" and type(response.Body) == "string" then return response.Body end
	return nil
end

local function digest(text)
	local value = 5381
	for index = 1, #text do value = (value * 33 + text:byte(index)) % 4294967296 end
	return tostring(value)
end

local function sniff(body)
	if not body or #body < 12 then return nil, "File is too small to be an image" end
	local head = body:sub(1, 16)
	if head:sub(1, 8) == "\137PNG\r\n\26\n" then return "png" end
	if head:sub(1, 3) == "\255\216\255" then return "jpg" end
	if head:sub(1, 6) == "GIF89a" or head:sub(1, 6) == "GIF87a" then return "gif" end
	if head:sub(1, 4) == "RIFF" and head:sub(9, 12) == "WEBP" then return "webp" end
	if head:sub(1, 2) == "BM" then return "bmp" end
	if head:sub(1, 4) == "\0\0\1\0" then return "ico" end
	if head:sub(1, 4) == "\26\69\223\163" then return nil, "WebM video is not an image" end
	if body:sub(5, 8) == "ftyp" then return nil, "MP4 video is not an image" end
	return nil, "Unrecognized image format"
end

local function toAsset(path)
	local ok, id = pcall(getAsset, path)
	if ok and id then return id end
	ok, id = pcall(getAsset, path, true)
	if ok and id then return id end
	return nil
end

local function normalize(url)
	url = tostring(url or "")
	url = url:gsub("^%s+", "")
	url = url:gsub("%s+$", "")
	url = url:gsub("^http://", "https://")
	return url
end

local function directImage(url)
	local path = url:match("^[^?#]+") or url
	local ext = path:match("%.(%w+)$")
	if not ext then return false end
	ext = ext:lower()
	return ext == "png" or ext == "jpg" or ext == "jpeg" or ext == "gif"
		or ext == "webp" or ext == "bmp" or ext == "ico"
end
local VIDEO_EXT = { mp4 = true, m4v = true, mov = true, webm = true, mkv = true, avi = true, ogv = true, flv = true,
	m3u8 = true, mpd = true, ts = true, wmv = true, mpg = true, mpeg = true, gifv = true, }
local VIDEO_HOST = { "x%.com/[%w_%.]+/status/%d+", "twitter%.com/[%w_%.]+/status/%d+", "youtube%.com/watch",
	"youtu%.be/", "youtube%.com/shorts", "vimeo%.com/%d+", "streamable%.com/", "tiktok%.com/", "dailymotion%.com/video",
	"twitch%.tv/videos", "teachertube%.com/video", "facebook%.com/watch", "reddit%.com/r/[%w_]+/comments", }

local function videoLink(url)
	local path = url:match("^[^?#]+") or url
	local ext = path:match("%.(%w+)$")
	if ext and VIDEO_EXT[ext:lower()] then return true end
	local low = url:lower()
	for _, pattern in ipairs(VIDEO_HOST) do if low:match(pattern) then return true end end
	return false
end

local function directVideo(url)
	local path = url:match("^[^?#]+") or url
	local ext = path:match("%.(%w+)$")
	if ext and VIDEO_EXT[ext:lower()] then return true end
	return false
end

local function gifTwin(url)
	local imgur = url:match("^https://i%.imgur%.com/([%w]+)%.%w+$") or url:match("^https://imgur%.com/([%w]+)%.gifv?$")
	if imgur then return "https://i.imgur.com/" .. imgur .. ".gif" end
	local giphy = url:match("giphy%.com/media/([%w_%-]+)/")
	if giphy then return "https://media.giphy.com/media/" .. giphy .. "/giphy.gif" end
	local tenor = url:match("^(https://media[%w%.%-]*%.tenor%.com/[%w_%-]+/[^/%.]+)%.%w+$")
	if tenor then return tenor .. ".gif" end
	return nil
end

local function stillFor(url)
	local imgur = url:match("^https://i%.imgur%.com/([%w]+)%.%w+$") or url:match("^https://imgur%.com/([%w]+)%.gifv?$")
	if imgur then return "https://i.imgur.com/" .. imgur .. ".jpg" end
	local low = url:lower()
	local tube = low:match("youtube%.com/watch%?v=([%w_%-]+)") or low:match("youtu%.be/([%w_%-]+)")
		or low:match("youtube%.com/shorts/([%w_%-]+)")
	if tube then return "https://i.ytimg.com/vi/" .. tube .. "/hqdefault.jpg" end
	local streamable = low:match("streamable%.com/([%w]+)")
	if streamable then return "https://cdn-cf-east.streamable.com/image/" .. streamable .. ".jpg" end
	return nil
end

local function tweetPoster(url)
	local low = url:lower()
	local id = low:match("x%.com/[%w_%.]+/status/(%d+)") or low:match("twitter%.com/[%w_%.]+/status/(%d+)")
	if not id then return nil end
	local user = url:match("com/([%w_%.]+)/status/%d+") or "i"
	local slash = string.char(92)
	local probes = { "https://api.fxtwitter.com/" .. user .. "/status/" .. id,
		"https://api.fxtwitter.com/status/" .. id, "https://api.vxtwitter.com/" .. user .. "/status/" .. id, }
	for _, probe in ipairs(probes) do
		local body = httpGet(probe)
		if type(body) == "string" and #body > 40 then
			local shot = body:match('"thumbnail_url"%s*:%s*"([^"]+)"')
				or body:match('"poster"%s*:%s*"([^"]+)"')
				or body:match('"preview_image"%s*:%s*"([^"]+)"')
			if shot then return (shot:gsub(slash .. "/", "/")) end
		end
	end
	return nil
end

local function pageImage(url)
	local html = httpGet(url)
	if type(html) ~= "string" or #html < 50 then return nil end
	local found = html:match([==[<meta%s+property=["']og:image["']%s+content=["']([^"']+)["']]==])
		or html:match([==[<meta%s+property=["']og:image:secure_url["']%s+content=["']([^"']+)["']]==])
		or html:match([==[<meta%s+name=["']twitter:image["']%s+content=["']([^"']+)["']]==])
		or html:match([==[<meta%s+content=["']([^"']+)["']%s+property=["']og:image["']]==])
	if found then
		local clean = found:gsub("&amp;", "&")
		return clean
	end
	return nil
end

local function cachePaths(name, ext)
	return { APP.cacheDir .. "/" .. name .. "." .. ext, name .. "." .. ext }
end

local function fetchImage(url)
	if not Loader.fileReady then return nil, "No file access in this environment" end
	local name = digest(url)
	for _, ext in ipairs(IMAGE_EXT) do
		for _, path in ipairs(cachePaths(name, ext)) do
			if isfile(path) then
				local id = toAsset(path)
				if id then return id, ext end
			end
		end
	end
	local body = httpGet(url)
	if type(body) ~= "string" or #body < 32 then return nil, "Download failed or empty response" end
	local head = body:sub(1, 200):lower()
	if head:find("<!doctype") or head:find("<html") then return nil, "Host returned a web page, link is blocked" end
	local ext, err = sniff(body)
	if not ext then return nil, err end
	if ext == "gif" then Loader.bodies[url] = body end
	for _, path in ipairs(cachePaths(name, ext)) do
		if pcall(writefile, path, body) then
			local id = toAsset(path)
			if id then return id, ext end
		end
	end
	return nil, "Cache write was rejected"
end
Loader.posters = {}

function Loader.resolve(rawUrl)
	local url = normalize(rawUrl)
	if url == "" then return nil, "No link provided" end
	local native = url:match("^rbxvideo://(%d+)$") or url:match("^rbxassetid://(%d+)#video$") or url:match("^(%d+)#video$")
	if native then
		Loader.assets[url] = { "rbxassetid://" .. native, "video", url }
		return "rbxassetid://" .. native, "video"
	end
	if videoLink(url) then
		local cachedVideo = Loader.assets[url]
		if cachedVideo then return cachedVideo[1], cachedVideo[2] end
		local twin = gifTwin(url)
		if twin then
			local twinId, twinExt = fetchImage(twin)
			if twinId and twinExt == "gif" then
				Loader.assets[url] = { twinId, "gif", twin }
				return twinId, "gif"
			end
		end
		local poster = Loader.posters[url]
		if poster == nil then
			poster = stillFor(url) or tweetPoster(url)
			if not poster and not directVideo(url) then poster = pageImage(url) end
			Loader.posters[url] = poster or false
		end
		local shot = nil
		if poster then shot = fetchImage(poster) end
		Loader.assets[url] = { shot or "", "video", url }
		return shot or "", "video"
	end
	if url:match("^rbxassetid://%d+$") or url:match("^rbxasset://") or url:match("^rbxthumb://") then return url, "rbx" end
	if url:match("^%d+$") then return "rbxassetid://" .. url, "rbx" end
	if not url:match("^https?://") then return nil, "Link must start with http or https" end
	local cached = Loader.assets[url]
	if cached then return cached[1], cached[2] end
	local target = url
	if not directImage(target) then
		local found = pageImage(target)
		if found then target = normalize(found) end
	end
	local id, info = fetchImage(target)
	if not id then return nil, info end
	Loader.assets[url] = { id, info, target }
	return id, info
end

function Loader.bytes(url)
	local key = normalize(url)
	if Loader.bodies[key] then return Loader.bodies[key] end
	local cached = Loader.assets[key]
	local target = (cached and cached[3]) or key
	if Loader.bodies[target] then return Loader.bodies[target] end
	if isfile and readfile then
		local name = digest(target)
		for _, ext in ipairs(IMAGE_EXT) do
			for _, path in ipairs(cachePaths(name, ext)) do
				if isfile(path) then
					local ok, body = pcall(readfile, path)
					if ok and type(body) == "string" and #body > 32 then
						Loader.bodies[key] = body
						return body
					end
				end
			end
		end
	end
	local body = httpGet(target)
	if type(body) == "string" and #body > 32 then
		Loader.bodies[key] = body
		return body
	end
	return nil
end

local function pump()
	while Loader.active < APP.concurrency and #Loader.queue > 0 do
		local job = table.remove(Loader.queue, 1)
		Loader.active = Loader.active + 1
		task.spawn(function()
			local id, info = Loader.resolve(job.url)
			Loader.active = Loader.active - 1
			task.spawn(job.done, id, info)
			pump()
		end)
	end
end

function Loader.request(url, done)
	table.insert(Loader.queue, { url = url, done = done })
	pump()
end

function Loader.forget(url)
	local key = normalize(url)
	Loader.assets[key] = nil
	if not (isfile and delfile) then return false end
	local name = digest(key)
	local removed = false
	for _, ext in ipairs(IMAGE_EXT) do
		for _, path in ipairs(cachePaths(name, ext)) do if isfile(path) and pcall(delfile, path) then removed = true end end
	end
	return removed
end
