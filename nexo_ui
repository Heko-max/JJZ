-- TAB CARD GEOMETRY (Pages page)
-- The tabs keep the original "columns + gaps fill the row exactly" math.
-- Slimming is done on the ROW, not on each card, so the middle gap can
-- never grow. Heights are never touched.

-- how far EACH OUTER SIDE of the tab row is pulled in by TabWidthScale.
-- the row keeps its normal inner math, so the middle gap between two
-- tabs stays exactly TabGap and never opens up.
local function tabRowInset()
	local sc = math.clamp(LAYOUT.TabWidthScale or 1, 0.4, 1)
	return (1 - sc) / 2
end

-- NOTE: rowSidePadding() lives further down, right after the `padding`
-- helper, because it needs `new` and `new` is not created until later.

-- ORIGINAL column math: columns + gaps fill the row content exactly.
local function tabCardGeom(cols, col)
	return UDim2.new((col - 1) / cols, (col - 1) * LAYOUT.TabGap / cols, 0, 0),
		UDim2.new(1 / cols, -LAYOUT.TabGap * (cols - 1) / cols, 1, 0)
end


