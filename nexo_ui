		pcall(function() probe:Destroy() end)
	end

	local F = new(CLASS, {
		Name = "STATUS_FRAME",
		Size = UDim2.new(CFG.WidthScale, 0, 0, CFG.Height),
		Position = UDim2.new(CFG.PosXScale, CFG.PosXOffset, CFG.PosYScale, CFG.PosYOffset),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = CFG.PanelFade,
		BorderSizePixel = 0,
