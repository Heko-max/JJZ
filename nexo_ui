local function nexoFont(inst, weight)
	weight = weight or "Regular"
	local ok = pcall(function()
		inst.FontFace = Font.new(NEXO_SANS, Enum.FontWeight[weight])
	end)
	if not ok then
		pcall(function() inst.Font = NEXO_FALLBACK[weight] or Enum.Font.SourceSans end)
	end
end

local function nexoStops(parent, cols, rot, transparency)
	local ks = {}
	for _, c in ipairs(cols) do
		ks[#ks + 1] = ColorSequenceKeypoint.new(c[1], Color3.fromRGB(c[2], c[3], c[4]))
	end
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(ks)
	g.Rotation = rot or 0
	if transparency then
		g.Transparency = NumberSequence.new(transparency)
	end
	g.Parent = parent
	return g
end

local function nexoStroke(parent, thickness, cols, rot)
	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(255, 255, 255)
	s.Thickness = thickness
	s.Transparency = 0
	s.Parent = parent
	if cols then nexoStops(s, cols, rot) end
	return s
end

local function selectorTextGlow(parent, color, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.fromRGB(255, 255, 255)
	s.Thickness = 1.35
	s.Transparency = transparency or 0.35
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Parent = parent
	return s
end

local function nexoSeq(cols)
	local ks = {}
	for _, c in ipairs(cols) do
		ks[#ks + 1] = ColorSequenceKeypoint.new(c[1], Color3.fromRGB(c[2], c[3], c[4]))
	end
	return ColorSequence.new(ks)
end

local function nexoBorder(thickness, cols, rot)
	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(255, 255, 255)
	s.Thickness = thickness or 2
	s.Transparency = 0
	local g = Instance.new("UIGradient")
	g.Color = nexoSeq(cols or G_PANEL_STRK)
	g.Rotation = rot or -57
	g.Parent = s
	return s
end

