local function lerpUDim2(a, b, t)
	return UDim2.new(
		a.X.Scale + (b.X.Scale - a.X.Scale) * t,
		a.X.Offset + (b.X.Offset - a.X.Offset) * t,
		a.Y.Scale + (b.Y.Scale - a.Y.Scale) * t,
		a.Y.Offset + (b.Y.Offset - a.Y.Offset) * t
	)
end

local function makeDraggable(frame, handle, onSettled)
	local dragging, dragStart, startPos
	local target = frame.Position
	local loop = nil
	local conns = {}
	handle = handle or frame

	local function stopLoop()
		if loop then
			loop:Disconnect()
			loop = nil
		end
	end

	local function cleanup()
		dragging = false
		stopLoop()
		for i = #conns, 1, -1 do
			pcall(function() conns[i]:Disconnect() end)
			conns[i] = nil
		end
	end

	local function startLoop()
		if loop then return end
		loop = RunService.RenderStepped:Connect(function(dt)
			if not frame.Parent then
				cleanup()
				return
			end

			local pos = frame.Position
			local smooth = math.max(DRAG_SMOOTH, 0.0001)
			local alpha = 1 - math.exp(-dt / smooth)
			local nextPos = lerpUDim2(pos, target, alpha)

			if not dragging then
				local dx = math.abs(nextPos.X.Offset - target.X.Offset)
				local dy = math.abs(nextPos.Y.Offset - target.Y.Offset)
				local sx = math.abs(nextPos.X.Scale - target.X.Scale)
				local sy = math.abs(nextPos.Y.Scale - target.Y.Scale)
				if dx < 0.5 and dy < 0.5 and sx < 0.001 and sy < 0.001 then
					frame.Position = target
					stopLoop()
					if onSettled then onSettled(target) end
					return
				end
			end

			frame.Position = nextPos
		end)
	end

	conns[#conns + 1] = handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			target = startPos

			cancelTween(frame, "slide")
			startLoop()

			local changedConn
			changedConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if changedConn then
						changedConn:Disconnect()
						changedConn = nil
					end
				end
			end)
		end
	end)

	conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input)

		if not dragging then return end
		local t = input.UserInputType
		if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then
			return
		end
		local delta = input.Position - dragStart
		target = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
		startLoop()
	end)

	conns[#conns + 1] = frame.AncestryChanged:Connect(function(_, parent)
		if not parent then cleanup() end
	end)

	local control = {}

	function control.setPosition(pos)
		if not pos then return end
		target = pos
		dragging = false
		stopLoop()
		if frame.Parent then frame.Position = pos end
	end

	function control.getPosition()
		return target
	end

	control.cleanup = cleanup

	return control
end

