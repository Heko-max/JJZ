--=====================================================
--  FIT TO SCREEN - same look everywhere, only bigger or smaller
--=====================================================
function Library:_fitToScreen()
	local scaleObj = self.Main:FindFirstChild("Scale")
	if not scaleObj then return end

	local camera = workspace.CurrentCamera
	local viewport = (camera and camera.ViewportSize) or Vector2.new(1280, 720)

	local designW = LAYOUT.PanelWidth
	local designH = self.PanelHeight or 575

	local fit = math.min(
		(viewport.X * SCREEN_FILL) / designW,
		(viewport.Y * SCREEN_FILL) / designH
	)

	-- BaseScale is the real resting size. the open / hide animation borrows
	-- this same UIScale, so we never overwrite it mid animation.
	-- the clone shell already sizes itself from the viewport, so its
	-- UIScale must rest at 1 or the panel would get shrunk twice.
	if UI_CLONE then
		-- shrink the ENTIRE panel until it fills CLONE_WIDTH of the screen.
		-- Because this is a UIScale, the header, arrows, nav, home cards and
		-- every tab shrink by the exact same amount, so the layout stays
		-- identical to the original - just smaller. Never let it grow past
		-- the screen height either.
		local wantW = (viewport.X * CLONE_WIDTH) / LAYOUT.PanelWidth
		local capH  = (viewport.Y * SCREEN_FILL) / CLONE_HEIGHT
		self.BaseScale = math.min(wantW, capH) * UI_SIZE
	else
		self.BaseScale = math.clamp(fit, MIN_SCALE, MAX_SCALE) * UI_SIZE
	end
	-- Writing the scale during the build, or on top of a running tween, is
	-- what made the panel jump. Only a settled, visible panel gets it.
	if not self.Animating and self._introDone ~= false then
		scaleObj.Scale = self.BaseScale
	end

	self.Main.AnchorPoint = Vector2.new(0.5, 0.5)

	-- Center ONCE, on the very first layout. After that the panel belongs to
	-- wherever the user dragged it. Re-centering here on every layout pass is
	-- what made a panel parked in a corner reappear in the middle and then
	-- slide back across the screen.
	if not self._centeredOnce then
		self._centeredOnce = true
		self.Main.Position = UDim2.fromScale(0.5, 0.5)
		self.PanelPos = self.Main.Position
		if self.MainDrag then self.MainDrag.setPosition(self.Main.Position) end
		return
	end

	-- Keep the remembered spot, but make sure a resolution or scale change can
	-- never leave the panel stranded half off screen.
	local pos = self.PanelPos or self.Main.Position
	local scale = self.BaseScale or 1
	local halfW = (designW * scale) / 2
	local halfH = (designH * scale) / 2

	local x = pos.X.Scale * viewport.X + pos.X.Offset
	local y = pos.Y.Scale * viewport.Y + pos.Y.Offset
	x = math.clamp(x, halfW, math.max(halfW, viewport.X - halfW))
	y = math.clamp(y, halfH, math.max(halfH, viewport.Y - halfH))

	local fixed = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
	self.PanelPos = fixed

	-- never yank the panel mid open / close animation, and never fight the
	-- position lock. This write is the one that used to drop the panel back
	-- into the middle of the screen part way through opening.
	if not self.Animating and not self._posLock then
		self.Main.Position = fixed
		if self.MainDrag then self.MainDrag.setPosition(fixed) end
	end
end

--=====================================================
--  APPLY LAYOUT - call this after changing any LAYOUT number
--=====================================================
function Library:_applyLayout()
	-- RULE 2: sections grow to fit their images, so they can never collide
	local headerH = math.max(LAYOUT.HeaderHeight, LAYOUT.LogoHeight)
	local heroH   = math.max(LAYOUT.HeroHeight, LAYOUT.BannerHeight + math.abs(LAYOUT.BannerOffsetY) * 2)

	local panelH = (LAYOUT.PanelPadding * 2)
		+ headerH + LAYOUT.GAP
		+ heroH + LAYOUT.GAP
		+ LAYOUT.CardsHeight
		+ (LAYOUT.PanelExtraHeight or 0) -- makes the panel taller, so the control box has room to grow down

	self.PanelHeight = panelH
	if UI_CLONE then
		self.Main.Size = CLONE_SIZE
	else
		self.Main.Size = UDim2.fromOffset(LAYOUT.PanelWidth, panelH)
	end
	self:_fitToScreen()

	self.Header.Position = UDim2.fromOffset(0, LAYOUT.HeaderOffsetY)
	self.Header.Size = UDim2.new(1, 0, 0, headerH)
	self.Logo.Size   = UDim2.fromOffset(LAYOUT.LogoWidth, LAYOUT.LogoHeight)

	local topDrop = LAYOUT.HeaderOffsetY + headerH + LAYOUT.GAP
	self.Content.Position = UDim2.fromOffset(0, topDrop)
	self.Content.Size     = UDim2.new(1, 0, 1, -topDrop)

	-- the clone front page sizes itself with scales, so these pixel writes
	-- are skipped. Everything else in this pass still runs.
	if not HOME_CLONE then
		self.Hero.Size = UDim2.new(1, 0, 0, heroH)

		-- RULE 1: the -GAP keeps the text away from the banner
		self.Left.Size   = UDim2.new(LAYOUT.HeroLeftWidth, -LAYOUT.GAP, 1, 0)
		self.Banner.Size = UDim2.new(LAYOUT.BannerWidth, 0, 0, LAYOUT.BannerHeight)
		self.Banner.Position = UDim2.new(1, 0, 0.5, LAYOUT.BannerOffsetY)

		self.Socials.Size = UDim2.new(1, 0, 0, socialH() + LAYOUT.SocialOffsetY)
		for _, box in ipairs(self.SocialBoxes) do
			-- SAME MATH AS THE BUILD. This pass runs on every resize and used to
			-- write the raw numbers back, wiping out the X / Y stretch.
			box.Size = UDim2.fromOffset(socialW(), socialH())
			local iconSlot = box:FindFirstChild("Icon")
			local ratio = iconSlot and iconSlot:FindFirstChildOfClass("UIAspectRatioConstraint")
			if ratio then
				ratio.AspectRatio = (LAYOUT.SocialWidth or LAYOUT.SocialBox) / LAYOUT.SocialBox
			end
		end

		self.CardRow.Size = UDim2.new(1, -6, 0, LAYOUT.CardsHeight)
		self.CardRow.Position = UDim2.new(0, 3, 1, -3)
		for _, slot in ipairs(self.IconSlots) do
			slot.Size = UDim2.fromOffset(LAYOUT.CardIcon, LAYOUT.CardIcon)
		end
		for _, col in ipairs(self.TextCols) do
			col.Size = UDim2.new(1, -(LAYOUT.CardIcon + LAYOUT.GAP), 1, 0)
		end
	end

	if self.Warning then
		local total = LAYOUT.HeroLeftWidth + LAYOUT.BannerWidth
		if total > 1 then
			self.Warning.Text = string.format("WARNING: text + banner = %.2f. Keep it at 1.00 or less.", total)
			self.Warning.TextColor3 = Color3.fromRGB(255, 120, 120)
		else
			self.Warning.Text = string.format("OK: text + banner = %.2f | panel height %d", total, panelH)
			self.Warning.TextColor3 = Color3.fromRGB(120, 220, 150)
		end
	end

	if self.Summary then
		self.Summary.Text = string.format(
			"BannerWidth=%.2f  BannerHeight=%d  LogoWidth=%d  LogoHeight=%d  CardIcon=%d  SocialBox=%d  TextColumn=%.2f  Gap=%d  HeroHeight=%d",
			LAYOUT.BannerWidth, LAYOUT.BannerHeight,
			LAYOUT.LogoWidth, LAYOUT.LogoHeight,
			LAYOUT.CardIcon, LAYOUT.SocialBox,
			LAYOUT.HeroLeftWidth, LAYOUT.GAP, LAYOUT.HeroHeight
		)
	end
end

