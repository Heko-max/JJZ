function Library:_aiBubble(who, text)
	local state = self:_buildAiWindow()
	if not state then return nil end

	local tpl = (who == "user") and state.UserTpl or state.BotTpl
	local bubble = tpl:Clone()
	bubble.Name = (who == "user") and "UserChat" or "BotChat"
	state.Order = state.Order + 1
	bubble.LayoutOrder = state.Order
	bubble.Content.Streaming.Text = tostring(text or "")
	bubble.Parent = state.History

	local face = bubble:FindFirstChild("Avatar")
	if face then
		if who == "user" then
			self:_aiImage(face, self:_aiUserAvatar(), "")
		else
			self:_aiImage(face, Library.AiCfg.BotAvatar, Library.AiCfg.BotFallback)
		end
	end
	state.Decor.Visible = false
	if state.Scroll then state.Scroll() end

	return bubble.Content.Streaming
end

function Library:_aiType(label, text)
	if not label or not label.Parent then return end
	local words = {}
	for word in tostring(text):gmatch("%S+") do words[#words + 1] = word end

	label.Text = ""
	local shown = ""
	local source = tostring(text)
	local at = 1

	for _, word in ipairs(words) do
		local from, to = source:find(word, at, true)
		local gap = ""
		if from and from > at then gap = source:sub(at, from - 1) end
		if from then at = to + 1 end
		shown = shown .. gap .. word
		if label.Parent then
			label.Text = shown
			if self.Ai and self.Ai.Scroll then self.Ai.Scroll() end
		else
			return
		end
		task.wait(Library.AiCfg.TypeSpeed)
	end

	if label.Parent then label.Text = source end
end

function Library:AiSay(who, text, instant)
	local label = self:_aiBubble(who, "")
	if not label then return self end

	if who == "user" or instant then
		label.Text = tostring(text)
	else
		task.spawn(function() self:_aiType(label, tostring(text)) end)
	end

	return self
end

function Library:AiAsk(text)
	local reply = self:AiAnswer(text)
	self:AiSay("user", tostring(text))
	self:AiSay("bot", reply)
	return reply
end

function Library:ShowAi(state)
	local ai = self:_buildAiWindow()
	if not ai then return self end
	local want = (state ~= false)
	if want == ai.Open then return self end
	ai.Open = want
	if want then ai.OpenFn() else ai.CloseFn() end
	return self
end

function Library:ToggleAi()
	local ai = self:_buildAiWindow()
	if not ai then return self end
	return self:ShowAi(not ai.Open)
end

function Library:ClearAi()
	local ai = self.Ai
	if not ai then return self end
	for _, child in ipairs(ai.History:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
	ai.Order = 0
	ai.Decor.Visible = true
	return self
end

function Library:SetAiReplies(url)
	Library.AiCfg.RepliesUrl = tostring(url or "")
	if Library.AiCfg.RepliesUrl ~= "" then
		task.spawn(function() self:LoadAiReplies(Library.AiCfg.RepliesUrl) end)
	end
	return self
end

local NexoHub = {}
NexoHub.Library = Library
NexoHub.Version = "1.0"

function NexoHub:CreateWindow(opts)
	opts = opts or {}
	local ui = Library.new()

	if DEFAULT_UI_TAB and opts.uiTab ~= false then
		pcall(function() ui:_buildUiTab() end)
	end

	if opts.welcome  then pcall(function() ui:SetText("Welcome", opts.welcome) end) end
	if opts.subtitle then pcall(function() ui:SetText("Subtitle", opts.subtitle) end) end
	if opts.credits  then pcall(function() ui:SetText("Credits", opts.credits) end) end

	if opts.background then pcall(function() ui:SetImage("Background", opts.background) end) end
	if opts.logo       then pcall(function() ui:SetImage("Logo", opts.logo) end) end
	if opts.banner     then pcall(function() ui:SetImage("Banner", opts.banner) end) end

	if opts.folder then ui:SetFolder(opts.folder) end
	if opts.accent then ui:SetAccent(opts.accent) end

	ui:SetToggleKey(opts.toggleKey or "RightShift")

	if opts.status == false then
		Library.StatusCfg.Enabled = false
	else
		if opts.statusTitle then Library.StatusCfg.Title = tostring(opts.statusTitle) end
		pcall(function() ui:_buildStatusWindow() end)
	end

	if opts.ai == false then
		Library.AiCfg.Enabled = false
	else
		if opts.aiRoot then Library.AiCfg.Root = tostring(opts.aiRoot) end
		pcall(function() ui:_buildAiWindow() end)
	end

	if opts.autoload then
		task.defer(function() ui:LoadAutoload(true) end)
	end

	NexoHub.Window = ui
	return ui
end

function NexoHub.new(opts)
	return NexoHub:CreateWindow(opts)
end

NexoHub.Images = IMG

NexoHub.CanUseImageLinks = IMG.canDownload

function NexoHub:ResolveImage(input)
	return IMG.get(input)
end

function NexoHub:ApplyImage(instance, input, prop)
	IMG.set(instance, prop or "Image", input)
	return instance
end

function NexoHub:PreloadImages(list, onDone)
	IMG.preload(list, onDone)
	return self
end

function NexoHub:ClearImageCache()
	return IMG.clearCache()
end

return NexoHub
