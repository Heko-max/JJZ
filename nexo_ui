				elseif channel == "G" then
					THEME[themeKey] = Color3.new(c.R, n, c.B)
				else
					THEME[themeKey] = Color3.new(c.R, c.G, n)
				end
				refreshControlColors()
			end
			box.Text = tostring(channelValue())
		end)
