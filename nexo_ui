	elseif which == "Banner" then
		IMAGES.Banner = id
		IMG.set(self.Banner, "Image", id)
	end
end


--=====================================================
--  UI COLOUR ENGINE  +  THE BUILT IN "UI" TAB
--=====================================================
-- The whole hub is painted from the THEME table at the top of this file.
-- This engine repaints it LIVE - either the whole UI at once, or only one
-- part of it (buttons / outlines / sliders / text / ...). Nothing is
-- rebuilt, so it never breaks a tab, a section or a control.
--
--   ui:SetPartColor("Sliders", Color3.fromRGB(0, 170, 255))
--   ui:SetPartColor("All (whole UI)", Color3.fromRGB(0, 255, 120))
--   ui:RefreshColors()          -- repaint everything that was changed
--   ui:ResetColors()            -- back to the original red
--   ui:GetColorParts()          -- list of every part name

local DEFAULT_UI_TAB = false  -- false = do not add the built in "UI" tab

local UICOLOR = {}

-- the colours the library started with, so RESET always works
UICOLOR.Base = {}
for k, v in pairs(THEME) do UICOLOR.Base[k] = v end

UICOLOR.Seen    = {}   -- theme key  -> every colour that key has ever worn
UICOLOR.Applied = {}   -- part name  -> the colour the user picked
UICOLOR.Order   = {}   -- the order the user applied them in

-- WHAT CAN BE PAINTED
-- keys    = which THEME entries this part uses
-- match   = only instances sitting under a name containing one of these words
-- classes = only these instance types
-- props   = only these properties
UICOLOR.Targets = {
	{ name = "All (whole UI)",
	  keys = { "Accent", "AccentDark", "Stroke", "ControlAccent", "ControlText", "LaserSoft", "LaserEdge", "LaserShine" } },

	{ name = "Accent only",
	  keys = { "Accent", "AccentDark" } },

	{ name = "Outlines",
	  keys = { "Stroke", "ControlAccent", "LaserSoft", "LaserEdge", "LaserShine" },
	  classes = { "UIStroke", "UIGradient" } },

	{ name = "Buttons",
	  keys = { "ControlAccent", "ControlText", "LaserSoft", "LaserEdge" },
	  match = { "Button" } },

	{ name = "Toggles / Switches",
	  keys = { "ControlAccent", "ControlText" },
	  match = { "Toggle", "Switch" } },

	{ name = "Sliders",
	  keys = { "ControlAccent", "ControlText" },
