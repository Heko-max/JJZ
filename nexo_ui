	local function send()
		local state = self.Ai
		if not state or state.Busy then return end
		local text = ChatBar.Text
		if text:gsub("%s+", "") == "" then return end

		ChatBar.Text = ""
		state.Busy = true
		sRunning.Visible = true
		sUp.Visible = false

		self:AiSay("user", text)

		task.spawn(function()
			local label = self:_aiBubble("bot", "Thinking .")
			local thinking = true

			task.spawn(function()
				local dots = 1
				while thinking and label.Parent do
					label.Text = "Thinking " .. string.rep(". ", dots)
					dots = dots + 1
					if dots > 3 then dots = 1 end
					task.wait(0.32)
				end
			end)

			task.wait(CFG.ThinkMin + math.random() * math.max(0, CFG.ThinkMax - CFG.ThinkMin))
			thinking = false

			local reply = "Sorry, something went wrong on my side~"
			pcall(function() reply = self:AiAnswer(text) end)

			self:_aiType(label, reply)

			state.Busy = false
			sRunning.Visible = false
			sUp.Visible = true
		end)
	end

