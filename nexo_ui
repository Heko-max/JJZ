function IMG.httpGet(url)
	-- every download function this executor might have, tried one by one.
	-- some of them throw instead of returning, so each one is wrapped.
	local reqs = {}
	local function add(f)
		if type(f) == "function" then reqs[#reqs + 1] = f end
	end
	add(syn and syn.request)
	add(request)
	add(http_request)
	add(http and http.request)
	add(fluxus and fluxus.request)
	add(getgenv and getgenv().request)

	for _, fn in ipairs(reqs) do
		local ok, res = pcall(fn, { Url = url, Method = "GET" })
		if ok and type(res) == "table" then
			local body = res.Body or res.body
			if type(body) == "string" and #body > 0 then return body end
		end
	end

	local ok, body = pcall(function() return game:HttpGet(url, true) end)
	if ok and type(body) == "string" and #body > 0 then return body end

	ok, body = pcall(function() return game:HttpGetAsync(url) end)
	if ok and type(body) == "string" and #body > 0 then return body end

	return nil
end

-- true when this executor can download website images
IMG.canDownload = (IMG.writefile and IMG.getasset) and true or false

local function ensureFolder()
	if IMG.makefolder and not (IMG.isfolder and IMG.isfolder(IMG.CACHE_DIR)) then
		pcall(IMG.makefolder, IMG.CACHE_DIR)
	end
end
ensureFolder()

function IMG.hash(s)
	local h = 5381
	for i = 1, #s do h = (h * 33 + s:byte(i)) % 4294967296 end
	return tostring(h)
end

function IMG.extOf(url, fallback)
	local e = url:match("%.(%w%w%w%w?)%f[%W]")
	if e then e = e:lower() end
	return (e and IMG.VALID_EXT[e]) and e or (fallback or "png")
end

-- read the real file type from the first bytes
function IMG.sniff(body)
	if #body < 12 then return nil end
	if body:sub(1, 8) == "\137PNG\r\n\26\n" then return "png" end
	if body:sub(1, 3) == "\255\216\255" then return "jpg" end
	if body:sub(1, 2) == "BM" then return "bmp" end
	if body:sub(1, 6) == "GIF89a" or body:sub(1, 6) == "GIF87a" then return "gif" end
	if body:sub(1, 4) == "RIFF" and body:sub(9, 12) == "WEBP" then return "webp" end
	return nil
end

-- classify(input) -> "id" | "http" | "file" | nil, value/reason
function IMG.classify(input)
	if input == nil or input == false or input == "" then return nil, "empty" end
	if type(input) == "number" then
		return "id", "rbxassetid://" .. tostring(math.floor(input))
	end

	local s = tostring(input):gsub("%s", "")
	if s == "" then return nil, "empty" end

	local filePath = s:match("^file:(.+)$")
	if filePath then return "file", filePath end

	if s:match("^%d+$") then return "id", "rbxassetid://" .. s end
	if s:lower():match("^rbx") then return "id", s end

	local host = s:match("^https?://([^/]+)")
	if host and host:lower():find("roblox%.com") then
		local id =
			s:match("[/?&][iI][dD]=(%d+)")
			or s:match("[/?&]assetId=(%d+)")
			or s:match("[/?&]assetid=(%d+)")
			or s:match("/library/(%d+)")
			or s:match("/catalog/(%d+)")
			or s:match("/asset[s]?/(%d+)")
			or s:match("(%d%d%d%d%d+)")
		if id then return "id", "rbxassetid://" .. id end
		return nil, "roblox link has no asset id"
	end

	if s:match("^https?://") then return "http", s end
	if s:match("^[%w%.%-]+%.%a%a+/") then return "http", "https://" .. s end

	return "id", s
end

function IMG.isUrl(input)
	local kind = IMG.classify(input)
	return kind == "http" or kind == "file"
end

function IMG.fromFile(path)
	if not IMG.getasset then return nil, "executor lacks getcustomasset" end
	if IMG.isfile and not IMG.isfile(path) then return nil, "file not found" end
	local ok, id = pcall(IMG.getasset, path)
	if not ok or not id then return nil, "getcustomasset failed" end
	return id
end

-- download once, cache on disk, return a usable content id
function IMG.download(url)
	if not IMG.canDownload then
		return nil, "executor cannot download images (needs writefile + getcustomasset)"
	end

	ensureFolder()
	local base = IMG.CACHE_DIR .. "/" .. IMG.hash(url)
	local path = base .. "." .. IMG.extOf(url, "png")
	if IMG.isfile and IMG.isfile(path) then
		local cachedId = IMG.fromFile(path)
		if cachedId then return cachedId end
	end

	local lastErr = "download failed"
	for attempt = 1, IMG.MAX_RETRIES do
		local ok, body = pcall(IMG.httpGet, url)
		if ok and type(body) == "string" and #body >= IMG.MIN_BYTES then
			local head = body:sub(1, 15):lower()
			if head:find("<!doctype") or body:sub(1, 5):lower() == "<html" then
				return nil, "got a web page, not an image (hotlink blocked)"
			end

			local kind = IMG.sniff(body)
			if kind == "gif" then
				-- Roblox cannot display a raw .gif, so the bytes are handed to the
				-- GIF engine, which decodes the frames and animates them instead.
				IMG.gifBodies[url] = body
				return nil, "animated gif, handled by the GIF engine"
			end
			if kind == "webp" then
				return nil, "roblox cannot show WEBP images"
			end
			if kind then path = base .. "." .. kind end

			if not pcall(IMG.writefile, path, body) then return nil, "writefile failed" end
			return IMG.fromFile(path)
		else
			lastErr = ok and "response was not a file" or "http request failed"
			if attempt < IMG.MAX_RETRIES then task.wait(0.35) end
		end
	end
	return nil, lastErr
end

-- BLOCKING resolve of any input -> content id. call inside task.spawn.
function IMG.get(input)
	local key = tostring(input)
	if IMG.memory[key] then return IMG.memory[key] end

	local kind, value = IMG.classify(input)
	if not kind then return nil, value end

	local id, err
	if kind == "id" then
		id = value
	elseif kind == "file" then
		id, err = IMG.fromFile(value)
	else
		id, err = IMG.download(value)
	end

	if id then
		IMG.memory[key] = id
		return id
	end
	return nil, err or "unknown error"
end

-- after a link finishes loading, hide the "no image" placeholders that sit
-- next to it (the round button letter, the red X on close, ...)
function IMG.hideFallbacks(inst)
	pcall(function()
		for _, name in ipairs({ "Fallback", "X" }) do
			local a = inst:FindFirstChild(name)
			if a then a.Visible = false end
			if inst.Parent then
				local b = inst.Parent:FindFirstChild(name)
				if b then b.Visible = false end
			end
		end
	end)
end

-- IMG.set(instance, "Image", input, onDone)
-- ids apply instantly, links apply as soon as the download finishes
function IMG.set(inst, prop, input, onDone)
	if not inst then return end
	prop = prop or "Image"

	local kind, value = IMG.classify(input)
	if not kind then
		pcall(function() inst[prop] = "" end)
		if onDone then onDone(false, "empty") end
		return
	end

	if kind == "id" then
		pcall(function() inst[prop] = value end)
		IMG.hideFallbacks(inst)
		if onDone then onDone(true, value) end
		return
	end

	-- ANIMATED GIF: any link that points at a .gif (or an imgur / giphy /
	-- tenor page that has one behind it) is played frame by frame on this
	-- very same ImageLabel. Everything else carries on as a still image.
	if kind == "http" and prop == "Image" and GIF and GIF.ready and GIF.looksGif(value) then
		GIF.attach(inst, value, onDone)
		return
	end

	local cached = IMG.memory[tostring(input)]
	if cached then
		pcall(function() inst[prop] = cached end)
		IMG.hideFallbacks(inst)
		if onDone then onDone(true, cached) end
		return
	end

	pcall(function() inst[prop] = "" end)
	task.spawn(function()
		local id, err = IMG.get(input)
		if id and inst and inst.Parent ~= nil then
			pcall(function() inst[prop] = id end)
			IMG.hideFallbacks(inst)
		end
		if onDone then onDone(id and true or false, id or err) end
	end)
end

-- download a list of links up front so they pop in instantly later
function IMG.preload(list, onDone)
	task.spawn(function()
		local done = 0
		for _, item in ipairs(list or {}) do
			if IMG.get(item) then done = done + 1 end
		end
		if onDone then onDone(done) end
	end)
end

function IMG.clearCache()
	IMG.memory = {}
	if not (IMG.listfiles and IMG.delfile) then return 0 end
	local removed = 0
	local ok, files = pcall(IMG.listfiles, IMG.CACHE_DIR)
	if ok and type(files) == "table" then
		for _, f in ipairs(files) do
			if pcall(IMG.delfile, f) then removed = removed + 1 end
		end
	end
	return removed
end

--=====================================================
--  ANIMATED GIF ENGINE
--  Decodes a .gif and plays its frames on a normal ImageLabel using an
--  EditableImage. Any image field in this library (Background, Logo,
--  Banner, MiniIcon, social icons, notification icons, card icons)
--  accepts a gif link now - nothing else about them changed.
--  Falls back silently to a still image when the executor or client
--  cannot do EditableImage.
--=====================================================
local GIF_ASSETS = select(2, pcall(function() return game:GetService("AssetService") end))
local GIF_RUN    = select(2, pcall(function() return game:GetService("RunService") end))

GIF = {
	ready     = false,
	cache     = {},   -- url -> { pending, waiting, data, fault }
	players   = {},   -- player -> true
	budget    = 26 * 1024 * 1024,
	maxFrames = 300,
}

local GIF_BUFFER_OK = type(buffer) == "table" and type(buffer.create) == "function"
if GIF_BUFFER_OK and GIF_ASSETS and Content ~= nil then
	GIF.ready = pcall(function()
		local probe = GIF_ASSETS:CreateEditableImage({ Size = Vector2.new(2, 2) })
		probe:WritePixelsBuffer(Vector2.zero, Vector2.new(2, 2), buffer.create(16))
		return Content.fromObject(probe)
	end)
end

local function lzwDecode(data, minCode, limit)
	local out = buffer.create(math.max(1, limit))
	local prefix, suffix, stack = table.create(4096, 0), table.create(4096, 0), table.create(4096, 0)
	local clear = bit32.lshift(1, minCode)
	local eoi = clear + 1
	local codeSize = minCode + 1
	local maxCode = bit32.lshift(1, codeSize)
	local nextFree = eoi + 1
	local old, first, outPos = -1, 0, 0
	local pos, acc, accBits, length = 1, 0, 0, #data
	while true do
		while accBits < codeSize and pos <= length do
			acc = bit32.bor(acc, bit32.lshift(string.byte(data, pos), accBits))
			accBits = accBits + 8
			pos = pos + 1
		end
		if accBits < codeSize then break end
		local code = bit32.band(acc, maxCode - 1)
		acc = bit32.rshift(acc, codeSize)
		accBits = accBits - codeSize
		if code == eoi then break end
		if code == clear then
			codeSize = minCode + 1
			maxCode = bit32.lshift(1, codeSize)
			nextFree = eoi + 1
			old = -1
		elseif old == -1 then
			if code < clear then
				if outPos < limit then
					buffer.writeu8(out, outPos, code)
					outPos = outPos + 1
				end
				first, old = code, code
			end
		else
			local current, top = code, 0
			if code >= nextFree then
				stack[top] = first
				top = top + 1
				current = old
			end
			local guard = 0
			while current >= clear and guard < 4096 do
				stack[top] = suffix[current]
				top = top + 1
				current = prefix[current]
				guard = guard + 1
			end
			first = current
			stack[top] = current
			top = top + 1
			for index = top - 1, 0, -1 do
				if outPos < limit then
					buffer.writeu8(out, outPos, stack[index])
					outPos = outPos + 1
				end
			end
			if nextFree < 4096 then
				prefix[nextFree] = old
				suffix[nextFree] = first
				nextFree = nextFree + 1
				if nextFree >= maxCode and codeSize < 12 then
					codeSize = codeSize + 1
					maxCode = bit32.lshift(1, codeSize)
				end
			end
			old = code
		end
	end
	return out
end

local PASSES = { { 0, 8 }, { 4, 8 }, { 2, 4 }, { 1, 2 } }

local function deinterlace(source, width, height)
	local target = buffer.create(math.max(1, width * height))
	local row = 0
	for _, pass in ipairs(PASSES) do
		local y = pass[1]
		while y < height do
			buffer.copy(target, y * width, source, row * width, width)
			row = row + 1
			y = y + pass[2]
		end
	end
	return target
end

local function palettePack(palette)
	local count = math.floor(#palette / 3)
	local packed = table.create(math.max(1, count), 0)
	for index = 0, count - 1 do
		local base = index * 3
		local r = string.byte(palette, base + 1) or 0
		local g = string.byte(palette, base + 2) or 0
		local b = string.byte(palette, base + 3) or 0
		packed[index] = r + g * 256 + b * 65536 + 4278190080
	end
	return packed, count
end

local function gifDecode(bytes)
	if type(bytes) ~= "string" or #bytes < 14 or string.sub(bytes, 1, 3) ~= "GIF" then return nil, "This link is not a GIF file" end
	local screenW = string.byte(bytes, 7) + string.byte(bytes, 8) * 256
	local screenH = string.byte(bytes, 9) + string.byte(bytes, 10) * 256
	if screenW < 1 or screenH < 1 then return nil, "This GIF reports no size" end
	if screenW * screenH > 1440 * 900 then return nil, "This GIF is too large to animate" end
	local packed = string.byte(bytes, 11)
	local pos = 14
	local globalTable = nil
	if bit32.band(packed, 128) ~= 0 then
		local size = bit32.lshift(1, bit32.band(packed, 7) + 1)
		globalTable = string.sub(bytes, pos, pos + size * 3 - 1)
		pos = pos + size * 3
	end
	local frames = {}
	local frameBytes = screenW * screenH * 4
	local canvas = buffer.create(frameBytes)
	local saved = nil
	local total, loops = 0, 0
	local delay, disposal, transparent = 10, 0, nil
	local pendingDisposal, pendingRect = 0, nil
	local dirtyL, dirtyT, dirtyR, dirtyB = screenW, screenH, 0, 0
	local clock = os.clock()
	local limit = #bytes
	while pos <= limit do
		local block = string.byte(bytes, pos)
		if not block or block == 59 then break end
		if block == 33 then
			local label = string.byte(bytes, pos + 1) or 0
			pos = pos + 2
			if label == 249 then
				local size = string.byte(bytes, pos) or 4
				local flags = string.byte(bytes, pos + 1) or 0
				delay = (string.byte(bytes, pos + 2) or 0) + (string.byte(bytes, pos + 3) or 0) * 256
				local index = string.byte(bytes, pos + 4) or 0
				disposal = bit32.band(bit32.rshift(flags, 2), 7)
				transparent = bit32.band(flags, 1) == 1 and index or nil
				pos = pos + size + 1
				while true do
					local sub = string.byte(bytes, pos)
					if not sub or sub == 0 then
						pos = pos + 1
						break
					end
					pos = pos + sub + 1
				end
			elseif label == 255 then
				local size = string.byte(bytes, pos) or 0
				local name = string.sub(bytes, pos + 1, pos + size)
				pos = pos + size + 1
				while true do
					local sub = string.byte(bytes, pos)
					if not sub or sub == 0 then
						pos = pos + 1
						break
					end
					if string.sub(name, 1, 8) == "NETSCAPE" and sub >= 3 then
						loops = (string.byte(bytes, pos + 2) or 0) + (string.byte(bytes, pos + 3) or 0) * 256
					end
					pos = pos + sub + 1
				end
			else
				while true do
					local sub = string.byte(bytes, pos)
					if not sub or sub == 0 then
						pos = pos + 1
						break
					end
					pos = pos + sub + 1
				end
			end
		elseif block == 44 then
			local left = (string.byte(bytes, pos + 1) or 0) + (string.byte(bytes, pos + 2) or 0) * 256
			local top = (string.byte(bytes, pos + 3) or 0) + (string.byte(bytes, pos + 4) or 0) * 256
			local fw = (string.byte(bytes, pos + 5) or 0) + (string.byte(bytes, pos + 6) or 0) * 256
			local fh = (string.byte(bytes, pos + 7) or 0) + (string.byte(bytes, pos + 8) or 0) * 256
			local flags = string.byte(bytes, pos + 9) or 0
			pos = pos + 10
			local palette = globalTable
			if bit32.band(flags, 128) ~= 0 then
				local size = bit32.lshift(1, bit32.band(flags, 7) + 1)
				palette = string.sub(bytes, pos, pos + size * 3 - 1)
				pos = pos + size * 3
			end
			local interlace = bit32.band(flags, 64) ~= 0
			local minCode = string.byte(bytes, pos) or 8
			pos = pos + 1
			local chunks = {}
			while true do
				local sub = string.byte(bytes, pos)
				if not sub or sub == 0 then
					pos = pos + 1
					break
				end
				table.insert(chunks, string.sub(bytes, pos + 1, pos + sub))
				pos = pos + sub + 1
			end
			if palette and fw > 0 and fh > 0 and minCode >= 2 and minCode <= 11 then
				local indices = lzwDecode(table.concat(chunks), minCode, fw * fh)
				if interlace then indices = deinterlace(indices, fw, fh) end
				if pendingDisposal == 2 and pendingRect then
					local rectX = math.max(0, pendingRect[1])
					local rectW = math.min(pendingRect[3], screenW - rectX)
					if rectW > 0 then
						for y = pendingRect[2], pendingRect[2] + pendingRect[4] - 1 do
							if y >= 0 and y < screenH then buffer.fill(canvas, (y * screenW + rectX) * 4, 0, rectW * 4) end
						end
					end
					dirtyL = math.min(dirtyL, rectX)
					dirtyT = math.min(dirtyT, math.max(0, pendingRect[2]))
					dirtyR = math.max(dirtyR, math.min(screenW, pendingRect[1] + pendingRect[3]))
					dirtyB = math.max(dirtyB, math.min(screenH, pendingRect[2] + pendingRect[4]))
				elseif pendingDisposal == 3 and saved then
					buffer.copy(canvas, 0, saved, 0, frameBytes)
					dirtyL, dirtyT, dirtyR, dirtyB = 0, 0, screenW, screenH
				end
				if disposal == 3 then
					saved = saved or buffer.create(frameBytes)
					buffer.copy(saved, 0, canvas, 0, frameBytes)
				end
				local colors, colorCount = palettePack(palette)
				for y = 0, fh - 1 do
					local canvasY = top + y
					if canvasY >= 0 and canvasY < screenH then
						local rowBase = canvasY * screenW
						local sourceBase = y * fw
						for x = 0, fw - 1 do
							local canvasX = left + x
							if canvasX >= 0 and canvasX < screenW then
								local index = buffer.readu8(indices, sourceBase + x)
								if index ~= transparent and index < colorCount then buffer.writeu32(canvas, (rowBase + canvasX) * 4, colors[index]) end
							end
						end
					end
				end
				local ms = delay * 10
				if ms < 20 then ms = 100 end
				dirtyL = math.min(dirtyL, math.max(0, left))
				dirtyT = math.min(dirtyT, math.max(0, top))
				dirtyR = math.max(dirtyR, math.min(screenW, left + fw))
				dirtyB = math.max(dirtyB, math.min(screenH, top + fh))
				if #frames > 0 and (total + frameBytes > GIF.budget or #frames >= GIF.maxFrames) then
					frames[#frames].delay = frames[#frames].delay + ms
				else
					local snapshot = buffer.create(frameBytes)
					buffer.copy(snapshot, 0, canvas, 0, frameBytes)
					local rx, ry = dirtyL, dirtyT
					local rw, rh = dirtyR - dirtyL, dirtyB - dirtyT
					if #frames == 0 or rw < 1 or rh < 1 then rx, ry, rw, rh = 0, 0, screenW, screenH end
					table.insert(frames, { pixels = snapshot, delay = ms, x = rx, y = ry, w = rw, h = rh })
					total = total + frameBytes
					dirtyL, dirtyT, dirtyR, dirtyB = screenW, screenH, 0, 0
				end
				pendingDisposal = disposal
				pendingRect = { left, top, fw, fh }
			end
			if os.clock() - clock > 0.003 then
				task.wait()
				clock = os.clock()
			end
		else
			pos = pos + 1
		end
	end
	if #frames == 0 then return nil, "No frames were found inside this GIF" end
	return { width = screenW, height = screenH, frames = frames, loops = loops, bytes = total }
end

local function writePixels(editable, position, size, pixels)
	editable:WritePixelsBuffer(position, size, pixels)
end

function GIF.push(player, full)
	local data = player.data
	local editable = player.editable
	if not data or not editable then return end
	local frame = data.frames[player.frame]
	if not frame then return end
	if full or not frame.w or (frame.w >= data.width and frame.h >= data.height) then
		pcall(writePixels, editable, Vector2.zero, player.size, frame.pixels)
		return
	end
	local rowBytes = frame.w * 4
	local bytes = rowBytes * frame.h
	if player.scratchBytes ~= bytes then
		player.scratch = buffer.create(bytes)
		player.scratchBytes = bytes
	end
	local scratch = player.scratch
	local stride = data.width * 4
	local origin = frame.y * stride + frame.x * 4
	for row = 0, frame.h - 1 do buffer.copy(scratch, row * rowBytes, frame.pixels, origin + row * stride, rowBytes) end
	if not pcall(writePixels, editable, Vector2.new(frame.x, frame.y), Vector2.new(frame.w, frame.h), scratch) then
		pcall(writePixels, editable, Vector2.zero, player.size, frame.pixels)
	end
end

function GIF.detach(player, restore)
	if not player then return end
	GIF.players[player] = nil
	player.playing = false
	local target = player.target
	if target and target.Parent then
		pcall(function() target.Image = restore or "" end)
	end
	player.editable = nil
	player.data = nil
	player.scratch = nil
	player.scratchBytes = nil
end

-- imgur / giphy / tenor pages -> the real .gif file behind them
function GIF.twin(url)
	local imgur = url:match("^https://i%.imgur%.com/([%w]+)%.%w+$")
		or url:match("^https://imgur%.com/([%w]+)%.gifv?$")
	if imgur then return "https://i.imgur.com/" .. imgur .. ".gif" end
	local giphy = url:match("giphy%.com/media/([%w_%-]+)/")
	if giphy then return "https://media.giphy.com/media/" .. giphy .. "/giphy.gif" end
	local tenor = url:match("^(https://media[%w%.%-]*%.tenor%.com/[%w_%-]+/[^/%.]+)%.%w+$")
	if tenor then return tenor .. ".gif" end
	return nil
end

function GIF.looksGif(url)
	if type(url) ~= "string" then return false end
	local path = url:match("^[^?#]+") or url
	local ext = path:match("%.(%w+)$")
	if ext and ext:lower() == "gif" then return true end
	return GIF.twin(url) ~= nil
end

-- the raw bytes, either kept by IMG.download or fetched now
function GIF.bytes(url)
	local body = IMG.gifBodies[url]
	if type(body) == "string" and body:sub(1, 3) == "GIF" then return body end
	body = IMG.httpGet(url)
	if type(body) ~= "string" or body:sub(1, 3) ~= "GIF" then
		local twin = GIF.twin(url)
		if twin and twin ~= url then body = IMG.httpGet(twin) end
	end
	if type(body) == "string" and body:sub(1, 3) == "GIF" then return body end
	return nil
end

-- decode once per link, everyone else waits on the same job
function GIF.load(url, done)
	local entry = GIF.cache[url]
	if entry then
		if entry.pending then
			table.insert(entry.waiting, done)
		else
			task.spawn(done, entry.data, entry.fault)
		end
		return
	end

	entry = { pending = true, waiting = { done } }
	GIF.cache[url] = entry

	task.spawn(function()
		local bytes = GIF.bytes(url)
		local data, fault
		if type(bytes) == "string" then
			local ok, result, problem = pcall(gifDecode, bytes)
			if ok then
				data, fault = result, problem
			else
				fault = "the gif decoder stopped early"
			end
		else
			fault = "could not download the gif"
		end
		IMG.gifBodies[url] = nil
		entry.pending = false
		entry.data    = data
		entry.fault   = fault
		local waiting = entry.waiting
		entry.waiting = {}
		for _, callback in ipairs(waiting) do task.spawn(callback, data, fault) end
	end)
end

-- play a gif on an existing ImageLabel / ImageButton
function GIF.attach(target, url, onDone)
	if not GIF.ready or not target then
		if onDone then onDone(false, "this client cannot animate gifs") end
		return nil
	end

	local player = {
		target = target, url = url, frame = 1, clock = 0,
		speed = 1, playing = true, ready = false, loopsDone = 0,
	}
	GIF.players[player] = true
	pcall(function() target.Image = "" end)

	GIF.load(url, function(data, fault)
		if not GIF.players[player] then return end
		if not data then
			GIF.players[player] = nil
			if onDone then onDone(false, fault or "this gif could not be decoded") end
			return
		end

		local ok, editable = pcall(function()
			return GIF_ASSETS:CreateEditableImage({ Size = Vector2.new(data.width, data.height) })
		end)
		if not ok or not editable then
			GIF.players[player] = nil
			if onDone then onDone(false, "this client cannot draw gif frames") end
			return
		end

		player.data     = data
		player.editable = editable
		player.size     = Vector2.new(data.width, data.height)

		if not pcall(function() target.ImageContent = Content.fromObject(editable) end) then
			GIF.players[player] = nil
			if onDone then onDone(false, "this client cannot draw gif frames") end
			return
		end

		player.ready   = true
		player.playing = #data.frames > 1
		GIF.push(player, true)
		IMG.hideFallbacks(target)
		if onDone then onDone(true, url) end
	end)

	return player
end

-- one heartbeat drives every gif on screen
if GIF_RUN then
	GIF_RUN.Heartbeat:Connect(function(step)
		for player in pairs(GIF.players) do
			local target = player.target
			if not target or not target.Parent then
				GIF.detach(player)
			elseif player.ready and player.playing and player.data then
				local frames = player.data.frames
				local count  = #frames
				player.clock = player.clock + step * 1000 * player.speed
				if player.clock > 320 then player.clock = 320 end

				local advance = 0
				while advance < 40 do
					local current = frames[player.frame]
					if not current or player.clock < current.delay then break end
					player.clock = player.clock - current.delay
					local nextIndex = player.frame + 1
					if nextIndex > count then
						player.loopsDone = player.loopsDone + 1
						if player.data.loops > 0 and player.loopsDone >= player.data.loops then
							player.playing = false
							break
						end
						nextIndex = 1
						advance = advance + 1
					end
					player.frame = nextIndex
					advance = advance + 1
				end

				if advance > 0 then GIF.push(player, advance > 1) end
			end
		end
	end)
end

-- img(id) keeps its old job: turn any input into something an ImageLabel
-- accepts RIGHT NOW. website links cannot be resolved instantly, so they get
-- a token that new() below turns into a real async load.
local PENDING_PREFIX = "nexohub-pending://"

function IMG.isPendingToken(v)
	return type(v) == "string" and v:sub(1, #PENDING_PREFIX) == PENDING_PREFIX
end

function IMG.readPendingToken(v)
	local n = tonumber(v:sub(#PENDING_PREFIX + 1))
	return n and IMG.pending[n] or nil
end

local function img(id)
	if id == nil or id == false or id == "" then return "" end

	local kind, value = IMG.classify(id)
	if not kind then return "" end
	if kind == "id" then return value end

	local cached = IMG.memory[tostring(id)]
	if cached then return cached end

	IMG.pendingN = IMG.pendingN + 1
	IMG.pending[IMG.pendingN] = id
	return PENDING_PREFIX .. tostring(IMG.pendingN)
end

-- ICON PICKER: every card (tab, section, home card) accepts the icon under
-- any of these names ->  image / icon / imageId / iconId / imageID / iconID
-- pass "" or false to hide the icon, pass nothing to use the default one.
local function pickIcon(info, fallback)
	info = info or {}
	local id = info.image
	if id == nil then id = info.icon end
	if id == nil then id = info.imageId end
	if id == nil then id = info.iconId end
	if id == nil then id = info.imageID end
	if id == nil then id = info.iconID end
	if id == nil then return fallback end
	return id
end

--=====================================================
--  HELPERS
--=====================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	local deferred = nil
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			-- a website link cannot be applied instantly: leave the property
			-- blank now and fill it in when the download finishes
			if IMG.isPendingToken(v) then
				local input = IMG.readPendingToken(v)
				inst[k] = ""
				if input then
					deferred = deferred or {}
					deferred[#deferred + 1] = { prop = k, input = input }
				end
			else
				inst[k] = v
			end
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then inst.Parent = props.Parent end
	if deferred then
		for _, job in ipairs(deferred) do
			IMG.set(inst, job.prop, job.input)
		end
	end
	return inst
end

local function corner(r)
