-- soft blend between two positions (used by the smooth drag)
local function lerpUDim2(a, b, t)
	return UDim2.new(
		a.X.Scale + (b.X.Scale - a.X.Scale) * t,
		a.X.Offset + (b.X.Offset - a.X.Offset) * t,
		a.Y.Scale + (b.Y.Scale - a.Y.Scale) * t,
		a.Y.Offset + (b.Y.Offset - a.Y.Offset) * t
	)
end

-- DRAGGING WITH A SMOOTH DELAY.
-- your finger sets a target, and the panel glides towards it every frame
-- instead of snapping, so the movement feels soft and expensive.
local function makeDraggable(frame, handle, onSettled)
	local dragging, dragStart, startPos
	local target = frame.Position
	local loop = nil
	local conns = {}
	handle = handle or frame

	local function stopLoop()
		if loop then
			loop:Disconnect()
			loop = nil
		end
	end

	-- when the panel goes away, so does every listener and the render loop.
	-- before this, a destroyed UI kept a live InputChanged handler running
	-- for the rest of the session - reloading the script stacked up more.
	local function cleanup()
		dragging = false
		stopLoop()
		for i = #conns, 1, -1 do
			pcall(function() conns[i]:Disconnect() end)
			conns[i] = nil
		end
	end

	local function startLoop()
		if loop then return end
		loop = RunService.RenderStepped:Connect(function(dt)
			if not frame.Parent then
				cleanup()
				return
			end

			-- read the position ONCE per frame instead of five times
			local pos = frame.Position
			local smooth = math.max(DRAG_SMOOTH, 0.0001)
			local alpha = 1 - math.exp(-dt / smooth)
			local nextPos = lerpUDim2(pos, target, alpha)

			-- once it has caught up and the finger is gone, stop the loop so
			-- nothing keeps writing an identical position every frame.
			-- Scale is compared too: comparing only Offset meant a target that
			-- differed purely in Scale (like the centered 0.5, 0.5) counted as
			-- "settled" and snapped instead of easing.
			if not dragging then
				local dx = math.abs(nextPos.X.Offset - target.X.Offset)
				local dy = math.abs(nextPos.Y.Offset - target.Y.Offset)
				local sx = math.abs(nextPos.X.Scale - target.X.Scale)
				local sy = math.abs(nextPos.Y.Scale - target.Y.Scale)
				if dx < 0.5 and dy < 0.5 and sx < 0.001 and sy < 0.001 then
					frame.Position = target
					stopLoop()
					if onSettled then onSettled(target) end
					return
				end
			end

			frame.Position = nextPos
		end)
	end

	conns[#conns + 1] = handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			target = startPos

			-- a drag fights the open / close pop, so stop that pop cleanly
			cancelTween(frame, "slide")
			startLoop()

			-- THE LEAK: this used to be a plain :Connect, so every single
			-- drag added another permanent handler. it is disconnected the
			-- moment the drag ends now. (:Once cannot be used here because a
			-- touch input also fires Changed while the finger moves.)
			local changedConn
			changedConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if changedConn then
						changedConn:Disconnect()
						changedConn = nil
					end
				end
			end)
		end
	end)

	conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input)
		-- this fires for EVERY mouse move in the whole game, so it has to
		-- bail out as early and as cheaply as possible when idle
		if not dragging then return end
		local t = input.UserInputType
		if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then
			return
		end
		local delta = input.Position - dragStart
		target = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
		startLoop()
	end)

	conns[#conns + 1] = frame.AncestryChanged:Connect(function(_, parent)
		if not parent then cleanup() end
	end)

	-- Exposed so the window can move itself authoritatively. setPosition
	-- updates the smoothing target TOO and kills the loop, so the panel
	-- lands exactly where it is put instead of sliding in from its old
	-- position on the next frame.
	local control = {}

	function control.setPosition(pos)
		if not pos then return end
		target = pos
		dragging = false
		stopLoop()
		if frame.Parent then frame.Position = pos end
	end

	function control.getPosition()
		return target
	end

	control.cleanup = cleanup

	return control
end

--=====================================================
--  LIBRARY
--=====================================================
local Library = {}
Library.__index = Library

function Library.new()
	local self = setmetatable({}, Library)

	-- stays false for the whole build, so no layout pass is allowed to
	-- write a scale onto the panel while it is still being assembled
	self._introDone = false

	-- RUN IT TWICE AND YOU STILL GET ONE UI:
	-- any old NexoHub screen is deleted before the new one is built
	local function wipeOld(holder)
		if not holder then return end
		for _, old in ipairs(holder:GetChildren()) do
			if old:IsA("ScreenGui") and old.Name == "NexoHub" then
				old:Destroy()
			end
		end
	end
	pcall(function() wipeOld(Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")) end)
	pcall(function() wipeOld(game:GetService("CoreGui")) end)
	pcall(function() if gethui then wipeOld(gethui()) end end)

	self.IconSlots   = {}
	self.TextCols    = {}
	self.SocialBoxes = {}
	self.Tabs        = {} -- every tab you add lands here
	self.PageFrames  = {}
	self.NavButtons  = {}

	self.Gui = new("ScreenGui", {
		Name = "NexoHub",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		Parent = (Players.LocalPlayer and Players.LocalPlayer:WaitForChild("PlayerGui")),
	})

	-- The reference window is a CanvasGroup. That is the ONLY way the whole
	-- panel can fade as one piece. If an executor cannot make one we quietly
	-- fall back to a normal Frame and just skip the fade.
	local MAIN_CLASS = "Frame"
	if FADE_ENABLED then
		local okCg, probe = pcall(Instance.new, "CanvasGroup")
		if okCg and probe then
			MAIN_CLASS = "CanvasGroup"
			pcall(function() probe:Destroy() end)
		end
	end
	self.CanFade = (MAIN_CLASS == "CanvasGroup")

	self.Main = new(MAIN_CLASS, {
		Name = "Main",
		-- Built INVISIBLE. The intro grow at the end of new() is what puts it
		-- on screen, exactly once.
		Visible = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UI_CLONE and CLONE_SIZE or UDim2.fromOffset(LAYOUT.PanelWidth, 575),
		BackgroundColor3 = THEME.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Active = true,
		ZIndex = 999, -- same stacking order as the reference window
		Parent = self.Gui,
	}, {
		-- clone shell: 0.075 scale corner and NO UIStroke, so the panel has
		-- no outline around it at all.
		new("UICorner", { CornerRadius = UI_CLONE and CLONE_CORNER or UDim.new(0, 26) }),
		new("UIScale", { Name = "Scale" }),
	})

	if UI_CLONE then
		new("UIAspectRatioConstraint", {
			AspectRatio = CLONE_ASPECT,
			DominantAxis = Enum.DominantAxis.Width,
			Parent = self.Main,
		})
	end

	self.Background = new("ImageLabel", {
		Name = "Background",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image = img(IMAGES.Background),
		ImageTransparency = BACKGROUND_TRANSPARENCY,
		ScaleType = Enum.ScaleType.Crop,
		Parent = self.Main,
	}, { new("UICorner", { CornerRadius = UI_CLONE and CLONE_CORNER or UDim.new(0, 26) }) })

	-- EXACT REFERENCE WINDOW SHADING.
	-- The reference hub has a `GRADIENT` frame filling the whole window: a
	-- WHITE slab carrying the ramp
	--   {0, 157,2,31} -> {0.47, 47,29,32} -> {1, 24,24,24}
	-- rotated -90 degrees with a flat 0.9 transparency, sitting at ZIndex 0
	-- BEHIND everything, with the tiled pattern drawn on top of it.
	-- This is the red into dark grand shading of the whole UI.
	-- Built inline because hohoStops is declared further down the file.
	self.WindowGradient = new("Frame", {
		Name = "GRADIENT",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ZIndex = 0,
		Parent = self.Main,
	}, {
		new("UICorner", { CornerRadius = UI_CLONE and CLONE_CORNER or UDim.new(0, 26) }),
		new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(157, 2, 31)),
				ColorSequenceKeypoint.new(0.47, Color3.fromRGB(47, 29, 32)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(24, 24, 24)),
			}),
			Rotation = -90,
			Transparency = NumberSequence.new(0.9),
		}),
	})

	self.Body = new("Frame", {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = self.Main,
	}, {
		padding(LAYOUT.PanelPadding, LAYOUT.PanelPaddingX, LAYOUT.PanelPadding, LAYOUT.PanelPaddingX),
	})

	-- everything below the header lives in here, one frame per page
	self.Content = new("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(0, LAYOUT.HeaderOffsetY + LAYOUT.HeaderHeight + LAYOUT.GAP),
		Size = UDim2.new(1, 0, 1, -(LAYOUT.HeaderOffsetY + LAYOUT.HeaderHeight + LAYOUT.GAP)),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = self.Body,
	})

	self:_buildHeader()
	self:_buildHomePage()
	self:_buildTabsPage()
	self:_buildCreditsPage()
	self:_applyLayout()
	self:SelectPage(TEXT.Nav[TEXT.ActiveNav] or "Home")
	-- the settle callback records the new resting spot the moment a drag
	-- finishes, so hide + show always reopens where the panel was left
	self.MainDrag = makeDraggable(self.Main, nil, function(pos)
		self.PanelPos = pos
	end)

	local camera = workspace.CurrentCamera
	if camera then
		-- debounced, and stored so Destroy can release it. Dragging a window
		-- edge fires this every frame; it used to re-fit every single time.
		self.ViewportConn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if self._fitQueuedScreen then return end
			self._fitQueuedScreen = true
			task.defer(function()
				self._fitQueuedScreen = false
				if self.Destroyed or not self.Main then return end
				self:_fitToScreen()
				self:_refitBoxesSoon()
			end)
		end)
	end

	if SHOW_TUNER then
		self:_buildTuner()
	end

	if SHOW_STROKE_TUNER then
		self:_buildStrokeTuner()
	end

	if SHOW_COLOR_TUNER then
		self:_buildColorTuner()
	end

	if SHOW_BOX_TUNER then
		self:_buildBoxTuner()
	end

	-- the round HIDE / OPEN icon on the left of the screen
	self:_buildMiniIcon()

	-- FIRST OPEN
	-- The panel used to be assembled while it was visible. Building the
	-- header, the home page, the tabs and the credits page each triggers a
	-- layout pass, and every pass writes a new scale into the same UIScale.
	-- You saw every one of them: that is the small / big / small / big
	-- blinking 4-5 times on execute. Now nothing is drawn until the layout
	-- has settled, then ONE clean grow plays.
	self.Shown = false
	self.Main.Visible = false

	task.spawn(function()
		-- let the deferred layout passes finish first
		for _ = 1, 2 do task.wait() end
		if self.Destroyed or not self.Main then return end
		pcall(function() self:_fitToScreen() end)
		pcall(function() self:_refreshControlBoxes() end)
		task.wait()
		if self.Destroyed or not self.Main then return end
		self._introDone = true
		self:SetVisible(true)
	end)

	return self
end

--=====================================================
--  ROUND HIDE / OPEN ICON
--  it lives on the ScreenGui, NOT inside the panel, so it stays
--  on screen while the panel is hidden.
--  position, size and image all come from LAYOUT / IMAGES.
--=====================================================
function Library:_buildMiniIcon()
	local size = LAYOUT.MiniSize

	local shell = new("Frame", {
		Name = "MiniIcon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(LAYOUT.MiniPosX, LAYOUT.MiniPosY),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 50,
		Parent = self.Gui,
	}, {
		new("UICorner", { CornerRadius = UDim.new(1, 0) }), -- perfect circle
		new("UIStroke", {
			Color = THEME.Accent,
			Thickness = LAYOUT.MiniStroke,
			Transparency = 0,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
	})

	-- RULE: the image is never tinted, and it fills the whole circle
	local icon = new("ImageLabel", {
		Name = "Icon",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image = img(IMAGES.MiniIcon),
		ScaleType = Enum.ScaleType.Crop,
		ZIndex = 51,
		Parent = shell,
	}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })

	-- if no image id is set yet you still see a clear round button
	local fallback = new("TextLabel", {
		Name = "Fallback",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "H",
		TextSize = math.floor(size * 0.45),
		TextColor3 = THEME.Accent,
		Visible = (icon.Image == ""),
		ZIndex = 52,
		Parent = shell,
	})

	local hit = new("TextButton", {
		Name = "Hit",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 55,
		Parent = shell,
	})

	-- SPAM AWAY. Every single click flips the panel, even while a grow or
	-- shrink is still running: the running tween is cancelled and a new one
	-- picks up from the current size. No debounce, no swallowed clicks.
	hit.MouseButton1Click:Connect(function()
		self:Toggle()
	end)

	-- LASER / SHINE on the round outline: a bright band keeps sweeping
	-- around the ring so the little button never looks flat
	local ring = shell:FindFirstChildOfClass("UIStroke")
	if ring then
		local shine = new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0.00, THEME.AccentDark),
				ColorSequenceKeypoint.new(0.35, THEME.Accent),
				ColorSequenceKeypoint.new(0.50, THEME.LaserShine),
				ColorSequenceKeypoint.new(0.65, THEME.Accent),
				ColorSequenceKeypoint.new(1.00, THEME.AccentDark),
			}),
			Rotation = 0,
			Parent = ring,
		})

		-- ONE repeating tween instead of a coroutine that woke up every
		-- 2.4s forever to build a brand new tween and snap Rotation back to
		-- 0. Identical look, zero per-cycle allocation, and it can now be
		-- paused while the panel is hidden.
		shine.Rotation = 0
		local spin = TweenService:Create(
			shine,
			tweenInfo(2.4, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
			{ Rotation = 360 }
		)
		spin:Play()
		self:_trackLoopTween(spin)
	end

	-- you can drag the icon anywhere you like
	makeDraggable(shell, hit)

	self.MiniIcon = shell
	self.MiniImage = icon
	self.MiniFallback = fallback
	return shell
end

--=====================================================
--  ENDLESS DECORATION ANIMATIONS (ring shines, laser rings)
--  These spin forever. There is no reason for them to burn frame time
--  while the panel is hidden, so they are registered here and paused
--  with the panel.
--=====================================================
function Library:_trackLoopTween(tween)
	if not tween then return tween end
	self._loopTweens = self._loopTweens or {}
	self._loopTweens[#self._loopTweens + 1] = tween
	return tween
end

function Library:_setLoopTweens(playing)
	for _, tween in ipairs(self._loopTweens or {}) do
		pcall(function()
			if playing then
				if tween.PlaybackState ~= Enum.PlaybackState.Playing then tween:Play() end
			else
				tween:Pause()
			end
		end)
	end
end

-- after the open animation finishes the control boxes only need their
-- HEIGHT re-measured. That is cheap. The full _refreshControlBoxes pass
-- (which also rebuilds the panel layout and resizes every control row)
-- used to run on every single open, and that was the freeze.
function Library:_refitBoxesSoon()
	if self._fitQueued then return end
	self._fitQueued = true
	task.defer(function()
		self._fitQueued = false
		if self.Destroyed or self.Animating then return end
		for _, entry in ipairs(self.ControlBoxes or {}) do
			self:_fitControlBox(entry.Box)
		end
	end)
end

-- hide / show the whole panel WITH the pop animation.
-- pass true as the second argument if you ever want it to snap instantly.
-- FAST_OPEN: while the panel is growing or shrinking, the inner content is
-- hidden. Animating a UIScale forces Roblox to re-lay out EVERY descendant on
-- every single frame - with a full set of tabs and controls that is hundreds
-- of elements 60 times a second, and it is the main reason opening felt heavy.
-- The outer panel, background and outline still scale, so it still reads as a
-- normal grow. Set this to false to go back to scaling the content too.
--
-- NOW OFF ON PURPOSE. With FAST_OPEN = true the inner Body (tabs, buttons,
-- sections, every control) was snapped invisible the instant you pressed the
-- toggle key, and only the empty outer panel animated. That is why it looked
-- like the UI closed in two parts: buttons vanish first, frame shrinks after.
-- With it false the WHOLE window - frame, tabs, buttons, everything - grows
-- and shrinks together as one single piece.
local FAST_OPEN = false

-- Pins the panel in place for the duration of the open / close animation.
-- Cheap: one comparison per frame, and only while animating.
function Library:_lockPanelPos()
	self:_unlockPanelPos()
	local pos = self.PanelPos
	if not pos then return end
	self._posLock = RunService.RenderStepped:Connect(function()
		local main = self.Main
		if not main or not main.Parent then return end
		if main.Position ~= pos then
			main.Position = pos
		end
	end)
end

function Library:_unlockPanelPos()
	if self._posLock then
		pcall(function() self._posLock:Disconnect() end)
		self._posLock = nil
	end
end

-- Remembers where the panel actually sits, so hiding and re-opening puts it
-- back exactly where you dragged it.
function Library:_rememberPanelPos()
	if not self.Main then return end
	if not self.Main.Visible then return end
	self.PanelPos = self.Main.Position
end

-- Applied BEFORE the panel is made visible, so it never renders a single
-- frame at the wrong place. Also re-points the drag smoothing target, or the
-- loop would animate the panel from the middle over to the corner.
function Library:_restorePanelPos()
	if not self.Main then return end
	local pos = self.PanelPos
	if not pos then return end
	self.Main.Position = pos
	if self.MainDrag then self.MainDrag.setPosition(pos) end
end

-- Writes the whole window fade in one shot. Silently does nothing when the
-- panel is a plain Frame instead of a CanvasGroup.
function Library:_setGroupFade(value)
	if not (FADE_ENABLED and self.CanFade and self.Main) then return end
	pcall(function() self.Main.GroupTransparency = value end)
end

function Library:SetVisible(state, instant)
	if not self.Main then return end
	state = state and true or false

	local scaleObj = self.Main:FindFirstChild("Scale")
	local base = self.BaseScale or (scaleObj and scaleObj.Scale) or 1

	-- ALREADY IN THAT STATE: hammering the toggle key used to fire a fresh
	-- grow / shrink on every press. Those stacked on top of each other and
	-- that is exactly what made the panel look stuck or flicker.
	if state == self.Shown and not self.Animating then
		self:_unlockPanelPos()
		if state then self:_restorePanelPos() end
		if self.Body then self.Body.Visible = true end
		self.Main.Visible = state
		if scaleObj then scaleObj.Scale = base end
		self:_setGroupFade(state and 0 or FADE_HIDDEN)
		return
	end

	-- capture the resting spot while the panel is still on screen
	if not state then self:_rememberPanelPos() end

	self.Shown = state

	if (not scaleObj) or instant then
		self:_unlockPanelPos()
		if state then self:_restorePanelPos() end
		if self.Body then self.Body.Visible = true end
		self.Main.Visible = state
		if scaleObj then scaleObj.Scale = base end
		self:_setGroupFade(state and 0 or FADE_HIDDEN)
		self.Animating = false
		self:_setLoopTweens(state)
		return
	end

	-- EVERY animation gets its own ticket number. cancelling a tween still
	-- fires its Completed event, and the old finisher used to slam the scale
	-- back to full size - that is why the open animation looked like it did
	-- nothing at all. now an old ticket simply gets ignored.
	self.AnimToken = (self.AnimToken or 0) + 1
	local token = self.AnimToken

	if self.OpenTween then
		pcall(function() self.OpenTween:Cancel() end)
		self.OpenTween = nil
	end

	-- the fade runs beside the scale, so it has to be cancelled beside it too
	if self.FadeTween then
		pcall(function() self.FadeTween:Cancel() end)
		self.FadeTween = nil
	end

	self.Animating = true

	-- the endless ring shines are resumed the instant we start opening and
	-- paused once the panel is fully gone
	if state then self:_setLoopTweens(true) end

	local tween
	if state then
		-- OPEN: from the size of a dot, grow out to full size.
		-- The scale is written BEFORE the frame is shown, so the panel is
		-- never rendered at full size for one frame first (that single frame
		-- was the "pop" / flash you saw at the start of the open).
		-- restore the dragged position and the start scale BEFORE showing,
		-- so the panel never appears in the middle for a frame and then
		-- travels to the corner
		self:_restorePanelPos()
		self:_lockPanelPos()
		if self.Body then self.Body.Visible = true end
		-- SPAM PROOF: if the panel is still on screen because a shrink never
		-- finished, grow out from wherever it is RIGHT NOW instead of
		-- snapping back down to the dot first. Snapping was the jump that
		-- made a mid animation click look like it did nothing.
		if not self.Main.Visible then
			scaleObj.Scale = base * OPEN_START
			-- start fully transparent ONLY on a real open. Mid animation spam
			-- keeps whatever fade it is already at and finishes from there.
			self:_setGroupFade(FADE_HIDDEN)
		end
		self.Main.Visible = true
		tween = TweenService:Create(scaleObj, OPEN_TWEEN, { Scale = base })
		if FADE_ENABLED and self.CanFade then
			self.FadeTween = TweenService:Create(self.Main, OPEN_TWEEN, { GroupTransparency = 0 })
			self.FadeTween:Play()
		end
	else
		-- HIDE: shrink down to a dot, then vanish
		self:_lockPanelPos()
		if self.Body then self.Body.Visible = true end
		tween = TweenService:Create(scaleObj, HIDE_TWEEN, { Scale = base * HIDE_END })
		if FADE_ENABLED and self.CanFade then
			self.FadeTween = TweenService:Create(self.Main, HIDE_TWEEN, { GroupTransparency = FADE_HIDDEN })
			self.FadeTween:Play()
		end
	end

	self.OpenTween = tween

	-- :Once, not :Connect. A brand new Completed handler was created on
	-- every open AND every close and none of them were ever released, so
	-- the handler list grew for the whole session - the UI got heavier the
	-- more you used it.
	tween.Completed:Once(function(playbackState)
		-- released even for a superseded ticket, otherwise a cancelled
		-- animation would leave the panel pinned or the content hidden
		self:_unlockPanelPos()
		if self.Body then self.Body.Visible = true end

		if token ~= self.AnimToken then return end
		self.OpenTween = nil
		self.Animating = false

		-- a cancelled tween must not write any final value
		if playbackState ~= Enum.PlaybackState.Completed then return end

		scaleObj.Scale = self.BaseScale or base

		if not state then
			self.Main.Visible = false
			self:_setLoopTweens(false)
			return
		end

		-- measuring was frozen during the animation. Catch up on the NEXT
		-- frame with the cheap height-only pass instead of a full relayout.
		self:_refitBoxesSoon()
	end)

	tween:Play()
end

function Library:Show() self:SetVisible(true) end
function Library:Hide() self:SetVisible(false) end

function Library:Toggle()
	if not self.Main then return end
	-- self.Shown is flipped the moment an animation STARTS, not when it
	-- ends, so spamming this always reverses the motion you can see on
	-- screen rather than fighting a state that is half a second stale.
	if self.Shown == nil then self.Shown = self.Main.Visible end
	self:SetVisible(not self.Shown)
end

-- change the round icon image at any time:  ui:SetMiniIcon("123456789")
function Library:SetMiniIcon(id)
	IMAGES.MiniIcon = id
	if self.MiniImage then
		IMG.set(self.MiniImage, "Image", id, function()
			if self.MiniFallback then
				self.MiniFallback.Visible = (self.MiniImage.Image == "")
			end
		end)
		if self.MiniFallback then
			self.MiniFallback.Visible = (self.MiniImage.Image == "")
		end
	end
end

--=====================================================
--  NOTIFICATIONS
--  ui:Notify({ text = "Saved", image = "87628150067132", time = 4 })
--  with an image  ->  image | text
--  without one    ->  text only, using the whole width
--=====================================================
function Library:_notifyHolder()
	if self.NotifyHolder and self.NotifyHolder.Parent then
		return self.NotifyHolder
	end

	local holder = new("Frame", {
		Name = "Notifications",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.new(0, LAYOUT.NotifyWidth, 0.9, 0),
		BackgroundTransparency = 1,
		ZIndex = 80,
		Parent = self.Gui,
	}, {
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, LAYOUT.NotifyGap),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	self.NotifyHolder = holder
	return holder
end

function Library:Notify(info)
	if type(info) == "string" then info = { text = info } end
	info = info or {}

	local holder = self:_notifyHolder()
	local life = info.time or info.duration or LAYOUT.NotifyTime
	local pad = LAYOUT.NotifyPad

	-- NOTIFICATION IMAGE
	--   ui:Notify({ text = "hi", image = "1234567890" })  -> your own image id
	--   ui:Notify({ text = "hi" })                        -> falls back to the LOGO
	--   ui:Notify({ text = "hi", image = false })         -> text only, no image
	local image = pickIcon(info, nil)
	if image == nil then
		image = IMAGES.NotifyIcon
		if image == nil or image == "" then image = IMAGES.Logo end
	end
	if image == false or image == "" then image = nil end

	local card = new("Frame", {
		Name = "Notification",
		Size = UDim2.new(1, 0, 0, LAYOUT.NotifyHeight),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 81,
		Parent = holder,
	}, { corner(12) })

	local line = new("UIStroke", {
		Color = THEME.Accent,
		Thickness = LAYOUT.NotifyStroke,
		Transparency = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = card,
	})

	local icon
	local textLeft = pad

	if image then
		-- RULE 1: the image and the text never touch, there is always a gap
		-- ZOOMED OUT: Fit keeps the whole logo visible instead of cropping into
		-- it, and NotifyIconZoom shrinks it a bit inside its box.
		local zoom = LAYOUT.NotifyIconZoom or 0.72
		local iconSize = math.floor(LAYOUT.NotifyIcon * zoom)
		icon = new("ImageLabel", {
			Name = "Icon",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, pad + math.floor((LAYOUT.NotifyIcon - iconSize) / 2), 0.5, 0),
			Size = UDim2.fromOffset(iconSize, iconSize),
			BackgroundTransparency = 1,
			Image = img(image),
			ImageTransparency = 1,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 82,
			Parent = card,
		}, { corner(10) })

		textLeft = pad + LAYOUT.NotifyIcon + pad
	end

	-- RULE 3: the text stays inside the card and wraps instead of spilling
	local label = new("TextLabel", {
		Name = "Text",
		Position = UDim2.fromOffset(textLeft, pad),
		Size = UDim2.new(1, -(textLeft + pad), 1, -(pad * 2)),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		RichText = true,
		Text = info.text or "",
		TextSize = LAYOUT.NotifyText,
		TextColor3 = THEME.Text,
		TextTransparency = 1,
		TextWrapped = true,
		TextXAlignment = image and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 82,
		Parent = card,
	})

	-- fade in
	local fadeIn = tweenInfo(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out) -- cached
	TweenService:Create(card, fadeIn, { BackgroundTransparency = LAYOUT.NotifyFade }):Play()
	TweenService:Create(line, fadeIn, { Transparency = 0 }):Play()
	TweenService:Create(label, fadeIn, { TextTransparency = 0 }):Play()
	if icon then
		TweenService:Create(icon, fadeIn, { ImageTransparency = 0 }):Play()
	end

	-- fade out and clean itself up
	task.delay(life, function()
		if not card.Parent then return end
		local out = tweenInfo(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In) -- cached
		TweenService:Create(card, out, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(line, out, { Transparency = 1 }):Play()
		TweenService:Create(label, out, { TextTransparency = 1 }):Play()
		if icon then
			TweenService:Create(icon, out, { ImageTransparency = 1 }):Play()
		end
		task.wait(0.35)
		if card then card:Destroy() end
	end)

	return card
end

--=====================================================
--  INFO POPUP
--  black window, red outline, close button.
--  **words between two stars** come out BIG, so you can
--  mark the important parts of a how to use text.
--=====================================================
local function toRichText(raw)
	raw = tostring(raw or "")

	-- rich text needs these escaped first, otherwise it breaks
	raw = raw:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")

	-- **big words**  ->  bold and bigger
	raw = raw:gsub("%*%*(.-)%*%*", function(inner)
		return string.format(
			'<b><font size="%d" color="#%s">%s</font></b>',
			LAYOUT.InfoBigText,
			string.format("%02X%02X%02X",
				math.floor(THEME.Accent.R * 255),
				math.floor(THEME.Accent.G * 255),
				math.floor(THEME.Accent.B * 255)),
			inner
		)
	end)

	return raw
end

