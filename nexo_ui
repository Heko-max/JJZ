-- TAB ROW SLIMMING: squeezes a tab row from its OUTER edges with a scale
-- based UIPadding, so both tabs get slimmer together while the gap
-- between them stays exactly TabGap. Defined here because it needs `new`.
local function rowSidePadding()
	-- own knob: widening the tabs inside the box leaves the box and the
	-- search bar exactly where they are
	local sc = math.clamp(LAYOUT.TabRowWidthScale or LAYOUT.TabWidthScale or 1, 0.4, 1)
	local inset = (1 - sc) / 2
	return new("UIPadding", {
		PaddingLeft  = UDim.new(inset, 0),
		PaddingRight = UDim.new(inset, 0),
	})
end

--=====================================================
--  SLIDE ANIMATION
--  going INSIDE  -> the new view slides in from the RIGHT  ->
--  going BACK    -> the new view slides in from the LEFT   <-
--=====================================================
local SLIDE_TIME = 0.22 -- seconds. bigger = slower slide
local SLIDE_PUSH = 0.30 -- how far it starts off screen. bigger = longer travel

--=====================================================
--  OPEN / HIDE ANIMATION (the round mini icon)
--  open  = small  ->  big
--  hide  = shrink ->  vanish
--=====================================================
--  >>> THE 4 NUMBERS THAT CONTROL THE OPEN / HIDE FEEL <<<
local OPEN_TIME  = 0.38 -- how LONG the grow / shrink takes (seconds)
local OPEN_DELAY = 0.00 -- pause before the motion starts. 0 = reacts the instant you click
local OPEN_START = 0.88 -- HOHO FEEL. the window fades in while swelling from 88% to full.
local HIDE_END   = 0.88 -- set BOTH of these back to 0.02 if you want the old dot again
-- HOHO REFERENCE FADE: its window is one CanvasGroup, so opening / closing
-- fades the ENTIRE panel as a single flat picture instead of every tab,
-- card and image fading on its own. 1 = fully invisible, 0 = fully solid.
local FADE_ENABLED = true -- false = no fade, scale only (the old behaviour)
local FADE_HIDDEN  = 1    -- how see through the panel is at the start / end
-- OPEN_START / HIDE_END used to be 0.02 (a dot). The whole window scales as
-- one piece now, so a gentler distance keeps the motion smooth instead of
-- squeezing every tab and button through a pinhole.

-- SMOOTH FEEL
local DRAG_SMOOTH   = 0.09 -- how much the panel lags behind your finger while dragging
                           -- 0 = glued to the cursor, bigger = softer / floatier
local TOGGLE_SMOOTH = 0.22 -- how slow and soft a switch turns on / off

--=====================================================
--  TWEEN CACHE  +  CONFLICT FREE PLAYBACK
--  Every hover, click, slide and switch used to build a BRAND NEW
--  TweenInfo object each time it played. TweenInfo is immutable, so
--  they are built once here and reused forever.
--  playTween() also remembers what is already running on an object and
--  cancels it before starting the next one, so two animations can never
--  fight over the same property (that is what made things look stuck,
--  jittery or half finished).
--=====================================================
local TWEEN_INFO_CACHE = {}

local function tweenInfo(time, style, dir, reps, delay)
	style = style or Enum.EasingStyle.Quad
	dir   = dir or Enum.EasingDirection.Out
	reps  = reps or 0
	delay = delay or 0
	local key = string.format("%.4f|%d|%d|%d|%.4f", time, style.Value, dir.Value, reps, delay)
	local cached = TWEEN_INFO_CACHE[key]
	if not cached then
		cached = TweenInfo.new(time, style, dir, reps, false, delay)
		TWEEN_INFO_CACHE[key] = cached
	end
	return cached
end

-- one live tween per object per "channel". a weak keyed table means a
-- destroyed element does not keep its old tweens alive.
local ACTIVE_TWEENS = setmetatable({}, { __mode = "k" })

local function playTween(inst, info, goal, channel)
	if not inst or not inst.Parent then return nil end
	channel = channel or "default"

	local slots = ACTIVE_TWEENS[inst]
	if not slots then
		slots = {}
		ACTIVE_TWEENS[inst] = slots
	end

	local running = slots[channel]
	if running then
		-- cancel first, so the old tween can never write a stale value on
		-- top of the new one halfway through
		pcall(function() running:Cancel() end)
		slots[channel] = nil
	end

	local ok, tween = pcall(TweenService.Create, TweenService, inst, info, goal)
	if not ok or not tween then return nil end

	slots[channel] = tween
	tween.Completed:Once(function()
		if slots[channel] == tween then slots[channel] = nil end
	end)
	tween:Play()
	return tween
end

-- stop whatever is animating on an object without starting anything new
local function cancelTween(inst, channel)
	local slots = inst and ACTIVE_TWEENS[inst]
	if not slots then return end
	if channel then
		local running = slots[channel]
		if running then
			pcall(function() running:Cancel() end)
			slots[channel] = nil
		end
	else
		for k, running in pairs(slots) do
			pcall(function() running:Cancel() end)
			slots[k] = nil
		end
	end
end

-- pre-built infos for the animations that run the most often
local SLIDE_TWEEN  = tweenInfo(SLIDE_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
-- Growing out of a 2% dot is a huge distance to cover, so the curve is
-- what sells it. Quint Out leaves the dot fast and glides into full size,
-- Quint In does the mirror on the way down. Fast to react, soft to land.
-- Quart in / out is the easing the reference window uses.
local OPEN_TWEEN   = tweenInfo(OPEN_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0, OPEN_DELAY)
local HIDE_TWEEN   = tweenInfo(OPEN_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.In, 0, OPEN_DELAY)
local HOVER_FADE   = tweenInfo(HOVER_SPEED, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local CLICK_TWEEN  = tweenInfo(CLICK_SPEED, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local TOGGLE_TWEEN = tweenInfo(TOGGLE_SMOOTH, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function slideIn(frame, forward)
	if not frame then return end

	-- remember where the frame is supposed to rest
	local home = frame:GetAttribute("SlideHome")
	if typeof(home) ~= "UDim2" then
		home = frame.Position
		frame:SetAttribute("SlideHome", home)
	end

	frame.Position = home
	frame.Visible = true

	if SLIDE_TIME <= 0 then return end

	local dir = (forward == false) and -1 or 1
	frame.Position = home + UDim2.fromScale(SLIDE_PUSH * dir, 0)
	-- playTween cancels a slide that is still running on this frame, so
	-- switching levels quickly no longer leaves a view stuck off screen
	playTween(frame, SLIDE_TWEEN, { Position = home }, "slide")
end

