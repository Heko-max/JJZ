-- FontFace needs a modern client. If Font.new is missing we quietly drop back
-- to the closest Enum.Font so nothing errors on an older executor.
local function hohoFont(inst, weight)
	weight = weight or "Regular"
	local ok = pcall(function()
		inst.FontFace = Font.new(HOHO_SANS, Enum.FontWeight[weight])
	end)
	if not ok then
		pcall(function() inst.Font = HOHO_FALLBACK[weight] or Enum.Font.SourceSans end)
	end
end

-- multi stop gradient
local function hohoStops(parent, cols, rot, transparency)
	local ks = {}
	for _, c in ipairs(cols) do
		ks[#ks + 1] = ColorSequenceKeypoint.new(c[1], Color3.fromRGB(c[2], c[3], c[4]))
	end
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(ks)
	g.Rotation = rot or 0
	if transparency then
		g.Transparency = NumberSequence.new(transparency)
	end
	g.Parent = parent
	return g
end

local function hohoStroke(parent, thickness, cols, rot)
	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(255, 255, 255)
	s.Thickness = thickness
	s.Transparency = 0
	s.Parent = parent
	if cols then hohoStops(s, cols, rot) end
	return s
end

--=====================================================
--  CONTROL SKIN
--  The buttons / switches / sliders / dropdowns inside a section now use
--  the EXACT same colors, shading and blending as the pages tab cards:
--    fill    : Color3.fromRGB(20, 20, 20) at 0.5
--    outline : G_PANEL_STRK gradient, white base, rotated -57
--  hohoBorder returns the instance, so it drops straight into a children
--  table right where the old flat accent stroke used to be.
--=====================================================
local function hohoSeq(cols)
	local ks = {}
	for _, c in ipairs(cols) do
		ks[#ks + 1] = ColorSequenceKeypoint.new(c[1], Color3.fromRGB(c[2], c[3], c[4]))
	end
	return ColorSequence.new(ks)
end

local function hohoBorder(thickness, cols, rot)
	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(255, 255, 255)
	s.Thickness = thickness or 2
	s.Transparency = 0
	local g = Instance.new("UIGradient")
	g.Color = hohoSeq(cols or G_PANEL_STRK)
	g.Rotation = rot or -57
	g.Parent = s
	return s
end

