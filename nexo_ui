		TextSize = 16,
		TextColor3 = THEME.ControlText,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 3,
		Parent = shell,
	})
	controlPart(readout, "TextColor3")

	local track = new("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 8),
