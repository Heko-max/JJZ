	})
	hohoStops(glow, G_HOME, 45)
	hohoStroke(glow, 2.5, G_HOME_STRK, 45)

	-- the logo, right hand side, tinted by the red gradient
	local slot = new("Frame", {
		Name = "IconSlot",
		Position = UDim2.fromScale(0.635, 0.148),
		Size = UDim2.fromScale(0.3158, 0.6961),
