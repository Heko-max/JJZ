function Library:_buildStatusWindow()
	local CFG = Library.StatusCfg
	if not CFG.Enabled then return nil end
	if self.Status and self.Status.Root and self.Status.Root.Parent then return self.Status end

	local CLASS = "Frame"
	local okCg, probe = pcall(Instance.new, "CanvasGroup")
